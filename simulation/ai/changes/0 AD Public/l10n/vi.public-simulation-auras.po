msgstr "Lính Lê dương Marian và Bách trưởng +10% tốc độ di chuyển."

#: simulation/data/auras/units/germ_seer_1.json
msgid "Prophecy of Death"
msgstr "Lời tiên tri tử thần"

#: simulation/data/auras/units/germ_seer_1.json
