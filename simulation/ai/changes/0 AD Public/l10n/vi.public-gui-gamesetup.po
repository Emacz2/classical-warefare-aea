#: gui/text/quotes.txt:1
msgid ""
"“Zeus \\[…] established his law: wisdom comes through suffering. \\[…] So "
"men against their will learn to practice moderation. \\[…] Such grace is "
"harsh and violent.” \\n— Aeschylus (“Agamemnon”, 176–183)"
msgstr "“Zeus \\[…] đã lập ra luật của ngài: sự khôn ngoan đến từ đau khổ. \\[…] Vậy nên người ta bất đắc dĩ học cách thực hành sự điều độ. \\[…] Ân huệ như vậy thật khắc nghiệt và bạo lực.” — Aeschylus (“Agamemnon”, 176–183)"

#: gui/text/quotes.txt:2
msgid ""
"“She \\[Helen] brought to Ilium her dowry, destruction.” \\n— Aeschylus "
"(“Agamemnon”, 406)"
msgstr "“Nàng \\[Helen] mang đến Ilium của hồi môn của mình, sự hủy diệt.” — Aeschylus (“Agamemnon”, 406)"

#: gui/text/quotes.txt:3
msgid ""
"“In every tyrant's heart there springs in the end this poison, that he "
"cannot trust a friend.” \\n— Aeschylus (“Prometheus Bound”, 224–225)"
msgstr "“Trong trái tim của mọi bạo chúa, cuối cùng sẽ nảy sinh chất độc này, rằng hắn ta không thể tin tưởng một người bạn.” — Aeschylus (“Prometheus Bị Xiềng Xích”, 224–225)"

#: gui/text/quotes.txt:4
msgid ""
"“Time in the long run teaches all things.” \\n— Aeschylus (“Prometheus "
"Bound”, 981)"
msgstr "“Thời gian về lâu dài dạy dỗ mọi thứ.” — Aeschylus (“Prometheus Bị Xiềng Xích”, 981)"

#: gui/text/quotes.txt:5
msgid ""
"“His resolve is not to seem, but to be, the best.” \\n— Aeschylus (“Seven "
"Against Thebes”, 592)"
msgstr "“Quyết tâm của hắn ta không phải là để có vẻ mà là để là người tốt nhất.” — Aeschylus (“Bảy Chống Lại Thebes”, 592)"

#: gui/text/quotes.txt:6
msgid "“A prosperous fool is a grievous burden.” \\n— Aeschylus (fragment 383)"
msgstr "\"Một kẻ ngốc thịnh vượng là một gánh nặng đau khổ.” — Aeschylus (mảnh 383)"

#: gui/text/quotes.txt:7
msgid ""
"“The gods help those that help themselves.” \\n— Aesop (“Hercules and the "
"Wagoner”)"
msgstr "“Các vị thần giúp đỡ những người tự giúp mình.” — Aesop (“Hercules và Người Đánh Xe”)"

#: gui/text/quotes.txt:8
msgid ""
"“It is thrifty to prepare today for the wants of tomorrow.” \\n— Aesop (“The"
" Ant and the Grasshopper”)"
msgstr "“Thật tiết kiệm khi chuẩn bị hôm nay cho những nhu cầu của ngày mai.” — Aesop (“Con Kiến và Con Châu Chấu”)"

#: gui/text/quotes.txt:9
msgid "“Union gives strength.” \\n— Aesop (“The Bundle of Sticks”)"
msgstr "“Đoàn kết tạo nên sức mạnh.” — Aesop (“Bó Que”)"

#: gui/text/quotes.txt:10
msgid ""
"“Never trust advice from a man in the throes of his own difficulty.” \\n— "
"Aesop (“The Fox and the Goat”)"
msgstr "“Đừng bao giờ tin lời khuyên từ một người đang gặp khó khăn.” — Aesop (“Con Cáo và Con Dê”)"

#: gui/text/quotes.txt:11
msgid ""
"“Familiarity breeds contempt; acquaintance softens prejudices.” \\n— Aesop "
"(“The Fox and the Lion”)"
msgstr "“Sự quen thuộc sinh ra khinh miệt; sự quen biết làm dịu đi những thành kiến.” — Aesop (“Con Cáo và Con Sư Tử”)"

#: gui/text/quotes.txt:12
msgid ""
"“Self-conceit may lead to self-destruction.” \\n— Aesop (“The Frog and the "
"Ox”)"
msgstr "“Sự tự mãn có thể dẫn đến tự hủy diệt.” — Aesop (“Con Ếch và Con Bò”)"

#: gui/text/quotes.txt:13
msgid ""
"“Slow and steady wins the race.” \\n— Aesop (“The Hare and the Tortoise”)"
msgstr "“Chậm mà chắc sẽ thắng cuộc đua.” — Aesop (“Con Thỏ và Con Rùa”)"

#: gui/text/quotes.txt:14
msgid ""
"“Better be wise by the misfortunes of others than by your own.” \\n— Aesop "
"(“The Lion, the Ass, and the Fox Hunting”)"
msgstr "“Thà khôn ngoan từ những bất hạnh của người khác còn hơn là từ chính mình.” — Aesop (“Sư Tử, Lừa và Cáo đi săn”)"

#: gui/text/quotes.txt:15
msgid ""
"“Enemies' promises were made to be broken.” \\n— Aesop (“The Nurse and the "
"Wolf”)"
msgstr "“Lời hứa của kẻ thù được tạo ra để bị phá vỡ.” — Aesop (“Y Tá và Sói”)"

#: gui/text/quotes.txt:16
msgid "“Any excuse will serve a tyrant.” \\n— Aesop (“The Wolf and the Lamb”)"
msgstr "“Bất kỳ lời bào chữa nào cũng có thể phục vụ một bạo chúa.” — Aesop (“Sói và Cừu Con”)"

#: gui/text/quotes.txt:17
msgid ""
"“If I have done anything noble, that is a sufficient memorial; if I have "
"not, all the statues in the world will not preserve my memory.” \\n— "
"Agesilaus II of Sparta (Plutarch, “Moralia”, “Sayings of Spartans”, 215a)"
msgstr "\"Nếu ta đã làm điều gì cao quý, đó là một đài tưởng niệm đủ đầy; nếu không, tất cả các bức tượng trên thế giới cũng sẽ không bảo tồn ký ức của ta.” — Agesilaus II của Sparta (Plutarch, “Moralia”, “Những Câu Nói Của Người Spartan”, 215a)"

#: gui/text/quotes.txt:18
msgid ""
"“Spartans do not ask how many, only where the enemy are.” \\n— Agis II of "
"Sparta (Plutarch, “Moralia”, “Sayings of Spartans”, 215d)"
msgstr "“Người Spartan không hỏi bao nhiêu, chỉ hỏi kẻ thù ở đâu.” — Agis II của Sparta (Plutarch, “Moralia”, “Những Câu Nói Của Người Spartan”, 215d)"

#: gui/text/quotes.txt:19
msgid ""
"“Weep not for me, as I suffer unjustly, I am in a happier situation than my "
"murderers.” \\n— Agis IV of Sparta upon seeing one of his executioners cry "
"(Plutarch, “Parallel Lives”, “Agis”, sec. 20)"
msgstr "“Đừng khóc cho ta, vì ta chịu đựng bất công, ta ở trong một tình cảnh hạnh phúc hơn những kẻ giết ta.” — Agis IV của Sparta khi thấy một trong những kẻ hành quyết mình khóc (Plutarch, “Cuộc Đời Song Song”, “Agis”, sec. 20)"

#: gui/text/quotes.txt:20
msgid ""
"“Sex and sleep alone make me conscious that I am mortal.” \\n— Alexander the"
" Great (Plutarch, “Parallel Lives”, “Alexander”, sec. 22)"
msgstr "“Chỉ có tình dục và giấc ngủ mới khiến ta nhận thức được rằng mình là người phàm.” — Alexander Đại đế (Plutarch, “Cuộc Đời Song Song”, “Alexander”, sec. 22)"

#: gui/text/quotes.txt:21
msgid ""
"“It is very servile to live in luxury, but very royal to toil. \\[…] Don't "
"you know that the end and object of conquest is to avoid the vices and "
"infirmities of the subdued?” \\n— Alexander the Great (Plutarch, “Parallel "
"Lives”, “Alexander”, sec. 40)"
msgstr "“Thật đê tiện khi sống trong xa hoa, nhưng lại rất hoàng gia khi lao nhọc. \\[…] Chẳng lẽ ngươi không biết rằng mục đích cuối cùng của việc chinh phục là để tránh những thói hư tật xấu và điểm yếu của kẻ bị khuất phục?” — Alexander Đại đế (Plutarch, “Cuộc Đời Song Song”, “Alexander”, sec. 40)"

#: gui/text/quotes.txt:22
msgid ""
"“Glorious are the deeds of those who undergo labor and run the risk of "
"danger; and it is delightful to live a life of valor and to die leaving "
"behind immortal glory.” \\n— Alexander the Great, addressing his troops "
"(Arrian, “The Anabasis of Alexander”, 5.26)"
msgstr "“Vinh quang thay những việc làm của những người chịu khó nhọc và liều mình đối mặt với hiểm nguy; và thật sung sướng khi sống một cuộc đời dũng cảm và ra đi để lại danh tiếng bất hủ.” — Alexander Đại đế, phát biểu trước quân đội của mình (Arrian, “Hành Trình của Alexander”, 5.26)"

#: gui/text/quotes.txt:23
msgid ""
"“I for one think that to a brave man there is no end to labors except the "
"labors themselves, provided they lead to glorious achievements.” \\n— "
"Alexander the Great, addressing his troops (Arrian, “The Anabasis of "
"Alexander”, 5.26)"
msgstr "“Riêng ta, ta nghĩ rằng đối với một người dũng cảm, không có hồi kết cho những lao nhọc ngoại trừ chính những lao nhọc đó, miễn là chúng dẫn đến những thành tựu vinh quang.” — Alexander Đại đế, phát biểu trước quân đội của mình (Arrian, “Hành Trình của Alexander”, 5.26)"

#: gui/text/quotes.txt:24
msgid ""
"“If I were not Alexander, I should wish to be Diogenes \\[of Sinope].” \\n— "
"Alexander the Great, impressed by the simplicity of the philosopher he had "
"met (Plutarch, “Moralia”, “On the Fortunes of Alexander the Great”, 332a–b)"
msgstr "“Nếu ta không phải là Alexander, ta sẽ ước được làm Diogenes \\[của Sinope].” \\n— Alexander Đại đế, ấn tượng trước lối sống giản dị của nhà triết học mà ông đã gặp (Plutarch, “Moralia”, “Về Vận Mệnh của Alexander Đại đế”, 332a–b)"

#: gui/text/quotes.txt:25
msgid ""
"“To the strongest!” \\n— Alexander the Great, on his death bed, when asked "
"who should succeed him as king (Arrian, “The Anabasis of Alexander”, 7.26)"
msgstr "\"Cho kẻ mạnh nhất!” — Alexander Đại đế, trên giường bệnh, khi được hỏi ai sẽ kế vị ông làm vua (Arrian, “Hành Trình của Alexander”, 7.26)"

#: gui/text/quotes.txt:26
msgid ""
"“I do not steal victory.” \\n— Alexander the Great, when suggested to raid "
"the Persians at night (Plutarch, “Parallel Lives”, “Alexander”, sec. 31)"
msgstr "“Ta không ăn trộm chiến thắng.” — Alexander Đại đế, khi được đề nghị đột kích người Ba Tư vào ban đêm (Plutarch, “Cuộc Đời Song Song”, “Alexander”, sec. 31)"

#: gui/text/quotes.txt:27
msgid ""
"“Written laws are like spiders' webs; they will catch, it is true, the weak "
"and poor, but will be torn in pieces by the rich and powerful.” \\n— "
"Anacharsis (Plutarch, “Parallel Lives”, “Solon”, sec. 5)"
msgstr "“Luật pháp thành văn giống như mạng nhện; chúng chắc chắn sẽ bắt được kẻ yếu và người nghèo, nhưng sẽ bị kẻ giàu và kẻ quyền lực xé toạc.” — Anacharsis (Plutarch, “Cuộc Đời Song Song”, “Solon”, sec. 5)"

#: gui/text/quotes.txt:28
msgid ""
"“The agora is an established place for men to cheat one another, and behave "
"covetously.” \\n— Anacharsis, a Scythian philosopher who traveled to Greece "
"(Diogenes Laertius, “The Lives and Opinions of Eminent Philosophers”, "
"“Anacharsis”, sec. 5)"
msgstr "“Agora là một nơi được thiết lập để người ta lừa dối lẫn nhau, và hành xử tham lam.” — Anacharsis, một nhà triết học Scythia từng du hành đến Hy Lạp (Diogenes Laertius, “Cuộc Đời và Quan Điểm của Các Nhà Triết Học Nổi Tiếng”, “Anacharsis”, sec. 5)"

#: gui/text/quotes.txt:29
msgid ""
"“It was not by taking care of the fields, but of ourselves, that we acquired"
" those fields.” \\n— Anaxandridas II of Sparta (Plutarch, “Moralia”, "
"“Sayings of Spartans”, 217a)"
msgstr "“Chúng ta có được những cánh đồng không phải do chăm sóc chúng, mà là do chăm sóc chính bản thân mình.” \\n— Anaxandridas II của Sparta (Plutarch, “Moralia”, “Những câu nói của người Sparta”, 217a)"

#: gui/text/quotes.txt:30
msgid ""
"“States are doomed when they are unable to distinguish good men from bad.” "
"\\n— Antisthenes (Diogenes Laertius, “The Lives and Opinions of Eminent "
"Philosophers”, “Antisthenes”, sec. 5)"
msgstr "“Các quốc gia sẽ sụp đổ khi họ không thể phân biệt người tốt với kẻ xấu.” \\n— Antisthenes (Diogenes Laertius, “Cuộc đời và ý kiến của các nhà triết học nổi tiếng”, “Antisthenes”, mục 5)"

#: gui/text/quotes.txt:31
msgid ""
"“The fox knows many tricks; the hedgehog one good one.” \\n— Archilochus "
"(fragment 201)"
msgstr "“Con cáo biết nhiều mánh khóe; con nhím chỉ có một mánh khóe hay.” \\n— Archilochus (mảnh 201)"

#: gui/text/quotes.txt:32
msgid ""
"“Give me a place to stand, and I shall move the world.” \\n— Archimedes, on "
"his usage of the lever (Diodorus Siculus, “The Library of History”, "
"fragments of book XXVI, sec. 18)"
msgstr "“Hãy cho tôi một chỗ để đứng, tôi sẽ di chuyển thế giới.” \\n— Archimedes, về việc ông sử dụng đòn bẩy (Diodorus Siculus, “Thư viện lịch sử”, những mảnh vỡ của cuốn XXVI, mục 18)"

#: gui/text/quotes.txt:33
msgid ""
"“It is from their foes, not their friends, that cities learn the lesson of "
"building high walls and ships of war.” \\n— Aristophanes (“Birds”)"
msgstr "“Các thành phố học bài học xây dựng những bức tường cao và tàu chiến từ kẻ thù, chứ không phải từ bạn bè.” \\n— Aristophanes (“Chim”) "

#: gui/text/quotes.txt:34
msgid ""
"“It is obligatory, especially for a philosopher, to sacrifice even one's "
"closest personal ties in defense of the truth.” \\n— Aristotle (“Nicomachean"
" Ethics”, I. 1096a.11)"
msgstr "“Đặc biệt đối với một nhà triết học, việc hy sinh những mối quan hệ cá nhân thân thiết nhất để bảo vệ sự thật là một điều bắt buộc.” \\n— Aristotle (“Đạo đức Nicomachean”, I. 1096a.11)"

#: gui/text/quotes.txt:35
msgid ""
"“Happiness depends on leisure; for we are busy to have leisure, and make war"
" to live in peace.” \\n— Aristotle (“Nicomachean Ethics”, X. 1177b.4)"
msgstr "“Hạnh phúc phụ thuộc vào sự nhàn rỗi; vì chúng ta bận rộn để có thời gian rỗi, và gây chiến để sống trong hòa bình.” \\n— Aristotle (“Đạo đức Nicomachean”, X. 1177b.4)"

#: gui/text/quotes.txt:36
msgid ""
"“Man is by nature a political animal.” \\n— Aristotle (“Politics”, I. "
"1253a.2)"
msgstr "“Con người về bản chất là một loài vật chính trị.” \\n— Aristotle (“Chính trị”, I. 1253a.2)"

#: gui/text/quotes.txt:37
msgid ""
"“Both oligarch and tyrant mistrust the people, and therefore deprive them of"
" their arms.” \\n— Aristotle (“Politics, V. 1311a.11)"
msgstr "“Cả kẻ đầu sỏ và bạo chúa đều không tin tưởng người dân, và do đó tước đoạt vũ khí của họ.” \\n— Aristotle (“Chính trị, V. 1311a.11)"

#: gui/text/quotes.txt:38
msgid ""
"“I have gained this by philosophy: that I do without being commanded what "
"others do only from fear of the law.” \\n— Aristotle (Diogenes Laertius, "
"“The Lives and Opinions of Eminent Philosophers”, “Aristotle”, sec. 20)"
msgstr "“Tôi đã đạt được điều này nhờ triết học: rằng tôi làm mà không cần ra lệnh những gì người khác chỉ làm vì sợ luật pháp.” \\n— Aristotle (Diogenes Laertius, “Cuộc đời và ý kiến của các nhà triết học nổi tiếng”, “Aristotle”, mục 20)"

#: gui/text/quotes.txt:39
msgid ""
"“I count him braver who overcomes his desires than him who conquers his "
"enemies, for the hardest victory is over the self.” \\n— Aristotle "
"(Stobaeus, “Florilegium”, 223)"
msgstr "“Tôi coi người chiến thắng dục vọng của mình dũng cảm hơn người chinh phục kẻ thù của mình, vì chiến thắng khó khăn nhất là chiến thắng bản thân.” \\n— Aristotle (Stobaeus, “Florilegium”, 223)"

#: gui/text/quotes.txt:40
msgid ""
"“Alexander himself, plagued by thirst, with great pain and difficulty "
"nevertheless led the army on foot \\[…]. At this time a few of the light-"
"armed soldiers \\[…] found some water \\[…], poured the water into a helmet "
"and carried it to him. He took it, and commending the men who brought it, "
"immediately poured it upon the ground in the sight of all.” \\n— Arrian "
"about Alexander's march through the Gedrosian desert (“The Anabasis of "
"Alexander”, 6.26)"
msgstr "“Bản thân Alexander, bị hành hạ bởi cơn khát, với nỗi đau và khó khăn lớn, vẫn dẫn quân đi bộ \\[…]. Lúc này, một vài binh lính trang bị nhẹ \\[…] tìm thấy một ít nước \\[…], đổ nước vào mũ sắt và mang đến cho ông. Ông cầm lấy, khen ngợi những người mang đến, và ngay lập tức đổ xuống đất trước mắt mọi người.” \\n— Arrian kể về cuộc hành quân của Alexander qua sa mạc Gedrosian (“Hành trình của Alexander”, 6.26)"

#: gui/text/quotes.txt:41
msgid ""
"“Thrusting his spear into Mithridates' face, he \\[Alexander] hurled him to "
"the ground. Then Rhoesaces \\[a Persian] \\[…] struck him on the head with "
"his sword. \\[…] Alexander hurled him too to the ground, piercing with his "
"lance through his breastplate into his chest. Sphithridates \\[a Persian] "
"had already raised his sword against Alexander from behind when Clitus \\[…]"
" cut his arm off.” \\n— Arrian about the Battle of the Granicus (“The "
"Anabasis of Alexander”, 1.15)"
msgstr "“Đâm giáo vào mặt Mithridates, ông \\[Alexander] quật ngã hắn xuống đất. Sau đó Rhoesaces \\[một người Ba Tư] \\[…] đánh vào đầu ông bằng kiếm. \\[…] Alexander cũng quật ngã hắn xuống đất, đâm giáo xuyên qua áo giáp vào ngực hắn. Sphithridates \\[một người Ba Tư] đã giơ kiếm chống lại Alexander từ phía sau khi Clitus \\[…] chặt đứt cánh tay hắn.” \\n— Arrian kể về Trận chiến Granicus (“Hành trình của Alexander”, 1.15)"

#: gui/text/quotes.txt:42
msgid ""
"“Let every man remind their descendants that they also are soldiers who must"
" not desert the ranks of their ancestors, or retreat out of cowardice.” \\n—"
" Aspasia (Plato, “Menexenus”, 246b)"
msgstr "“Hãy để mỗi người nhắc nhở con cháu của họ rằng họ cũng là những người lính không được rời bỏ hàng ngũ tổ tiên, hoặc rút lui vì hèn nhát.” \\n— Aspasia (Plato, “Menexenus”, 246b)"

#: gui/text/quotes.txt:43
msgid ""
"“Quintilius Varus, give me back my legions!” \\n— Augustus, after three "
"legions were annihilated in the Battle of the Teutoburg Forest (Suetonius, "
"“Divus Augustus”, sec. 23)"
msgstr "“Quintilius Varus, trả lại quân đoàn của ta!” \\n— Augustus, sau khi ba quân đoàn bị tiêu diệt trong Trận chiến Rừng Teutoburg (Suetonius, “Divus Augustus”, mục 23)"

#: gui/text/quotes.txt:44
msgid ""
"“In my nineteenth year, on my own initiative and at my own expense, I raised"
" an army with which I liberated the state, which was oppressed by the "
"tyranny of a faction.” \\n— Augustus, in his autobiography (“Res Gestae Divi"
" Augusti”, sec. 1)"
msgstr "“Vào năm thứ mười chín, theo sáng kiến và chi phí của riêng mình, tôi đã thành lập một đội quân để giải phóng nhà nước, vốn bị áp bức bởi sự chuyên chế của một phe phái.” \\n— Augustus, trong cuốn tự truyện của ông (“Res Gestae Divi Augusti”, mục 1)"

#: gui/text/quotes.txt:45
msgid ""
"“Wars, both civil and foreign, I waged throughout the world, on sea and "
"land, and when victorious I spared all citizens who sued for pardon. The "
"foreign nations which could with safety be pardoned I preferred to save "
"rather than to destroy.” \\n— Augustus, in his autobiography (“Res Gestae "
"Divi Augusti”, sec. 3)"
msgstr "“Các cuộc chiến tranh, cả nội chiến và ngoại chiến, tôi đã tiến hành trên khắp thế giới, trên biển và trên đất liền, và khi chiến thắng, tôi đã tha cho tất cả các công dân cầu xin tha thứ. Các quốc gia nước ngoài có thể tha thứ an toàn, tôi thà cứu họ hơn là tiêu diệt.” \\n— Augustus, trong cuốn tự truyện của ông (“Res Gestae Divi Augusti”, mục 3)"

#: gui/text/quotes.txt:46
msgid ""
"“Choose the course which you adopt with deliberation; but when you have "
"adopted it, then persevere in it with firmness.” \\n— Bias of Priene "
"(Diogenes Laertius, “The Lives and Opinions of Eminent Philosophers”, "
"“Bias”, sec. 5)"
msgstr "“Hãy chọn con đường bạn đã quyết định một cách thận trọng; nhưng khi bạn đã chọn, hãy kiên trì theo đuổi nó với sự kiên định.” \\n— Bias của Priene (Diogenes Laertius, “Cuộc đời và ý kiến của các nhà triết học nổi tiếng”, “Bias”, mục 5)"

#: gui/text/quotes.txt:47
msgid ""
"“How stupid it was for the king to tear out his hair in grief, as if "
"baldness were a cure for sorrow.” \\n— Bion of Borysthenes (Cicero, "
"“Tusculan Disputations”, III. 26)"
msgstr "“Thật ngu ngốc khi nhà vua nhổ tóc trong đau buồn, như thể hói đầu là một phương thuốc chữa buồn.” \\n— Bion của Borysthenes (Cicero, “Luận đàm Tusculan”, III. 26)"

#: gui/text/quotes.txt:48
msgid ""
"“He has not acquired a fortune; the fortune has acquired him.” \\n— Bion of "
"Borysthenes, referring to a wealthy miser (Diogenes Laertius, “The Lives and"
" Opinions of Eminent Philosophers”, “Bion”, sec. 50)"
msgstr "“Anh ta chưa có được một gia tài; gia tài đã có được anh ta.” \\n— Bion của Borysthenes, nói về một kẻ keo kiệt giàu có (Diogenes Laertius, “Cuộc đời và ý kiến của các nhà triết học nổi tiếng”, “Bion”, mục 50)"

#: gui/text/quotes.txt:49
msgid ""
"“Woe to the Defeated!” \\n— Brennus, Gaulish chieftain who had seized Rome "
"(with the exception of a garrison on Capitoline Hill). When Camillus arrived"
" from Veii and besieged him, he negotiated his withdrawal for 1000 pounds of"
" gold, but not without using false weights and adding the weight of his "
"sword on the scale when the Romans complained (Polybius, “Histories”, II. "
"18)"
msgstr "“Khốn thay kẻ thất bại!” \\n— Brennus, thủ lĩnh người Gaul đã chiếm Rome (ngoại trừ một đơn vị đồn trú trên Đồi Capitoline). Khi Camillus đến từ Veii và bao vây hắn, hắn đã thương lượng việc rút quân để đổi lấy 1000 pound vàng, nhưng không quên sử dụng cân sai và thêm trọng lượng kiếm của hắn vào cân khi người La Mã phàn nàn (Polybius, “Lịch sử”, II. 18)"

#: gui/text/quotes.txt:50
msgid ""
"“Robbery, slaughter, plunder, they \\[the Romans] deceivingly name empire; "
"they make a wasteland and call it peace.” \\n— Calgacus, Caledonian "
"chieftain in a speech before the Battle of Mons Graupius (Tacitus, "
"“Agricola”, 30)"
msgstr "“Cướp bóc, tàn sát, cướp phá, họ \\[người La Mã] lừa dối đặt tên là đế chế; họ tạo ra một vùng đất hoang và gọi đó là hòa bình.” \\n— Calgacus, thủ lĩnh người Caledonian trong một bài phát biểu trước Trận chiến Mons Graupius (Tacitus, “Agricola”, 30)"

#: gui/text/quotes.txt:51
msgid "“Set a thief to catch a thief.” \\n— Callimachus (“Epigrams”, 44)"
msgstr "“Dùng kẻ trộm để bắt kẻ trộm.” \\n— Callimachus (“Tạp thi”, 44)"

#: gui/text/quotes.txt:52
msgid ""
"“All mankind rules its women, and we rule all mankind, but our women rule "
"us.” \\n— Cato the Elder (Plutarch, “Moralia”, “Sayings of Romans”, 198e)"
msgstr "“Tất cả nhân loại cai trị phụ nữ của mình, và chúng ta cai trị tất cả nhân loại, nhưng phụ nữ của chúng ta lại cai trị chúng ta.” \\n— Cato Trưởng lão (Plutarch, “Moralia”, “Những câu nói của người La Mã”, 198e)"

#: gui/text/quotes.txt:53
msgid ""
"“The worst ruler is one who cannot rule himself.” \\n— Cato the Elder "
"(Plutarch, “Moralia”, “Sayings of Romans”, 198f)"
msgstr "“Kẻ cai trị tồi tệ nhất là kẻ không thể cai trị chính mình.” \\n— Cato Trưởng lão (Plutarch, “Moralia”, “Những câu nói của người La Mã”, 198f)"

#: gui/text/quotes.txt:54
msgid ""
"“Wise men learn more from fools than fools from the wise.” \\n— Cato the "
"Elder (Plutarch, “Parallel Lives”, “Cato the Elder”, sec. 9)"
msgstr "“Người khôn ngoan học được nhiều điều từ kẻ ngu hơn là kẻ ngu học từ người khôn ngoan.” \\n— Cato Trưởng lão (Plutarch, “Cuộc đời song song”, “Cato Trưởng lão”, mục 9)"

#: gui/text/quotes.txt:55
msgid ""
"“Moreover, I consider that Carthage should be destroyed.” \\n— Cato the "
"Elder, who ended all speeches in his later life with this statement "
"(Plutarch, “Parallel Lives”, “Cato the Elder”, sec. 27)"
msgstr "“Hơn nữa, tôi cho rằng Carthage nên bị hủy diệt.” \\n— Cato Trưởng lão, người đã kết thúc tất cả các bài diễn văn trong những năm cuối đời bằng câu nói này (Plutarch, “Cuộc đời song song”, “Cato Trưởng lão”, mục 27)"

#: gui/text/quotes.txt:56
msgid ""
"“We did not flinch but gave our lives to save Greece when her fate hung on a"
" razor's edge.” \\n— Corinthian epitaph to their fallen of the Persian Wars "
"(Plutarch, “Moralia”, “On the Malice of Herodotus”, 870e)"
msgstr "“Chúng ta không hề nao núng mà đã hiến dâng mạng sống để cứu Hy Lạp khi số phận của cô ấy treo trên sợi tóc.” \\n— Bia mộ Corinthian dành cho những người đã ngã xuống trong Chiến tranh Ba Tư (Plutarch, “Moralia”, “Về sự ác độc của Herodotus”, 870e)"

#: gui/text/quotes.txt:57
msgid ""
"“Then the blood really flowed, for the two lines were so close that shield "
"struck against shield, and they drove their swords into each other's faces. "
"It was impossible for the weak or cowardly to retreat; man to man they "
"fought like in single combat.” \\n— Curtius Rufus about the Battle of Issus "
"(“Histories of Alexander the Great”, III. 11.5)"
msgstr "“Rồi máu thực sự chảy, vì hai hàng quân quá gần nhau đến nỗi khiên chạm khiên, và họ đâm kiếm vào mặt nhau. Kẻ yếu hay hèn nhát không thể rút lui; người với người họ chiến đấu như trong một cuộc giao đấu cá nhân.” \\n— Curtius Rufus kể về Trận chiến Issus (“Lịch sử của Alexander Đại đế”, III. 11.5)"

#: gui/text/quotes.txt:58
msgid ""
"“I am Cyrus, who won for the Persians their empire. Therefore do not "
"begrudge me this bit of earth that covers my bones.” \\n— Cyrus the Great's "
"epitaph (Plutarch, “Parallel Lives”, “Alexander”, sec. 69)"
msgstr "“Ta là Cyrus, người đã giành cho người Ba Tư đế chế của họ. Vì vậy đừng tiếc nuối cho ta mảnh đất nhỏ này che phủ xương cốt ta.” \\n— Bia mộ của Cyrus Đại đế (Plutarch, “Cuộc đời song song”, “Alexander”, mục 69)"

#: gui/text/quotes.txt:59
msgid ""
"“I am Darius, the great king, king of kings, the king of Persia, the king of"
" countries, \\[…] 23 lands in total.” \\n— Darius I (Behistun inscription, "
"column I, 1–6)"
msgstr "“Ta là Darius, vị vua vĩ đại, vua của các vị vua, vua của Ba Tư, vua của các quốc gia, \\[…] tổng cộng 23 vùng đất.” \\n— Darius I (Bia khắc Behistun, cột I, 1–6)"

#: gui/text/quotes.txt:60
msgid ""
"“Phraortes was captured and brought before me. I cut off his nose, his ears,"
" and his tongue, and I put out one eye, and he was kept in chains at my "
"palace entrance, and all the people saw him. Then I crucified him in "
"Ecbatana; and the men who were his foremost followers \\[…] I flayed and "
"hung out their skins, stuffed with straw.” \\n— Darius I (Behistun "
"inscription, column II, 32)"
msgstr "“Phraortes bị bắt và mang đến trước mặt ta. Ta cắt mũi, tai và lưỡi của hắn, móc một mắt của hắn, và hắn bị giam cầm trong xiềng xích ở lối vào cung điện của ta, và tất cả mọi người đều nhìn thấy hắn. Sau đó ta đóng đinh hắn ở Ecbatana; và những người theo dõi hàng đầu của hắn \\[…] ta lột da và treo da của họ ra ngoài, nhồi rơm.” \\n— Darius I (Bia khắc Behistun, cột II, 32)"

#: gui/text/quotes.txt:61
msgid ""
"“By desiring little, a poor man makes himself rich.” \\n— Democritus "
"(fragment)"
msgstr "“Bằng cách ham muốn ít, một người nghèo tự làm mình giàu có.” \\n— Democritus (mảnh)"

#: gui/text/quotes.txt:62
msgid ""
"“It is hard to be governed by one's inferior.” \\n— Democritus (fragment)"
msgstr "“Thật khó để bị cai trị bởi kẻ kém cỏi hơn mình.” \\n— Democritus (mảnh)"

#: gui/text/quotes.txt:63
msgid ""
"“Physical strength is only noble in cattle, it is strength of character that"
" is noble in men.” \\n— Democritus (fragment)"
msgstr "“Sức mạnh thể chất chỉ cao quý ở gia súc, sức mạnh của tính cách mới cao quý ở con người.” \\n— Democritus (mảnh)"

#: gui/text/quotes.txt:64
msgid ""
"“It is not possible to found a lasting power upon injustice, perjury, and "
"treachery.” \\n— Demosthenes, in one of his many speeches against the rising"
" Philip II of Macedon (“Olynthiac II”, 10)"
msgstr "“Không thể xây dựng một quyền lực bền vững dựa trên sự bất công, bội ước và phản bội.” \\n— Demosthenes, trong một trong nhiều bài phát biểu của ông chống lại sự trỗi dậy của Philip II của Macedonia (“Olynthiac II”, 10)"

#: gui/text/quotes.txt:65
msgid ""
"“Delivery, delivery, delivery.” \\n— Demosthenes, when asked what were the "
"three most important elements of rhetoric (Cicero, “De Oratore”, 3.213)"
msgstr "“Diễn cảm, diễn cảm, diễn cảm.” \\n— Demosthenes, khi được hỏi ba yếu tố quan trọng nhất của hùng biện là gì (Cicero, “De Oratore”, 3.213)"

#: gui/text/quotes.txt:66
msgid ""
"“The Macedonians first raised an unearthly shout followed by the Persians "
"answering, so that the whole hillside bordering the battlefield echoed back "
"the sound, and that second roar was louder than the Macedonian war cry as "
"five hundred thousand men shouted with one voice.” \\n— Diodorus Siculus "
"about the Battle of Issus (“The Library of History”, XVII., sec. 33)"
msgstr "“Người Macedonia đầu tiên hô vang một tiếng kêu kỳ lạ, sau đó là người Ba Tư đáp lại, khiến toàn bộ sườn đồi giáp chiến trường vang vọng âm thanh, và tiếng gầm thứ hai đó lớn hơn tiếng hô xung trận của người Macedonia khi năm trăm nghìn người cùng hô vang một tiếng.” \\n— Diodorus Siculus kể về Trận chiến Issus (“Thư viện lịch sử”, XVII., mục 33)"

#: gui/text/quotes.txt:67
msgid ""
"“Brasidas, taking his stand on the gangway, fought off from there the "
"multitude of Athenians who converged upon him. And at the outset he slew "
"many as they came at him, but after a while, as numerous missiles assailed "
"him, he suffered many wounds on the front of his body.” \\n— Diodorus "
"Siculus, on a brave Spartan at the Battle of Pylos (“The Library of "
"History”, XXII., sec. 62)"
msgstr "“Brasidas, đứng trên cầu tàu, chiến đấu chống lại đám đông người Athens đổ xô đến ông. Và lúc đầu, ông đã giết chết nhiều người khi họ đến gần ông, nhưng sau một thời gian, khi nhiều mũi tên tấn công ông, ông đã chịu nhiều vết thương ở phía trước cơ thể.” \\n— Diodorus Siculus, về một người Spartan dũng cảm trong Trận chiến Pylos (“Thư viện lịch sử”, XXII., mục 62)"

#: gui/text/quotes.txt:68
msgid ""
"“Plato had defined man as an animal, biped and featherless, and was "
"applauded. Diogenes \\[of Sinope] plucked a fowl and brought it into the "
"lecture-room with the words: Here is Plato's man. In consequence of which "
"there was added to the definition: having broad nails.” \\n— Diogenes "
"Laertius (“The Lives and Opinions of Eminent Philosophers”, “Diogenes”, sec."
" 40)"
msgstr "“Plato đã định nghĩa con người là một loài vật, hai chân và không lông, và được hoan nghênh. Diogenes \\[của Sinope] nhổ lông một con gà và mang nó vào phòng giảng với những lời: Đây là con người của Plato. Do đó, định nghĩa được bổ sung thêm: có móng tay rộng.” \\n— Diogenes Laertius (“Cuộc đời và ý kiến của các nhà triết học nổi tiếng”, “Diogenes”, mục 40)"

#: gui/text/quotes.txt:69
msgid ""
"“I am a citizen of the world.” \\n— Diogenes of Sinope (Diogenes Laertius, "
"“The Lives and Opinions of Eminent Philosophers”, “Diogenes”, sec. 63)"
msgstr "“Tôi là công dân của thế giới.” \\n— Diogenes của Sinope (Diogenes Laertius, “Cuộc đời và ý kiến của các nhà triết học nổi tiếng”, “Diogenes”, mục 63)"

#: gui/text/quotes.txt:70
msgid ""
"“It is not that I am mad, it is only that my head is different from yours.” "
"\\n— Diogenes of Sinope (Stobaeus, “Florilegium”, 51)"
msgstr "“Không phải tôi điên, mà là đầu tôi khác với đầu của bạn.” \\n— Diogenes của Sinope (Stobaeus, “Florilegium”, 51)"

#: gui/text/quotes.txt:71
msgid ""
"“Yes, stand a little out of my sunshine.” \\n— Diogenes of Sinope to "
"Alexander the Great, who asked if he could help in in any way (Plutarch, "
"“Parallel Lives”, “Alexander”, sec. 14)"
msgstr "“Vâng, hãy đứng ra khỏi ánh nắng của tôi một chút.” \\n— Diogenes của Sinope nói với Alexander Đại đế, người đã hỏi liệu ông có thể giúp đỡ bằng cách nào đó không (Plutarch, “Cuộc đời song song”, “Alexander”, mục 14)"

#: gui/text/quotes.txt:72
msgid ""
"“The victor is not victorious if the vanquished does not consider himself "
"so.” \\n— Ennius (“Annales”, fragment 31.493)"
msgstr "“Kẻ chiến thắng không chiến thắng nếu kẻ bị đánh bại không coi mình là vậy.” \\n— Ennius (“Biên niên sử”, mảnh 31.493)"

#: gui/text/quotes.txt:73
msgid ""
"“Stranger, go tell the Spartans that we lie here, obedient to their laws.” "
"\\n— Epitaph at Thermopylae for Leonidas and his men (Herodotus, “The "
"Histories”, VII. 228)"
msgstr "“Hỡi người lạ, hãy đi nói với người Sparta rằng chúng ta nằm đây, tuân theo luật pháp của họ.” \\n— Bia mộ tại Thermopylae cho Leonidas và những người lính của ông (Herodotus, “Lịch sử”, VII. 228)"

#: gui/text/quotes.txt:74
msgid ""
"“A coward turns away, but a brave man's choice is danger.” \\n— Euripides "
"(“Iphigenia in Tauris”)"
msgstr "“Kẻ hèn nhát quay lưng, nhưng sự lựa chọn của người dũng cảm là nguy hiểm.” \\n— Euripides (“Iphigenia ở Tauris”)"

#: gui/text/quotes.txt:75
msgid ""
"“Brave men are made bolder by ordeals, but cowards achieve nothing.” \\n— "
"Euripides (“Iphigenia in Tauris”)"
msgstr "“Người dũng cảm được làm cho can đảm hơn bởi thử thách, nhưng kẻ hèn nhát chẳng đạt được gì.” \\n— Euripides (“Iphigenia ở Tauris”)"

#: gui/text/quotes.txt:76
msgid ""
"“Cowards do not count in battle; they are there, but not in it.” \\n— "
"Euripides (“Meleager”)"
msgstr "“Những kẻ hèn nhát không đáng kể trong trận chiến; họ ở đó, nhưng không tham gia vào đó.” \\n— Euripides (“Meleager”)"

#: gui/text/quotes.txt:77
msgid ""
"“Chance fights ever on the side of the prudent.” \\n— Euripides "
"(“Pirithous”)"
msgstr "“Cơ hội luôn chiến đấu về phía những người thận trọng.” \\n— Euripides (“Pirithous”)"

#: gui/text/quotes.txt:78
msgid ""
"“Return with your shield, or on it.” \\n— Farewell of Spartan women to their"
" warriors, implying that cowards would throw away their shield in battle to "
"flee (Plutarch, “Moralia”, “Sayings of Spartan Women”, 241f)"
msgstr "“Hãy trở về với tấm khiên của con, hoặc nằm trên nó.” \\n— Lời tạm biệt của những người phụ nữ Sparta với các chiến binh của họ, ngụ ý rằng những kẻ hèn nhát sẽ vứt bỏ khiên của họ trong trận chiến để bỏ chạy (Plutarch, “Moralia”, “Những câu nói của phụ nữ Spartan”, 241f)"

#: gui/text/quotes.txt:79
msgid ""
"“I came, I saw, I conquered.” \\n— Caesar, after routing Pharnaces II of "
"Pontus in the first assault (Plutarch, “Parallel Lives”, “Caesar”, sec. 50)"
msgstr "“Tôi đến, tôi thấy, tôi chinh phục.” \\n— Caesar, sau khi đánh bại Pharnaces II của Pontus trong cuộc tấn công đầu tiên (Plutarch, “Cuộc đời song song”, “Caesar”, mục 50)"

#: gui/text/quotes.txt:80
msgid ""
"“Men willingly believe what they wish.” \\n— Caesar (“De Bello Gallico”, "
"III. 18)"
msgstr "“Con người sẵn lòng tin vào những gì họ muốn.” \\n— Caesar (“Về chiến tranh Gaul”, III. 18)"

#: gui/text/quotes.txt:81
msgid ""
"“It is not the well-fed long-haired man I fear, but the pale and the hungry "
"looking.” \\n— Caesar (Plutarch, “Parallel Lives”, “Antony”, sec. 11)"
msgstr "“Tôi không sợ người đàn ông khỏe mạnh, tóc dài, mà tôi sợ người gầy gò, xanh xao và đói khát.” \\n— Caesar (Plutarch, “Cuộc đời song song”, “Antony”, mục 11)"

#: gui/text/quotes.txt:82
msgid ""
"“After fighting from noon almost to sunset, with victory doubtful, the "
"Germans, on one side charged the enemy in a compact body, and drove them "
"back; and, when they were put to flight, the archers were surrounded and cut"
" to pieces.” \\n— Caesar about the Battle of Alesia (“De Bello Gallico”, "
"VII. 80)"
msgstr "“Sau khi chiến đấu từ trưa gần đến hoàng hôn, với chiến thắng không chắc chắn, người Đức, một bên tấn công kẻ thù thành một khối chặt chẽ, và đẩy lùi chúng; và, khi chúng bị đánh bại, những người bắn cung bị bao vây và bị chém thành từng mảnh.” \\n— Caesar kể về Trận chiến Alesia (“Về chiến tranh Gaul”, VII. 80)"

#: gui/text/quotes.txt:83
msgid ""
"“All the centurions of the fourth cohort were slain, and the standard-bearer"
" killed, the standard itself lost, almost all the centurions of the other "
"cohorts either wounded or slain, and among them the chief centurion of the "
"legion, Publius Sextius Baculus, a very valiant man, who was so exhausted by"
" many and severe wounds, that he was already unable to support himself.” "
"\\n— Caesar about the Battle of the Sabis (“De Bello Gallico”, II. 25)"
msgstr "“Tất cả các đội trưởng của coho thứ tư đều bị giết, và người cầm cờ bị giết, bản thân cờ hiệu bị mất, gần như tất cả các đội trưởng của các coho khác đều bị thương hoặc bị giết, và trong số đó có đội trưởng chính của quân đoàn, Publius Sextius Baculus, một người rất dũng cảm, người đã kiệt sức vì nhiều vết thương nghiêm trọng đến nỗi ông ấy không thể tự mình đứng vững được nữa.” \\n— Caesar kể về Trận chiến Sabis (“Về chiến tranh Gaul”, II. 25)"

#: gui/text/quotes.txt:84
msgid ""
"“But the enemy \\[…] displayed such great courage, that when the front rank "
"had fallen the men behind them stood on them and continue the fight from on "
"top of the corpses; when these were killed the pile of bodies grew higher, "
"while the survivors used the heap as a vantage point for throwing missiles "
"at our men, or catching our spears and throwing them back.” \\n— Caesar "
"about the Battle of the Sabis (“De Bello Gallico”, II. 27)"
msgstr "“Nhưng kẻ thù \\[…] đã thể hiện một sự dũng cảm lớn đến mức khi hàng quân phía trước ngã xuống, những người phía sau đứng lên trên họ và tiếp tục chiến đấu từ trên đỉnh các thi thể; khi những người này bị giết, đống xác chết cao hơn, trong khi những người sống sót sử dụng đống đó làm điểm thuận lợi để ném tên vào người của chúng ta, hoặc bắt lấy giáo của chúng ta và ném trả lại.” \\n— Caesar kể về Trận chiến Sabis (“Về chiến tranh Gaul”, II. 27)"

#: gui/text/quotes.txt:85
msgid ""
"“The die is cast.” \\n— Caesar, when crossing the Rubicon river with his "
"legion into Italy, a capital offense that led to his civil war against "
"Pompey (Suetonius, “The Lives of the Twelve Caesars”, 32)"
msgstr "“Con xúc xắc đã được gieo.” \\n— Caesar, khi vượt sông Rubicon cùng quân đoàn của mình vào Ý, một tội trọng có thể bị tử hình đã dẫn đến cuộc nội chiến của ông chống lại Pompey (Suetonius, “Cuộc đời của Mười hai Caesar”, 32)"

#: gui/text/quotes.txt:86
msgid ""
"“I'd rather be the first man here than the second man in Rome.” \\n— Caesar,"
" when passing through a barbarian village in the Alps (Plutarch, “Parallel "
"Lives”, “Caesar”, sec. 11)"
msgstr "“Tôi thà làm người đứng đầu ở đây còn hơn làm người thứ hai ở Rome.” \\n— Caesar, khi đi qua một ngôi làng man rợ ở dãy Alps (Plutarch, “Cuộc đời song song”, “Caesar”, mục 11)"

#: gui/text/quotes.txt:87
msgid ""
"“Stop quoting laws, we carry weapons!” \\n— Pompey (Plutarch, “Parallel "
"Lives”, “Pompey”, sec. 10)"
msgstr "“Đừng viện dẫn luật pháp nữa, chúng ta mang vũ khí!” \\n— Pompey (Plutarch, “Cuộc đời song song”, “Pompey”, mục 10)"

#: gui/text/quotes.txt:88
msgid ""
"“If a man put out the eye of another man, his eye shall be put out.” \\n— "
"Hammurabi (Hammurabi's Code, sec. 196)"
msgstr "“Nếu một người làm hỏng mắt người khác, mắt của anh ta sẽ bị làm hỏng.” \\n— Hammurabi (Bộ luật Hammurabi, mục 196)"

#: gui/text/quotes.txt:89
msgid ""
"“I have come not to make war on the Italians, but to aid the Italians "
"against Rome.” \\n— Hannibal (Polybius, “Histories”, III. 85)"
msgstr "“Tôi đến không phải để gây chiến với người Ý, mà là để giúp người Ý chống lại Rome.” \\n— Hannibal (Polybius, “Lịch sử”, III. 85)"

#: gui/text/quotes.txt:90
msgid ""
"“Let us now end the anxiety of the Romans, who can't wait for the death of "
"an old man.” \\n— Hannibal's last words before his suicide, in exile with "
"Flaminius pressuring the local ruler to hand him over (Livy, “History of "
"Rome”, XXXIX. 51)"
msgstr "“Bây giờ chúng ta hãy chấm dứt sự lo lắng của người La Mã, những người không thể chờ đợi cái chết của một ông già.” \\n— Những lời cuối cùng của Hannibal trước khi tự tử, trong cảnh lưu đày khi Flaminius gây áp lực buộc người cai trị địa phương phải giao nộp ông (Livy, “Lịch sử Rome”, XXXIX. 51)"

#: gui/text/quotes.txt:91
msgid ""
"“Most inhuman and most arrogant of nations, they \\[the Romans] reckon the "
"world as theirs and subject to their pleasure. With whom we are to be at "
"war, with whom at peace, they think it right that they should determine.” "
"\\n— Hannibal, addressing his troops (Livy, “History of Rome”, XXI. 44)"
msgstr "“Là những dân tộc vô nhân đạo và kiêu ngạo nhất, họ \\[người La Mã] coi thế giới là của mình và phải tuân theo ý muốn của họ. Với ai chúng ta sẽ gây chiến, với ai chúng ta sẽ hòa bình, họ nghĩ rằng họ có quyền quyết định.” \\n— Hannibal, nói chuyện với quân đội của mình (Livy, “Lịch sử Rome”, XXI. 44)"

#: gui/text/quotes.txt:92
msgid ""
"“You must be brave and discard all hopes of anything but victory or death.” "
"\\n— Hannibal, addressing his troops (Livy, “History of Rome”, XXI. 44)"
msgstr "“Các bạn phải dũng cảm và vứt bỏ mọi hy vọng về bất cứ điều gì ngoài chiến thắng hoặc cái chết.” \\n— Hannibal, nói chuyện với quân đội của mình (Livy, “Lịch sử Rome”, XXI. 44)"

#: gui/text/quotes.txt:93
msgid ""
"“War is the father and king of all things: some he has made gods, and some "
"men; some slaves and some free.” \\n— Heraclitus (Hippolytus, “The "
"Refutation of all Heresies”, IX. 4)"
msgstr "“Chiến tranh là cha và là vua của vạn vật: một số ông đã tạo ra các vị thần, và một số người; một số nô lệ và một số tự do.” \\n— Heraclitus (Hippolytus, “Sự bác bỏ tất cả các giáo phái”, IX. 4)"

#: gui/text/quotes.txt:94
msgid ""
"“You could not step twice into the same river.” \\n— Heraclitus (Plato, "
"“Cratylus”, 402a)"
msgstr "“Bạn không thể bước hai lần xuống cùng một dòng sông.” \\n— Heraclitus (Plato, “Cratylus”, 402a)"

#: gui/text/quotes.txt:95
msgid ""
"“It is better to be envied than to be pitied.” \\n— Herodotus (“The "
"Histories”, III. 52)"
msgstr "“Thà bị ghen tị còn hơn bị thương hại.” \\n— Herodotus (“Lịch sử”, III. 52)"

#: gui/text/quotes.txt:96
msgid ""
"“In soft regions are born soft men.” \\n— Herodotus (“The Histories”, IX. "
"122)"
msgstr "“Ở những vùng đất mềm yếu sinh ra những người yếu đuối.” \\n— Herodotus (“Lịch sử”, IX. 122)"

#: gui/text/quotes.txt:97
msgid ""
"“This is the bitterest pain among men, to have much knowledge but no power.”"
" \\n— Herodotus (“The Histories”, IX. 16)"
msgstr "“Đây là nỗi đau đớn cay đắng nhất trong số những người đàn ông, có nhiều kiến thức nhưng không có quyền lực.” \\n— Herodotus (“Lịch sử”, IX. 16)"

#: gui/text/quotes.txt:98
msgid ""
"“Although he \\[Xerxes] had plenty of troops he had few men.” \\n— Herodotus"
" (“The Histories”, VII. 210)"
msgstr "“Mặc dù ông ta \\[Xerxes] có rất nhiều quân đội nhưng lại có rất ít người.” \\n— Herodotus (“Lịch sử”, VII. 210)"

#: gui/text/quotes.txt:99
msgid ""
"“The Lacedaemonians \\[Spartans] fought a memorable battle; they made it "
"quite clear that they were the experts, and that they were fighting against "
"amateurs.” \\n— Herodotus (“The Histories”, VII. 211)"
msgstr "“Người Lacedaemon (Spartans) đã chiến đấu một trận đáng nhớ; họ đã làm rõ rằng họ là những chuyên gia, và họ đang chiến đấu chống lại những người nghiệp dư.” \\n— Herodotus (“Lịch sử”, VII. 211)"

#: gui/text/quotes.txt:100
msgid ""
"“Being informed \\[…] that when the Barbarians discharged their arrows they "
"obscured the light of the sun by the multitude of the arrows, he "
"\\[Dieneces] \\[…] said that their guest \\[…] brought them very good news, "
"for if the Medes obscured the light of the sun, the battle against them "
"would be in the shade and not in the sun.” \\n— Herodotus describing "
"Dieneces, reputedly the bravest Spartan soldier at Thermopylae (Polybius, "
"“Histories”, VII. 226)"
msgstr "“Được thông báo \\[…] rằng khi những người man rợ bắn tên, họ che khuất ánh sáng mặt trời bằng vô số mũi tên, ông \\[Dieneces] \\[…] nói rằng vị khách của họ \\[…] đã mang đến cho họ một tin tức rất tốt, vì nếu người Medes che khuất ánh sáng mặt trời, trận chiến chống lại họ sẽ diễn ra trong bóng râm chứ không phải dưới ánh nắng mặt trời.” \\n— Herodotus mô tả Dieneces, được cho là người lính Spartan dũng cảm nhất tại Thermopylae (Polybius, “Lịch sử”, VII. 226)"

#: gui/text/quotes.txt:101
msgid ""
"“The judgment given to Croesus by each of the two oracles \\[Delphi and "
"Thebes] was the same: If he sent an army against the Persians, he would "
"destroy a great empire.” \\n— Herodotus, later mentioning that the empire "
"Croesus destroyed was his own (“The Histories”, I. 53)"
msgstr "“Lời phán truyền cho Croesus từ cả hai nhà tiên tri \\[Delphi và Thebes] đều giống nhau: Nếu ông ta đưa quân đội chống lại người Ba Tư, ông ta sẽ hủy diệt một đế chế vĩ đại.” \\n— Herodotus, sau đó nhắc đến việc đế chế mà Croesus hủy diệt chính là của riêng ông (“Lịch sử”, I. 53)"

#: gui/text/quotes.txt:102
msgid ""
"“He \\[King Darius] asked who the Athenians were, and, being informed, "
"called for his bow, and placing an arrow on the string, shot upward into the"
" sky, saying, as he let fly the shaft: Grant me, Zeus, to revenge myself on "
"the Athenians!” \\n— Herodotus, narrating how the Athenian support for the "
"Ionian revolt caught the wrath of Darius I, the Persian king (“The "
"Histories”, V. 105)"
msgstr "“Ông ấy \\[Vua Darius] hỏi người Athens là ai, và, khi được thông báo, đã gọi cung của mình, đặt một mũi tên vào dây cung, bắn lên trời, nói khi mũi tên bay đi: Hỡi Zeus, hãy ban cho ta sự trả thù người Athens!” \\n— Herodotus, kể lại việc người Athens ủng hộ cuộc nổi dậy Ionian đã khiến Darius I, vị vua Ba Tư, nổi giận như thế nào (“Lịch sử”, V. 105)"

#: gui/text/quotes.txt:103
msgid ""
"“He \\[King Darius] asked one of his servants every day, when his dinner was"
" spread, three times to repeat to him: Master, remember the Athenians!” \\n—"
" Herodotus, narrating how the Athenian support for the Ionian revolt lead to"
" the Persian Wars (“The Histories”, V. 105)"
msgstr "“Ông ấy \\[Vua Darius] hỏi một trong những người hầu của mình mỗi ngày, khi bữa tối của ông được dọn ra, ba lần lặp lại cho ông: Chủ nhân, hãy nhớ đến người Athens!” \\n— Herodotus, kể lại việc người Athens ủng hộ cuộc nổi dậy Ionian đã dẫn đến Chiến tranh Ba Tư như thế nào (“Lịch sử”, V. 105)"

#: gui/text/quotes.txt:104
msgid ""
"“Conquered Greece took captive her savage conqueror and brought her arts "
"into rustic Latium.” \\n— Horace (“Epistles”, epistle I., 156–157)"
msgstr "“Hy Lạp bị chinh phục đã bắt giữ kẻ chinh phục man rợ của mình và mang nghệ thuật của mình vào vùng Latium nông thôn.” \\n— Horace (“Thư tín”, thư I., 156–157)"

#: gui/text/quotes.txt:105
msgid ""
"“Anger is a momentary madness, so control your passion or it will control "
"you.” \\n— Horace (“Epistles”, epistle II., 62)"
msgstr "“Giận dữ là một cơn điên rồ nhất thời, vì vậy hãy kiểm soát đam mê của bạn nếu không nó sẽ kiểm soát bạn.” \\n— Horace (“Thư tín”, thư II., 62)"

#: gui/text/quotes.txt:106
msgid ""
"“It is your concern when your neighbor's wall is on fire.” \\n— Horace "
"(“Epistles”, epistle XVIII., 84)"
msgstr "“Đó là mối bận tâm của bạn khi bức tường của hàng xóm bạn đang bốc cháy.” \\n— Horace (“Thư tín”, thư XVIII., 84)"

#: gui/text/quotes.txt:107
msgid ""
"“It is sweet and honorable to die for one's country.” \\n— Horace (“Odes”, "
"III., ode II., 13)"
msgstr "“Thật ngọt ngào và vinh quang khi chết vì đất nước mình.” \\n— Horace (“Odes”, III., ode II., 13)"

#: gui/text/quotes.txt:108
msgid "“I am Cyrus, king of the world…” \\n— Inscription (Cyrus Cylinder)"
msgstr "“Ta là Cyrus, vua của thế giới…” \\n— Bia khắc (Trụ Cyrus)"

#: gui/text/quotes.txt:109
msgid ""
"“In peace the sons bury their fathers, but in war the fathers bury their "
"sons.” \\n— Croesus, king of Lydia (Herodotus, “The Histories”, I. 87)"
msgstr "“Trong hòa bình, con trai chôn cha, nhưng trong chiến tranh, cha chôn con.” \\n— Croesus, vua xứ Lydia (Herodotus, “Lịch sử”, I. 87)"

#: gui/text/quotes.txt:110
msgid ""
"“Whoever imposes severe punishment becomes repulsive to the people; while he"
" who awards mild punishment becomes contemptible. But whoever imposes "
"punishment as deserved becomes respectable.”\\n— Kauṭilya (“Arthashastra”, "
"I.4.8–10)"
msgstr "“Bất cứ ai áp đặt hình phạt nghiêm khắc sẽ trở nên đáng ghét đối với người dân; trong khi người ban thưởng hình phạt nhẹ sẽ trở nên đáng khinh. Nhưng bất cứ ai áp đặt hình phạt xứng đáng sẽ trở nên đáng kính.”\\n— Kauṭilya (“Arthashastra”, I.4.8–10)"

#: gui/text/quotes.txt:111
msgid ""
"“If a king is energetic, his subjects will be equally energetic.”\\n— "
"Kauṭilya (“Arthashastra” I.19.1)"
msgstr "“Nếu một vị vua năng động, thần dân của ông ta cũng sẽ năng động không kém.”\\n— Kauṭilya (“Arthashastra” I.19.1)"

#: gui/text/quotes.txt:112
msgid ""
"“Marry a good man, and bear good children.” \\n— Leonidas, to his wife who "
"asked what to do if he died, before he left for Thermopylae (Plutarch, "
"“Moralia”, “Sayings of Spartans”, 225a)"
msgstr "“Hãy cưới một người đàn ông tốt, và sinh ra những đứa con tốt.” \\n— Leonidas, nói với vợ ông, người đã hỏi phải làm gì nếu ông qua đời, trước khi ông lên đường đến Thermopylae (Plutarch, “Moralia”, “Những câu nói của người Sparta”, 225a)"

#: gui/text/quotes.txt:113
msgid ""
"“Come and get them!” \\n— Leonidas, to the Persian messenger who demanded "
"that he and his men lay down their arms (Plutarch, “Moralia”, “Sayings of "
"Spartans”, 225c)"
msgstr "“Đến mà lấy đi!” \\n— Leonidas, nói với sứ giả Ba Tư, người đã yêu cầu ông và những người lính của ông hạ vũ khí (Plutarch, “Moralia”, “Những câu nói của người Sparta”, 225c)"

#: gui/text/quotes.txt:114
msgid ""
"“Some were discovered lying there alive, with thighs and tendons slashed, "
"baring their necks and throats and bidding their conquerors drain the "
"remnant of their blood. Others were found with their heads buried in holes "
"dug in the ground. They had apparently made these pits for themselves.” \\n—"
" Livy, describing the aftermath of the Battle of Cannae, where Hannibal "
"inflicted the greatest defeat on the Romans in all their history (“History "
"of Rome”, XXII. 51)"
msgstr "“Một số được phát hiện nằm đó còn sống, với đùi và gân bị chém, để lộ cổ và họng và kêu gọi những kẻ chinh phục rút hết máu còn lại của họ. Những người khác được tìm thấy với đầu vùi trong những cái hố đào dưới đất. Họ dường như đã tự đào những cái hố này cho mình.” \\n— Livy, mô tả hậu quả của Trận chiến Cannae, nơi Hannibal đã gây ra thất bại lớn nhất cho người La Mã trong toàn bộ lịch sử của họ (“Lịch sử Rome”, XXII. 51)"

#: gui/text/quotes.txt:115
msgid ""
"“There lay thousands upon thousands of Romans \\[…]. Here and there amidst "
"the slain rose a gory figure whose wounds had begun to throb with the chill "
"of dawn, and was cut down by his enemies.” \\n— Livy, describing the "
"aftermath of the Battle of Cannae, where Hannibal inflicted the greatest "
"defeat on the Romans in all their history (“History of Rome”, XXII. 51)"
msgstr "“Hàng ngàn hàng ngàn người La Mã nằm đó \\[…]. Ở đây đó giữa những người bị giết trỗi dậy một hình bóng đẫm máu mà vết thương của ông ta bắt đầu nhói lên trong cái lạnh của bình minh, và bị kẻ thù của ông ta chém hạ.” \\n— Livy, mô tả hậu quả của Trận chiến Cannae, nơi Hannibal đã gây ra thất bại lớn nhất cho người La Mã trong toàn bộ lịch sử của họ (“Lịch sử Rome”, XXII. 51)"

#: gui/text/quotes.txt:116
msgid ""
"“A city is well-fortified which has a wall of men instead of brick.” \\n— "
"Lycurgus of Sparta (Plutarch, “Parallel Lives”, “Lycurgus”, sec. 19)"
msgstr "“Một thành phố được phòng thủ tốt là thành phố có bức tường là những người đàn ông thay vì gạch.” \\n— Lycurgus của Sparta (Plutarch, “Cuộc đời song song”, “Lycurgus”, mục 19)"

#: gui/text/quotes.txt:117
msgid ""
"“Escape, yes, but this time with my hands, not my feet.” \\n— Brutus, before"
" committing suicide after losing a battle against Caesar's avengers "
"(Plutarch, “Parallel Lives”, “Brutus”, sec. 52)"
msgstr "“Trốn thoát, vâng, nhưng lần này bằng tay, không phải bằng chân.” \\n— Brutus, trước khi tự sát sau khi thua một trận chiến chống lại những kẻ báo thù của Caesar (Plutarch, “Cuộc đời song song”, “Brutus”, mục 52)"

#: gui/text/quotes.txt:118
msgid "“O, the times, O, the customs!” \\n— Cicero (“Against Catiline”, I.)"
msgstr "“Ôi, thời đại, Ôi, phong tục!” \\n— Cicero (“Chống lại Catiline”, I.)"

#: gui/text/quotes.txt:119
msgid ""
"“A war is never undertaken by the ideal State, except in defense of its "
"honor or its safety.” \\n— Cicero (“De Re Publica”, III., 23)"
msgstr "“Một cuộc chiến không bao giờ được nhà nước lý tưởng tiến hành, trừ khi để bảo vệ danh dự hoặc an toàn của nó.” \\n— Cicero (“Về Cộng hòa”, III., 23)"

#: gui/text/quotes.txt:120
msgid ""
"“The first duty of a man is the seeking after and the investigation of "
"truth.” \\n— Cicero (“On Duties”, I., 13)"
msgstr "“Nghĩa vụ đầu tiên của một người đàn ông là tìm kiếm và điều tra sự thật.” \\n— Cicero (“Về nghĩa vụ”, I., 13)"

#: gui/text/quotes.txt:121
msgid ""
"“No one is so old as to think that he cannot live one more year.” \\n— "
"Cicero (“On Old Age”, sec. 24)"
msgstr "“Không ai già đến nỗi nghĩ rằng mình không thể sống thêm một năm nữa.” \\n— Cicero (“Về tuổi già”, mục 24)"

#: gui/text/quotes.txt:122
msgid ""
"“Let the welfare of the people be the ultimate law.” \\n— Cicero (“On the "
"Laws”, III., sec. 3)"
msgstr "“Hãy để phúc lợi của nhân dân là luật tối cao.” \\n— Cicero (“Về luật pháp”, III., mục 3)"

#: gui/text/quotes.txt:123
msgid ""
"“Endless money forms the sinews of war.” \\n— Cicero (“Philippics”, V., sec."
" 5)"
msgstr "“Tiền bạc vô tận tạo nên xương sống của chiến tranh.” \\n— Cicero (“Philippics”, V., mục 5)"

#: gui/text/quotes.txt:124
msgid ""
"“Laws are silent in time of war.” \\n— Cicero (“Pro Milone”, IV., sec. 11)"
msgstr "“Luật pháp im lặng trong thời chiến.” \\n— Cicero (“Pro Milone”, IV., mục 11)"

#: gui/text/quotes.txt:125
msgid ""
"“That, Senators, is what a favour from gangs amounts to. They refrain from "
"murdering someone; then they boast that they have spared him!” \\n— Cicero, "
"condemning Mark Anthony who had not killed him (yet) (“Philippics”, II., "
"sec. 5)"
msgstr "“Thưa các Nghị sĩ, đó là những gì một sự ưu ái từ các băng đảng mang lại. Họ kiềm chế không giết người; rồi họ khoe khoang rằng họ đã tha cho anh ta!” \\n— Cicero, lên án Mark Antony người vẫn chưa giết ông (chưa) (“Philippics”, II., mục 5)"

#: gui/text/quotes.txt:126
msgid ""
"“He did not even stand up to review his fleet when the ships were already at"
" their fighting stations, but lay on his back and gazed up at the sky, never"
" rising to show that he was alive until Marcus Agrippa had routed the "
"enemy.” \\n— Mark Antony, taunting Augustus who delegated his duties as "
"naval commander (Suetonius, “Divus Augustus”, sec. 16)"
msgstr "“Ông ta thậm chí không đứng dậy để duyệt hạm đội của mình khi các con tàu đã ở vị trí chiến đấu, mà nằm ngửa nhìn lên bầu trời, không bao giờ đứng dậy để cho thấy mình còn sống cho đến khi Marcus Agrippa đã đánh bại kẻ thù.” \\n— Mark Antony, chế nhạo Augustus người đã ủy thác nhiệm vụ chỉ huy hải quân của mình (Suetonius, “Thần Augustus”, mục 16)"

#: gui/text/quotes.txt:127
msgid ""
"“We live, not as we wish to, but as we can.” \\n— Menander (“Lady of "
"Andros”, fragment 50)"
msgstr "“Chúng ta sống, không phải theo cách chúng ta muốn, mà là theo cách chúng ta có thể.” \\n— Menander (“Người phụ nữ Andros”, mảnh 50)"

#: gui/text/quotes.txt:128
msgid "“The man who runs may fight again.” \\n— Menander (“Monosticha”)"
msgstr "“Người đàn ông chạy có thể chiến đấu lần nữa.” \\n— Menander (“Monosticha”)"

#: gui/text/quotes.txt:129
msgid ""
"“Whom the Gods love dies young.” \\n— Menander (“The Double Deceiver”, "
"fragment 4)"
msgstr "“Người mà các vị thần yêu thương chết trẻ.” \\n— Menander (“Kẻ lừa đảo hai mặt”, mảnh 4)"

#: gui/text/quotes.txt:130
msgid "“I call a fig a fig, a spade a spade.” \\n— Menander (fragment 545 K)"
msgstr "“Tôi gọi quả vả là quả vả, xẻng là xẻng.” \\n— Menander (mảnh 545 K)"

#: gui/text/quotes.txt:131
msgid ""
"“The greatest glory is won from the greatest dangers. When our fathers faced"
" the Persians their resources could not compare to ours. In fact, they gave "
"up even what they had. Then by wise counsels and daring deeds, not fortune "
"and material advantages, they drove out the invaders and made our city what "
"it is now.” \\n— Pericles (Thucydides, “History of the Peloponnesian War”, "
"I. 144.3–4)"
msgstr "“Vinh quang lớn nhất được giành từ những nguy hiểm lớn nhất. Khi cha ông chúng ta đối mặt với người Ba Tư, nguồn lực của họ không thể so sánh với chúng ta. Thực tế, họ thậm chí đã từ bỏ những gì họ có. Sau đó, bằng những lời khuyên khôn ngoan và những hành động táo bạo, không phải vận may và lợi thế vật chất, họ đã đánh đuổi quân xâm lược và biến thành phố của chúng ta thành như bây giờ.” \\n— Pericles (Thucydides, “Lịch sử chiến tranh Peloponnesian”, I. 144.3–4)"

#: gui/text/quotes.txt:132
msgid ""
"“Instead of looking on discussion as a stumbling block in the way of action,"
" we think it an indispensable preliminary to any wise action at all.” \\n— "
"Pericles in his Funeral Oration for Athenians that died in the first year of"
" the war (Thucydides, “History of the Peloponnesian War”, II. 40.2)"
msgstr "“Thay vì coi thảo luận là một trở ngại trong hành động, chúng tôi nghĩ rằng nó là một tiền đề không thể thiếu cho bất kỳ hành động khôn ngoan nào.” \\n— Pericles trong Bài điếu văn cho những người Athens đã chết trong năm đầu tiên của cuộc chiến (Thucydides, “Lịch sử chiến tranh Peloponnesian”, II. 40.2)"

#: gui/text/quotes.txt:133
msgid ""
"“We alone do not think that a man ignorant of politics interferes with "
"nothing, we think he is good for nothing.” \\n— Pericles in his Funeral "
"Oration for Athenians that died in the first year of the war (Thucydides, "
"“History of the Peloponnesian War”, II. 40.2)"
msgstr "“Chỉ mình chúng ta không nghĩ rằng một người đàn ông không hiểu biết về chính trị không can thiệp vào bất cứ điều gì, chúng ta nghĩ anh ta không có giá trị gì cả.” \\n— Pericles trong Bài điếu văn cho những người Athens đã chết trong năm đầu tiên của cuộc chiến (Thucydides, “Lịch sử chiến tranh Peloponnesian”, II. 40.2)"

#: gui/text/quotes.txt:134
msgid ""
"“Future ages will wonder at us, as the present age wonders at us now.” \\n— "
"Pericles in his Funeral Oration for Athenians that died in the first year of"
" the war (Thucydides, “History of the Peloponnesian War”, II. 41.5)"
msgstr "“Các thế hệ tương lai sẽ kinh ngạc về chúng ta, giống như thế hệ hiện tại đang kinh ngạc về chúng ta bây giờ.” \\n— Pericles trong Bài điếu văn cho những người Athens đã chết trong năm đầu tiên của cuộc chiến (Thucydides, “Lịch sử chiến tranh Peloponnesian”, II. 41.5)"

#: gui/text/quotes.txt:135
msgid ""
"“When you realize the power of Athens, consider it was won by valiant men "
"who knew their duty, had a sense of dishonor in fight and, if their "
"enterprises failed, would rather give their lives than lack in civic "
"virtue.” \\n— Pericles in his Funeral Oration for Athenians that died in the"
" first year of the war (Thucydides, “History of the Peloponnesian War”, II. "
"43.2)"
msgstr "“Khi bạn nhận ra sức mạnh của Athens, hãy xem xét nó được giành bởi những người đàn ông dũng cảm biết bổn phận của mình, có ý thức về sự hổ thẹn trong chiến đấu và, nếu công việc của họ thất bại, thà hy sinh tính mạng còn hơn thiếu đức tính công dân.” \\n— Pericles trong Bài điếu văn cho những người Athens đã chết trong năm đầu tiên của cuộc chiến (Thucydides, “Lịch sử chiến tranh Peloponnesian”, II. 43.2)"

#: gui/text/quotes.txt:136
msgid ""
"“To heroes all earth is their tomb, and their virtues are remembered far "
"from home where an epitaph declares them, in an unwritten record of the mind"
" that will outlast any monument.” \\n— Pericles in his Funeral Oration for "
"Athenians that died in the first year of the war (Thucydides, “History of "
"the Peloponnesian War”, II. 43.3)"
msgstr "“Đối với các anh hùng, toàn bộ trái đất là nấm mồ của họ, và những đức tính của họ được nhớ đến xa nhà nơi một tấm bia khắc tuyên bố họ, trong một bản ghi không thành văn của tâm trí sẽ tồn tại lâu hơn bất kỳ tượng đài nào.” \\n— Pericles trong Bài điếu văn cho những người Athens đã chết trong năm đầu tiên của cuộc chiến (Thucydides, “Lịch sử chiến tranh Peloponnesian”, II. 43.3)"

#: gui/text/quotes.txt:137
msgid ""
"“Understand that happiness depends on freedom, and freedom depends on "
"courage.” \\n— Pericles in his Funeral Oration for Athenians that died in "
"the first year of the war (Thucydides, “History of the Peloponnesian War”, "
"II. 43.4)"
msgstr "“Hãy hiểu rằng hạnh phúc phụ thuộc vào tự do, và tự do phụ thuộc vào lòng dũng cảm.” \\n— Pericles trong Bài điếu văn cho những người Athens đã chết trong năm đầu tiên của cuộc chiến (Thucydides, “Lịch sử chiến tranh Peloponnesian”, II. 43.4)"

#: gui/text/quotes.txt:138
msgid ""
"“Wait for the wisest of all counsellors, time.” \\n— Pericles, a cautious "
"politician who avoided war (Plutarch, “Parallel Lives”, “Pericles”, sec. 18)"
msgstr "“Hãy chờ đợi người khôn ngoan nhất trong số các cố vấn, thời gian.” \\n— Pericles, một chính trị gia thận trọng, người đã tránh chiến tranh (Plutarch, “Cuộc đời song song”, “Pericles”, mục 18)"

#: gui/text/quotes.txt:139
msgid ""
"“Your empire is now like a tyranny: it may have been wrong to take it; it is"
" certainly dangerous to let it go.” \\n— Pericles, addressing the Athenian "
"assembly after a plague had weakened the city (Thucydides, “History of the "
"Peloponnesian War”, II. 63.3)"
msgstr "“Đế chế của bạn giờ đây giống như một chế độ chuyên chế: có thể đã sai khi giành lấy nó; chắc chắn là nguy hiểm nếu để nó ra đi.” \\n— Pericles, phát biểu trước hội đồng Athens sau khi một bệnh dịch đã làm suy yếu thành phố (Thucydides, “Lịch sử chiến tranh Peloponnesian”, II. 63.3)"

#: gui/text/quotes.txt:140
msgid ""
"“War is sweet to those who have no experience of it, but the experienced man"
" fears its approach in his heart.” \\n— Pindar (fragment 110)"
msgstr "“Chiến tranh ngọt ngào đối với những người chưa có kinh nghiệm, nhưng người có kinh nghiệm lại sợ nó đến trong lòng.” \\n— Pindar (mảnh 110)"

#: gui/text/quotes.txt:141
msgid ""
"“Themistocles robbed his fellow citizens of spear and shield, and degraded "
"the people of Athens to the rowing-pad and the oar.” \\n— Plato, no friend "
"of the Athenian navy (Plutarch, “Parallel Lives”, “Themistocles”, sec. 3)"
msgstr "“Themistocles đã cướp giáo và khiên của đồng bào mình, và làm suy thoái người dân Athens xuống mức chèo thuyền và mái chèo.” \\n— Plato, không phải là bạn của hải quân Athens (Plutarch, “Cuộc đời song song”, “Themistocles”, mục 3)"

#: gui/text/quotes.txt:142
msgid ""
"“No guest is so welcome in a friend's house that he will not become a "
"nuisance after three days.” \\n— Plautus (“The Swaggering Soldier”, Act III,"
" scene 1, 146)"
msgstr "“Không có vị khách nào được chào đón ở nhà bạn bè đến nỗi anh ta sẽ không trở thành một sự phiền toái sau ba ngày.” \\n— Plautus (“Người lính kiêu ngạo”, Màn III, cảnh 1, 146)"

#: gui/text/quotes.txt:143
msgid ""
"“If you spend a thing you cannot have it too.”\\n— Plautus (“Trinummus”, Act"
" II, scene 4, 13–14)"
msgstr "“Nếu bạn đã tiêu một thứ, bạn sẽ không thể có lại nó.” \\n— Plautus (“Trinummus”, Màn II, cảnh 4, 13–14)"

#: gui/text/quotes.txt:144
msgid ""
"“He \\[Alexander] thought nothing invincible for the courageous, and nothing"
" secure for the cowardly.” \\n— Plutarch (“Parallel Lives”, “Alexander”, "
"sec. 58)"
msgstr "“Ông ấy \\[Alexander] cho rằng không có gì là không thể đánh bại đối với người dũng cảm, và không có gì là an toàn đối với người hèn nhát.” \\n— Plutarch (“Cuộc đời song song”, “Alexander”, mục 58)"

#: gui/text/quotes.txt:145
msgid ""
"“One \\[…] shot an arrow at him with such accuracy and force that it pierced"
" his breastplate and got stuck in his ribs. \\[…] Alexander recoiled and "
"sank to his knees. \\[…] At last Alexander killed the barbarian. But he "
"received many wounds, at last was struck on the neck with a mace, and leaned"
" against the city wall, his eyes still fixed upon his foes.” \\n— Plutarch "
"about the Mallian Campaign (“Parallel Lives”, “Alexander”, sec. 63)"
msgstr "“Một người \\[…] đã bắn một mũi tên vào ông ấy với độ chính xác và lực mạnh đến mức nó xuyên qua áo giáp và mắc kẹt vào xương sườn của ông. \\[…] Alexander lùi lại và quỵ xuống. \\[…] Cuối cùng Alexander đã giết chết người man rợ đó. Nhưng ông đã nhận nhiều vết thương, cuối cùng bị đánh vào cổ bằng một cây chùy, và dựa vào bức tường thành, đôi mắt vẫn nhìn chằm chằm vào kẻ thù.” \\n— Plutarch kể về Chiến dịch Mallian (“Cuộc đời song song”, “Alexander”, mục 63)"

#: gui/text/quotes.txt:146
msgid ""
"“When the pirates demanded a ransom of twenty talents for him, Caesar burst "
"out laughing. They did not know, he said, who it was that they had captured,"
" and he volunteered to pay fifty.” \\n— Plutarch, who mentions later that "
"Caesar got his money back and had his captors crucified (“Parallel Lives”, "
"“Caesar”, sec. 2)"
msgstr "“Khi những tên cướp biển đòi tiền chuộc hai mươi talent cho ông, Caesar bật cười. Ông nói, chúng không biết chúng đã bắt được ai, và ông tình nguyện trả năm mươi.” \\n— Plutarch, người sau đó nhắc đến việc Caesar đã lấy lại tiền của mình và đóng đinh những kẻ bắt giữ ông (“Cuộc đời song song”, “Caesar”, mục 2)"

#: gui/text/quotes.txt:147
msgid ""
"“They \\[the Romans] want the centurions not so much to be adventurous and "
"daredevils, as to be natural leaders, of a steady and reliable spirit. They "
"do not so much want men who will initiate attacks and open the battle, but "
"men who will hold their ground when beaten and hard-pressed, and will be "
"ready to die at their posts.” \\n— Polybius (“Histories”, VI. 24)"
msgstr "“Họ \\[người La Mã] muốn các đội trưởng không quá phiêu lưu và liều lĩnh, mà là những nhà lãnh đạo tự nhiên, có tinh thần vững vàng và đáng tin cậy. Họ không quá muốn những người sẽ khởi xướng các cuộc tấn công và mở đầu trận chiến, mà là những người sẽ giữ vững vị trí khi bị đánh bại và bị áp lực nặng nề, và sẽ sẵn sàng chết tại vị trí của họ.” \\n— Polybius (“Lịch sử”, VI. 24)"

#: gui/text/quotes.txt:148
msgid ""
"“The Roman battle line is hard to break, since it allows every man to fight "
"both individually and collectively; so that a formation can fight in any "
"direction, with the maniples nearest to the point of danger wheeling around "
"to face it.” \\n— Polybius (“Histories”, XV. 15)"
msgstr "“Hàng ngũ chiến đấu của người La Mã rất khó bị phá vỡ, vì nó cho phép mỗi người chiến đấu cả cá nhân và tập thể; để một đội hình có thể chiến đấu theo bất kỳ hướng nào, với các nhóm quân gần điểm nguy hiểm nhất sẽ quay vòng để đối mặt với nó.” \\n— Polybius (“Lịch sử”, XV. 15)"

#: gui/text/quotes.txt:149
msgid ""
"“The Athenian people are always in the position of a ship without a "
"commander. Fear of the enemy or a storm make the crew be of one mind and "
"obey the helmsman, everything goes well; but if they recover \\[…] they "
"quarrel with each other \\[…], and the result has often been that, after "
"escaping the dangers of the widest seas and the most violent storms, they "
"wreck their ship in harbor and close to shore.” \\n— Polybius on the "
"Athenian constitution (“Histories”, VI. 44)"
msgstr "“Người dân Athens luôn ở vị trí của một con tàu không có chỉ huy. Nỗi sợ hãi kẻ thù hoặc một cơn bão khiến thủy thủ đoàn đồng lòng và tuân lệnh người lái tàu, mọi thứ đều tốt đẹp; nhưng nếu họ phục hồi \\[…] họ cãi vã lẫn nhau \\[…], và kết quả thường là, sau khi thoát khỏi những nguy hiểm của những vùng biển rộng nhất và những cơn bão dữ dội nhất, họ đâm tàu của mình vào bến cảng và gần bờ.” \\n— Polybius về hiến pháp Athens (“Lịch sử”, VI. 44)"

#: gui/text/quotes.txt:150
msgid ""
"“Most of the Romans were trampled to death by the enormous weight of the "
"elephants; the rest were shot down in their ranks by the numerous cavalry: "
"and there were only a very few who attempted to save themselves by flight.” "
"\\n— Polybius on the Battle of Bagradas where a Roman army was annihilated "
"during the First Punic War (“Histories”, I. 34)"
msgstr "“Hầu hết người La Mã bị giẫm đạp đến chết bởi trọng lượng khổng lồ của những con voi; số còn lại bị bắn hạ trong hàng ngũ bởi số lượng lớn kỵ binh: và chỉ có rất ít người cố gắng tự cứu mình bằng cách bỏ chạy.” \\n— Polybius về Trận chiến Bagradas nơi một đội quân La Mã bị tiêu diệt trong Chiến tranh Punic lần thứ nhất (“Lịch sử”, I. 34)"

#: gui/text/quotes.txt:151
msgid ""
"“Hannibal gave the signal for attack; and at the same time sent orders to "
"the troops lying in ambush on the hills to do the same, and thus delivered "
"an assault upon the enemy at every point at once.” \\n— Polybius on the "
"beginning of a Roman disaster at the Trasymene Lake (“Histories”, III. 84)"
msgstr "“Hannibal ra hiệu lệnh tấn công; và đồng thời ra lệnh cho quân đội đang mai phục trên đồi cũng làm tương tự, và như vậy đã tấn công kẻ thù ở mọi điểm cùng một lúc.” \\n— Polybius về khởi đầu của một thảm họa La Mã tại Hồ Trasymene (“Lịch sử”, III. 84)"

#: gui/text/quotes.txt:152
msgid ""
"“In the phalanx, the men cannot turn around singly and defend themselves: "
"this tribune, therefore, charged them \\[from behind] and killed all he "
"could get at; until, unable to resist, they were forced to throw away their "
"shields and flee.” \\n— Polybius, describing the defeat of Philip V. of "
"Macedon by Flaminius in the Battle of Cynoscephalae (“Histories”, XVIII. 26)"
msgstr "“Trong đội hình phalanx, những người lính không thể xoay người một mình để tự vệ: vì vậy, viên quan bảo dân này đã tấn công họ \\[từ phía sau] và giết bất kỳ ai mà ông ta có thể tiếp cận; cho đến khi, không thể chống cự, họ buộc phải vứt bỏ khiên và bỏ chạy.” — Polybius, mô tả thất bại của Philip V của Macedonia dưới tay Flaminius trong Trận Cynoscephalae (“Lịch sử”, XVIII. 26)"

#: gui/text/quotes.txt:153
msgid ""
"“The Roman order on the other hand is flexible: for every Roman, once armed "
"and on the field, is equally well equipped for every place, time, or "
"appearance of the enemy. He is, moreover, quite ready and needs to make no "
"change, whether he is required to fight in the main body, or in a "
"detachment, or in a single maniple, or even by himself.” \\n— Polybius, "
"explaining how the Romans can defeat the Macedonian phalanx (“Histories”, "
"XVIII. 32)"
msgstr "“Trật tự của người La Mã, mặt khác, lại rất linh hoạt: bởi vì mỗi người La Mã, một khi được vũ trang và trên chiến trường, đều được trang bị tốt như nhau cho mọi địa điểm, thời gian, hay sự xuất hiện của kẻ thù. Hơn nữa, anh ta hoàn toàn sẵn sàng và không cần thay đổi gì, dù được yêu cầu chiến đấu trong đội hình chính, hay trong một phân đội, hay trong một quân đoàn nhỏ, hoặc thậm chí là một mình.” — Polybius, giải thích cách người La Mã có thể đánh bại đội hình Phalanx của Macedonia (“Lịch sử”, XVIII. 32)"

#: gui/text/quotes.txt:154
msgid ""
"“Scipio \\[Aemilianus], when he looked upon the city \\[Carthage] as it was "
"utterly perishing and in the last throes of its complete destruction, is "
"said to have shed tears and wept openly for his enemies. And realized that "
"all cities, nations, and authorities must, like men, meet their doom.” \\n— "
"Polybius, eyewitness to the destruction of Carthage (“Histories”, XXXVIII. "
"22)"
msgstr "Scipio \\[Aemilianus], khi nhìn thành phố \\[Carthage] hoàn toàn bị hủy diệt và đang hấp hối trong sự tàn phá hoàn toàn, được kể lại là đã rơi nước mắt và khóc công khai cho kẻ thù của mình. Và nhận ra rằng tất cả các thành phố, quốc gia, và chính quyền, giống như con người, đều phải đối mặt với số phận của mình.” — Polybius, nhân chứng của sự hủy diệt Carthage (“Lịch sử”, XXXVIII. 22)"

#: gui/text/quotes.txt:155
msgid ""
"“One more such victory and the cause is lost!” \\n— Pyrrhus of Epirus after "
"the Battle of Asculum, in which the Romans lost twice as many men but he "
"lost a greater share of his armed forces (Plutarch, “Parallel Lives”, "
"“Pyrrhus”, sec. 21)"
msgstr "“Thêm một chiến thắng như vậy và lý do đã mất!” — Pyrrhus của Epirus sau Trận Asculum, trong đó người La Mã mất số binh sĩ gấp đôi nhưng ông lại mất một phần lớn hơn lực lượng vũ trang của mình (Plutarch, “Cuộc Đời Song Song”, “Pyrrhus”, sec. 21)"

#: gui/text/quotes.txt:156
msgid ""
"“None can be free who is a slave to, and ruled by, his passions.” \\n— "
"Pythagoras (Stobaeus, “Florilegium”, 18)"
msgstr "“Không ai có thể tự do khi là nô lệ và bị cai trị bởi dục vọng của mình.” — Pythagoras (Stobaeus, “Tuyển tập”, 18)"

#: gui/text/quotes.txt:157
msgid ""
"“Do not say few things in many words, but many things in few words.” \\n— "
"Pythagoras (Stobaeus, “Florilegium”, 24)"
msgstr "“Đừng nói ít điều bằng nhiều lời, mà hãy nói nhiều điều bằng ít lời.” — Pythagoras (Stobaeus, “Tuyển tập”, 24)"

#: gui/text/quotes.txt:158
msgid ""
"“Let your speech be better than silence, or be silent.” \\n— Pythagoras "
"(Stobaeus, “Florilegium”, 24)"
msgstr "“Hãy để lời nói của bạn tốt hơn sự im lặng, hoặc hãy im lặng.” — Pythagoras (Stobaeus, “Tuyển tập”, 24)"

#: gui/text/quotes.txt:159
msgid ""
"“Unity strengthens even small states, while discord undermines the mightiest"
" empires.” \\n— Sallust (“The Jugurthine War”, 10.6)"
msgstr "“Đoàn kết củng cố ngay cả những quốc gia nhỏ, trong khi bất hòa làm suy yếu các đế chế hùng mạnh nhất.” — Sallust (“Chiến tranh Jugurthine”, 10.6)"

#: gui/text/quotes.txt:160
msgid ""
"“Ungrateful fatherland, you will not even have my bones!” \\n— Scipio "
"Africanus in his epitaph, after he who defeated Hannibal was repeatedly "
"accused of crimes by the Roman Senate (Valerius Maximus, “Nine books on "
"memorable deeds and sayings”, 5.3.2)"
msgstr "“Quê hương bạc bẽo, mi sẽ không có cả xương cốt của ta!” — Scipio Africanus trong bia mộ của mình, sau khi ông, người đã đánh bại Hannibal, bị Thượng viện La Mã nhiều lần buộc tội (Valerius Maximus, “Chín cuốn sách về những việc làm và câu nói đáng nhớ”, 5.3.2)"

#: gui/text/quotes.txt:161
msgid ""
"“Prepare for war, since you have been unable to endure a peace.” \\n— Scipio"
" Africanus, replying to Hannibal's offer of peace terms before the Battle of"
" Zama (Livy, “History of Rome”, XXX. 31)"
msgstr "“Hãy chuẩn bị cho chiến tranh, vì các ngươi đã không thể chịu đựng được hòa bình.” — Scipio Africanus, đáp lời đề nghị hòa bình của Hannibal trước Trận Zama (Livy, “Lịch sử La Mã”, XXX. 31)"

#: gui/text/quotes.txt:162
msgid ""
"“But tactical science is only one part of generalship. A general must be "
"capable of equipping his forces and providing for his men. He must also be "
"inventive, hardworking, and watchful, bullheaded and brilliant, friendly and"
" fierce, straightforward and subtle.” \\n— Socrates (Xenophon, "
"“Memorabilia”, 3.1.6)"
msgstr "“Nhưng khoa học chiến thuật chỉ là một phần của tài năng chỉ huy. Một tướng lĩnh phải có khả năng trang bị lực lượng và cung cấp cho binh sĩ của mình. Ông ta cũng phải có óc sáng tạo, siêng năng và cảnh giác, cứng đầu và xuất chúng, thân thiện và hung dữ, thẳng thắn và khéo léo.” — Socrates (Xenophon, “Hồi ức”, 3.1.6)"

#: gui/text/quotes.txt:163
msgid ""
"“It is necessary to know the strength of the city and of the enemy, so that,"
" if the city is stronger, one may recommend her to go to war, but if weaker "
"than the enemy, may persuade her to beware.” \\n— Socrates (Xenophon, "
"“Memorabilia”, 3.6.9)"
msgstr "“Cần phải biết sức mạnh của thành phố và của kẻ thù, để nếu thành phố mạnh hơn, người ta có thể khuyến nghị cô ấy đi chiến tranh, nhưng nếu yếu hơn kẻ thù, có thể thuyết phục cô ấy phải cảnh giác.” — Socrates (Xenophon, “Hồi ức”, 3.6.9)"

#: gui/text/quotes.txt:164
msgid ""
"“The unexamined life is not worth living.” Socrates, in his defense when "
"trialled for corrupting the youth and not worshipping the proper gods (he "
"later drank hemlock after the death sentence) \\n— Plato (“Apology”, 38a)"
msgstr "“Cuộc sống không được xem xét thì không đáng sống.” — Socrates, trong lời biện hộ khi bị xét xử vì làm bại hoại giới trẻ và không thờ phụng các vị thần chính đáng (sau này ông uống độc dược sau án tử hình) — Plato (“Biện giải”, 38a)"

#: gui/text/quotes.txt:165
msgid ""
"“The hour of departure has arrived, and we go our ways – I to die, and you "
"to live. Which is better God only knows.” Socrates, in his defense when "
"trialled for corrupting the youth and not worshipping the proper gods (he "
"later drank hemlock after the death sentence) \\n— Plato (“Apology”, 42a)"
msgstr "“Giờ chia ly đã đến, và chúng ta đi con đường của mình – tôi để chết, còn các bạn để sống. Điều nào tốt hơn chỉ có Chúa mới biết.” — Socrates, trong lời biện hộ khi bị xét xử vì làm bại hoại giới trẻ và không thờ phụng các vị thần chính đáng (sau này ông uống độc dược sau án tử hình) — Plato (“Biện giải”, 42a)"

#: gui/text/quotes.txt:166
msgid ""
"“Walls and ships are nothing without men living together inside them.” \\n— "
"Sophocles (“Oedipus Rex”)"
msgstr "“Tường thành và tàu thuyền chẳng là gì nếu không có con người chung sống bên trong chúng.” — Sophocles (“Oedipus Vương”)"

#: gui/text/quotes.txt:167
msgid ""
"“We accepted an empire that was offered to us and refused to give it up "
"under the pressure of three of the strongest motives: fear, honor and "
"interest. It was not we who set the example, for it has always been the law "
"that the weak should be subject to the strong.” \\n— Speech of an Athenian "
"embassy in Sparta (Thucydides, “History of the Peloponnesian War”, I. 76.2)"
msgstr "“Chúng tôi chấp nhận một đế chế được trao cho chúng tôi và từ chối từ bỏ nó dưới áp lực của ba động lực mạnh mẽ nhất: sợ hãi, danh dự và lợi ích. Không phải chúng tôi đặt ra tiền lệ, vì luật pháp luôn là kẻ yếu phải phục tùng kẻ mạnh.” — Bài phát biểu của phái đoàn Athenian tại Sparta (Thucydides, “Lịch sử Chiến tranh Peloponnesus”, I. 76.2)"

#: gui/text/quotes.txt:168
msgid ""
"“He could boast that he found a city of brick and left it a city of "
"marble.”\\n— Suetonius, commenting on the many building projects of Augustus"
" in Rome (“Divus Augustus”, 28.3)"
msgstr "“Ông ta có thể tự hào rằng đã tìm thấy một thành phố gạch và để lại đó là một thành phố đá cẩm thạch.” — Suetonius, nhận xét về nhiều dự án xây dựng của Augustus ở Rome (“Divus Augustus”, 28.3)"

#: gui/text/quotes.txt:169
msgid "“Moderation in all things.” \\n— Terence (“The Girl from Andros”, 61)"
msgstr "“Điều độ trong mọi việc.” — Terence (“Cô Gái đến từ Andros”, 61)"

#: gui/text/quotes.txt:170
msgid ""
"“Fortune favors the bold.” \\n— Terence in a play about a great Athenian "
"admiral (“Phormio”, 203)"
msgstr "“Tôi không biết cách lên dây đàn lia hay chơi đàn hạc, nhưng tôi biết cách nâng một thành phố nhỏ bé và không quan trọng lên đến vinh quang và vĩ đại.” — Themistocles, biện hộ cho sự thiếu tinh tế văn hóa của mình (Plutarch, “Cuộc Đời Song Song”, “Themistocles”, sec. 203)"

#: gui/text/quotes.txt:171
msgid ""
"“I do not know how to tune the lyre or play the harp, but I do know how to "
"raise a city that was small and unimportant to glory and greatness.” \\n— "
"Themistocles, defending his lack of cultural sophistication (Plutarch, "
"“Parallel Lives”, “Themistocles”, sec. 2)"
msgstr "\"Tôi không biết chơi đàn lia hay đàn hạc, nhưng tôi biết cách nâng tầm một thành phố nhỏ bé, vô danh trở nên vinh quang và vĩ đại.\" — Themistocles, khi biện minh cho sự thiếu tinh tế trong văn hóa của mình (Plutarch, “Parallel Lives”, “Themistocles”, mục 2)"

#: gui/text/quotes.txt:172
msgid ""
"“Strike, if you will, but listen.” \\n— Themistocles, in a heated discussion"
" with the Spartan fleet commander who threatened to beat him with his staff,"
" before the Battle of Salamis (Plutarch, “Parallel Lives”, “Themistocles”, "
"sec. 11)"
msgstr "\"Cứ đánh đi nếu muốn, nhưng hãy lắng nghe đã.\" — Themistocles, trong một cuộc tranh luận nảy lửa với chỉ huy hạm đội Sparta, người đã dọa đánh ông bằng gậy, trước Trận Salamis (Plutarch, “Parallel Lives”, “Themistocles”, mục 11)"

#: gui/text/quotes.txt:173
msgid ""
"“The Athenians command the rest of Greece, I command the Athenians; your "
"mother commands me, and you command your mother.” \\n— Themistocles, "
"jokingly to his infant son (Plutarch, “Parallel Lives”, “Themistocles”, sec."
" 18)"
msgstr "\"Người Athens chỉ huy phần còn lại của Hy Lạp, tôi chỉ huy người Athens; mẹ con chỉ huy tôi, và con thì chỉ huy mẹ con.\"\n— Themistocles, nói đùa với con trai sơ sinh của mình (Plutarch, “Parallel Lives”, “Themistocles”, mục 18)"

#: gui/text/quotes.txt:174
msgid ""
"“So little pains does the mob take in finding out the truth, accepting "
"readily the first story at hand.” \\n— Thucydides (“History of the "
"Peloponnesian War”, I. 21.3)"
msgstr "\"Đám đông ít khi bỏ công sức tìm kiếm sự thật, sẵn sàng chấp nhận ngay câu chuyện đầu tiên có được.\" — Thucydides (“History of the Peloponnesian War”, I. 21.3)"

#: gui/text/quotes.txt:175
msgid ""
"“The growth of the power of Athens, and the alarm which this caused in "
"Sparta, made war inevitable.” \\n— Thucydides (“History of the Peloponnesian"
" War”, I. 23.6)"
msgstr "\"Sự lớn mạnh của quyền lực Athens, và sự lo ngại mà điều này gây ra ở Sparta, đã khiến chiến tranh trở nên không thể tránh khỏi.\" — Thucydides (“History of the Peloponnesian War”, I. 23.6)"

#: gui/text/quotes.txt:176
msgid ""
"“War is a matter not so much of arms as of money.” \\n— Thucydides (“History"
" of the Peloponnesian War”, I. 83.2)"
msgstr "\"Chiến tranh không phải là chuyện của vũ khí nhiều bằng chuyện của tiền bạc.\" — Thucydides (“History of the Peloponnesian War”, I. 83.2)"

#: gui/text/quotes.txt:177
msgid ""
"“It is a general rule of human nature that people despise those who treat "
"them well, and look up to those who make no concessions.” \\n— Thucydides "
"(“History of the Peloponnesian War”, III. 39.5)"
msgstr "\"Đó là quy luật chung của bản chất con người: người ta khinh thường những ai đối xử tốt với họ, và ngưỡng mộ những ai không nhượng bộ.\" — Thucydides (“History of the Peloponnesian War”, III. 39.5)"

#: gui/text/quotes.txt:178
msgid ""
"“This was the greatest action that happened in all this war, and all others "
"that we have heard of amongst the Greeks, being to the victors most glorious"
" and most calamitous to the vanquished. For they were utterly and at all "
"points defeated, and their sufferings were many. Army and fleet and all they"
" ever had perished, nothing was saved and few of so many ever returned home."
" Thus ended the Sicilian expedition.” \\n— Thucydides (“History of the "
"Peloponnesian War”, VII. 87.6–7)"
msgstr "\"Đây là trận chiến vĩ đại nhất đã xảy ra trong toàn bộ cuộc chiến này, và tất cả những trận chiến khác mà chúng ta từng nghe đến giữa người Hy Lạp, mang lại vinh quang tột đỉnh cho những người chiến thắng và tai họa khủng khiếp nhất cho những kẻ bại trận. Vì họ đã bị đánh bại hoàn toàn và trên mọi phương diện, và những đau khổ của họ là vô vàn. Quân đội, hạm đội và tất cả những gì họ từng có đều bị hủy diệt, không gì được cứu vãn và rất ít trong số họ trở về nhà. Cuộc viễn chinh Sicily kết thúc như vậy.\" — Thucydides (“History of the Peloponnesian War”, VII. 87.6–7)"

#: gui/text/quotes.txt:179
msgid ""
"“As the world goes, justice is only a matter between equals, while the "
"strong do what they can and the weak suffer what they must.” \\n— "
"Thucydides, describing Athenians addressing the defeated Melians who are "
"unwilling to surrender (“History of the Peloponnesian War”, V. 89.1)"
msgstr "\"Như thế giới này vận hành, công lý chỉ là chuyện giữa những kẻ ngang hàng, còn kẻ mạnh làm được gì thì làm, kẻ yếu phải chịu đựng những gì họ buộc phải chịu.\" — Thucydides, mô tả người Athens nói chuyện với người Melos bại trận nhưng không chịu đầu hàng (“History of the Peloponnesian War”, V. 89.1)"

#: gui/text/quotes.txt:180
msgid ""
"“When the Lacedaemonians were no longer able to run after them, the "
"skirmishers \\[…] all charged them at once, casting stones, arrows, and "
"darts to the closest man at hand.” \\n— Thucydides, describing the Spartan "
"disaster at the Battle of Sphacteria (“History of the Peloponnesian War”, "
"IV. 34.2)"
msgstr "\"Khi người Lacedaemonia không còn có thể đuổi theo họ nữa, những lính đánh thuê \\[…] tất cả đồng loạt xông lên, ném đá, bắn cung và phóng lao vào người gần nhất.\" \\n— Thucydides, mô tả thảm họa của Sparta tại Trận Sphacteria (“History of the Peloponnesian War”, IV. 34.2)"

#: gui/text/quotes.txt:181
msgid ""
"“The wild beasts of Italy have their caves to retire to, but the brave "
"veterans who spilled their blood in her cause have nothing left but air and "
"light. They wander around homeless with their wives and children.”\\n— "
"Tiberius Gracchus, advocating for land reform to the benefit of homeless and"
" unemployed veterans whose lands had often been bought up while they were on"
" campaign. (Plutarch, “Parallel Lives”, “Tiberius Gracchus”, 9.4–5)"
msgstr "\"Những con thú hoang dã của Ý có hang động để ẩn náu, nhưng những cựu binh dũng cảm đã đổ máu vì đất nước này không còn gì ngoài không khí và ánh sáng. Họ lang thang vô gia cư cùng vợ con mình.\" — Tiberius Gracchus, ủng hộ cải cách ruộng đất vì lợi ích của các cựu binh vô gia cư và thất nghiệp, những người thường bị mua mất đất đai khi họ đi chiến dịch. (Plutarch, “Parallel Lives”, “Tiberius Gracchus”, 9.4–5)"

#: gui/text/quotes.txt:182
msgid ""
"“The soldiers fight and die to support others in wealth and luxury and they "
"are called masters of the world without owning a single piece of farmland of"
" their own.”\\n— Tiberius Gracchus, advocating for land reform to the "
"benefit of homeless and unemployed veterans whose lands had often been "
"bought up while they were on campaign. (Plutarch, “Parallel Lives”, "
"“Tiberius Gracchus”, 9.5)"
msgstr "\"Những người lính chiến đấu và hy sinh để hỗ trợ những người khác trong giàu có và xa hoa, và họ được gọi là chủ nhân của thế giới mà không sở hữu một mảnh đất nông nghiệp nào của riêng mình.\" — Tiberius Gracchus, ủng hộ cải cách ruộng đất vì lợi ích của các cựu binh vô gia cư và thất nghiệp, những người thường bị mua mất đất đai khi họ đi chiến dịch. (Plutarch, “Parallel Lives”, “Tiberius Gracchus”, 9.5)"

#: gui/text/quotes.txt:183
msgid ""
"“Do not trust the horse, Trojans! I fear the Greeks even when they bring "
"gifts.” \\n— Virgil (“Aeneid”, II. 48–49)"
msgstr "\"Đừng tin con ngựa, người thành Troy! Tôi e sợ người Hy Lạp ngay cả khi họ mang quà đến.\" — Virgil (“Aeneid”, II. 48–49)"

#: gui/text/quotes.txt:184
msgid "“Prepared for either alternative.” \\n— Virgil (“Aeneid”, II. 61)"
msgstr "\"Sẵn sàng cho cả hai trường hợp.\" — Virgil (“Aeneid”, II. 61)"

#: gui/text/quotes.txt:185
msgid ""
"“Homer and Hesiod ascribed to their Gods all things that are a disgrace "
"among mortals: stealing, adultery, deceiving one another.” \\n— Xenophanes "
"(fragment 11)"
msgstr "\"Homer và Hesiod đã gán cho các vị thần của họ tất cả những điều đáng hổ thẹn giữa những người trần tục: trộm cắp, ngoại tình, lừa dối lẫn nhau.\" — Xenophanes (fragment 11)"

#: gui/text/quotes.txt:186
msgid ""
"“If oxen and horses and lions had hands, and could paint, and produce works "
"of art as men do, horses would paint the forms of the gods like horses, and "
"oxen like oxen, and make their God's bodies each in their own image.” \\n— "
"Xenophanes (fragment 15)"
msgstr "\"Nếu bò, ngựa và sư tử có tay, và có thể vẽ, và tạo ra các tác phẩm nghệ thuật như con người, thì ngựa sẽ vẽ hình dạng của các vị thần giống ngựa, và bò giống bò, và tạo ra cơ thể Thần của chúng theo hình ảnh của chính chúng.\" — Xenophanes (fragment 15)"

#: gui/text/quotes.txt:187
msgid ""
"“The Ethiopians make their gods black and snub-nosed, the Thracians say "
"theirs have blue eyes and red hair.” \\n— Xenophanes (fragment 16)"
msgstr "\"Người Ethiopia làm cho các vị thần của họ đen và mũi tẹt, người Thracians nói rằng các vị thần của họ có mắt xanh và tóc đỏ.\" — Xenophanes (fragment 16)"

#: gui/text/quotes.txt:188
msgid ""
"“These are the right questions to ask, in winter around the fire \\[…]: Who "
"are you, friend? What is your land? And how old were you when the Medes "
"\\[Persians] came?” \\n— Xenophanes, likely referring to a punitive "
"expedition against Greek cities in Ionia (fragment 17)"
msgstr "\"Đây là những câu hỏi đúng để hỏi, vào mùa đông quanh đống lửa \\[…]: Bạn là ai, bạn của tôi? Đất của bạn ở đâu? Và bạn bao nhiêu tuổi khi người Medes \\[người Ba Tư] đến?\" — Xenophanes, có thể đề cập đến một cuộc viễn chinh trừng phạt chống lại các thành phố Hy Lạp ở Ionia (fragment 17)"

#: gui/text/quotes.txt:189
msgid ""
"“A prudent commander will never take risks unnecessarily, except when it is "
"clear beforehand that he will have the advantage.” \\n— Xenophon (“The "
"Cavalry General”, 4.13)"
msgstr "\"Một chỉ huy thận trọng sẽ không bao giờ mạo hiểm một cách không cần thiết, trừ khi đã rõ ràng trước rằng anh ta sẽ có lợi thế.\" — Xenophon (“The Cavalry General”, 4.13)"

#: gui/text/quotes.txt:190
msgid ""
"“Attack the enemy where he is weakest, even if that is a long way off, since"
" hard work is less dangerous than a struggle against superior forces.” \\n— "
"Xenophon (“The Cavalry General”, sec. 4.14)"
msgstr "\"Tấn công kẻ thù ở điểm yếu nhất của hắn, ngay cả khi điểm đó ở rất xa, vì công việc khó khăn ít nguy hiểm hơn là một cuộc đấu tranh chống lại lực lượng vượt trội.\" — Xenophon (“The Cavalry General”, sec. 4.14)"

#: gui/text/quotes.txt:191
msgid ""
"“He should be inventive, ready to exploit all circumstances, to make a small"
" force appear large and a large one small, to appear absent when close at "
"hand, and within striking distance when a long way off.” \\n— Xenophon (“The"
" Cavalry General”, sec. 5)"
msgstr "\"Anh ta phải sáng tạo, sẵn sàng tận dụng mọi hoàn cảnh, để làm cho một lực lượng nhỏ trông có vẻ lớn và một lực lượng lớn trông có vẻ nhỏ, để xuất hiện vắng mặt khi ở gần, và trong tầm tấn công khi ở rất xa.\" — Xenophon (“The Cavalry General”, sec. 5)"

#: gui/text/quotes.txt:192
msgid ""
"“People are glad to obey the man whom they believe to be wiser than "
"themselves in pursuing their interests.” \\n— Xenophon (“The Education of "
"Cyrus”, 1.6.22)"
msgstr "\"Mọi người sẵn lòng tuân theo người mà họ tin là khôn ngoan hơn chính họ trong việc theo đuổi lợi ích của mình.\" — Xenophon (“The Education of Cyrus”, 1.6.22"

#: gui/text/quotes.txt:193
msgid ""
"“In his campaigns during summer the general must show that he can endure the"
" sun better than the soldiers, in winter he must show he can endure cold "
"better; and throughout all difficulties that he can endure hardships better."
" This will help to make him loved by his men.” \\n— Xenophon (“The Education"
" of Cyrus”, 1.6.25)"
msgstr "\"Trong các chiến dịch mùa hè, vị tướng phải thể hiện rằng anh ta có thể chịu đựng nắng nóng tốt hơn binh lính, vào mùa đông anh ta phải thể hiện anh ta có thể chịu đựng lạnh tốt hơn; và trong mọi khó khăn anh ta phải thể hiện anh ta có thể chịu đựng gian khổ tốt hơn. Điều này sẽ giúp anh ta được binh lính yêu mến.\" — Xenophon (“The Education of Cyrus”, 1.6.25)"

#: gui/text/quotes.txt:194
msgid ""
"“Battles are decided more by the morale of men than their physical "
"strength.” \\n— Xenophon (“The Education of Cyrus”, 3.3.20)"
msgstr "\"Các trận chiến được quyết định nhiều hơn bởi tinh thần của con người hơn là sức mạnh thể chất của họ.\" — Xenophon (“The Education of Cyrus”, 3.3.20)"

#: gui/text/quotes.txt:195
msgid ""
"“Let's not give them enough time to arrange a defense, or to even recognize "
"that we are human beings! We've got to appear to them like an uncontrollable"
" nightmare of shields, swords, battle-axes and spears!” \\n— Xenophon (“The "
"Education of Cyrus”, 4.2.22)"
msgstr "\"Chúng ta đừng cho họ đủ thời gian để sắp xếp phòng thủ, hay thậm chí để nhận ra chúng ta là con người! Chúng ta phải xuất hiện trước mặt họ như một cơn ác mộng không thể kiểm soát của khiên, kiếm, rìu chiến và giáo!\" — Xenophon (“The Education of Cyrus”, 4.2.22)"

#: gui/text/quotes.txt:196
msgid ""
"“I suppose you understand, men, that pursuing, dealing blows and death, "
"plunder, fame, freedom, power – all these are prizes for the winners; the "
"cowardly, of course, suffer the reverse.” \\n— Xenophon (“The Education of "
"Cyrus”, 7.1.13)"
msgstr "\"Tôi cho rằng các bạn hiểu, hỡi những người lính, rằng truy đuổi, ra đòn và cái chết, cướp bóc, danh tiếng, tự do, quyền lực – tất cả những điều này là phần thưởng cho những người chiến thắng; những kẻ hèn nhát, tất nhiên, phải chịu điều ngược lại.\" — Xenophon (“The Education of Cyrus”, 7.1.13)"

#: gui/text/quotes.txt:197
msgid ""
"“The man who wants that must be scheming and cunning, wily and deceitful, a "
"thief and a robber, overreaching the enemy at every point.” \\n— Xenophon on"
" how best to gain advantage over the enemy (“The Education of Cyrus”, "
"1.6.26)"
msgstr "\"Kẻ muốn điều đó phải là kẻ mưu mô và xảo quyệt, ranh mãnh và lừa dối, một tên trộm và một tên cướp, vượt mặt kẻ thù ở mọi điểm.\" — Xenophon về cách tốt nhất để giành lợi thế trước kẻ thù (“The Education of Cyrus”, 1.6.26)"

#: gui/text/quotes.txt:198
msgid ""
"“My men have turned into women, and my women into men!” \\n— Xerxes, "
"watching Artemisia ram a ship while most of his fleet suffered the reverse, "
"not knowing that the sunk vessel was his own (Herodotus, “The Histories”, "
"VIII. 88)"
msgstr "\"Đàn ông của ta đã biến thành đàn bà, và đàn bà của ta đã biến thành đàn ông!\" — Xerxes, khi chứng kiến Artemisia đâm một con tàu trong khi hầu hết hạm đội của ông ta bị ngược lại, mà không biết rằng con tàu bị chìm là của chính mình (Herodotus, “The Histories”, VIII. 88)"

#: gui/text/quotes.txt:199
msgid ""
"“For a thinking man is where Wisdom is at home.” \\n— Zoroaster, founder of "
"the Zoroastrian religion (“Ahunuvaiti Gatha”, yasna 30.9)"
msgstr "\"Bởi vì đối với một người biết suy nghĩ, đó là nơi Trí Tuệ ngự trị.\" — Zoroaster, người sáng lập tôn giáo Zoroastrian (“Ahunuvaiti Gatha”, yasna 30.9)"

#: gui/text/quotes.txt:200
msgid ""
"“Do not, I beg you, disturb that.” \\n— Archimedes to a Roman soldier who "
"was about to kill him while he was studying mathematical figures on the "
"ground (Valerius Maximus, “Memorable Deeds and Sayings” Book VIII, ext. 7)"
msgstr "“Xin đừng, tôi cầu xin ông, đừng làm xáo trộn những thứ đó.” \\n— Archimedes nói với một tên lính La Mã đang định giết ông khi ông đang nghiên cứu các hình toán học trên mặt đất (Valerius Maximus, “Những việc làm và danh ngôn đáng nhớ” Quyển VIII, mục 7)"

#: gui/text/quotes.txt:201
msgid ""
"“It was a greater victory for him to conquer his resentment than to defeat "
"the enemy.” \\n— Marcus Furius Camillus (Livy, “Ab Urbe Condita” Book 21)"
msgstr "“Chiến thắng nỗi oán hận của bản thân còn vĩ đại hơn là đánh bại kẻ thù.” \\n— Marcus Furius Camillus (Livy, “Ab Urbe Condita” Quyển 21)"

#: gui/text/quotes.txt:202
msgid ""
"“These \\[my children] are my jewels.” \\n— Cornelia Africana (mother of "
"Tiberius and Gaius Gracchus) to a wealthy visitor showing off her opulent "
"jewelry (Valerius Maximus, “Memorable Deeds and Sayings” Book IV, Chapter 4)"
msgstr "“Đây \\[những đứa con của tôi] chính là báu vật của tôi.” \\n— Cornelia Africana (mẹ của Tiberius và Gaius Gracchus) nói với một vị khách giàu có đang khoe khoang đồ trang sức xa hoa (Valerius Maximus, “Những việc làm và danh ngôn đáng nhớ” Quyển IV, Chương 4)"

#: gui/text/quotes.txt:203
msgid ""
"“I will appeal to Philip, but to Philip sober.” \\n— Foreign woman to King "
"Philip of Macedon having received a poor ruling while he was drunk (Valerius"
" Maximus, “Memorable Deeds and Sayings” Book VI, Chapter 2)"
msgstr "“Tôi sẽ kháng cáo lên Philip, nhưng là một Philip khi đang tỉnh táo.” \\n— Một người phụ nữ ngoại quốc nói với Vua Philip của Macedon sau khi nhận một phán quyết sai lệch trong lúc ông đang say rượu (Valerius Maximus, “Những việc làm và danh ngôn đáng nhớ” Quyển VI, Chương 2)"

#: gui/text/quotes.txt:204
msgid ""
"“Now the empire has fallen from gold to iron and rust.” \\n— Cassius Dio "
"referring to the Year of the Five Emperors (“Roman History” Book 73)"
msgstr "“Giờ đây đế chế đã suy tàn từ thời hoàng kim sang thời sắt thép và rỉ sét.” \\n— Cassius Dio nhắc về Năm của Năm Hoàng đế (“Lịch sử La Mã” Quyển 73)"

#: gui/text/quotes.txt:205
msgid ""
"“The man who struck his wife or child, laid violent hands on the holiest of "
"holy things.” \\n— Plutarch (“Life of Cato”, 20)"
msgstr "“Kẻ nào đánh vợ hay con mình, kẻ đó đã đặt bàn tay bạo lực lên những điều thiêng liêng nhất trong những điều thiêng liêng.” \\n— Plutarch (“Cuộc đời của Cato”, 20)"

#: gui/text/quotes.txt:206
msgid ""
"“It is unbearable to lose one's native land.” \\n— Seneca the Younger "
"(“Consolatio ad Helvium”, 12.6)"
msgstr "“Mất đi quê hương là một điều không thể chịu đựng nổi.” \\n— Seneca the Younger (“Consolatio ad Helvium”, 12.6)"

#: gui/text/quotes.txt:207
msgid ""
"“I believed I was perishing with the world, and the world with me.” \\n— "
"Pliny the Younger describing the eruption of Vesuvius (Letter 2: Epistulae "
"6.20)"
msgstr "“Tôi tin rằng mình đang tan biến cùng thế giới, và thế giới đang tan biến cùng tôi.” \\n— Pliny the Younger mô tả vụ phun trào núi lửa Vesuvius (Letter 2: Epistulae 6.20)"

#: gui/text/quotes.txt:208
msgid ""
"“This is a woman's resolve; as for men, they may live and be slaves.” \\n— "
"Boudicca, rallying against Roman occupation (Tacitus's Annals, Book 14, "
"Chapter 35)"
msgstr "“Đây là quyết tâm của một người phụ nữ; còn đàn ông, họ có thể chọn sống và làm nô lệ.” \\n— Boudicca, kêu gọi chống lại sự chiếm giữ của La Mã (Tacitus's Annals, Quyển 14, Chương 35)"

#: gui/text/quotes.txt:209
msgid ""
"“There are two things, knowledge and opinion; one makes its possessor know, "
"the other to be ignorant.” \\n— (Hippocratic treatise known as “The Law”, "
"part of the Hippocratic Corpus)"
msgstr "“Có hai thứ, kiến thức và định kiến; một thứ giúp người sở hữu nó hiểu biết, thứ còn lại khiến họ trở nên u mê.” \\n— (Tiểu luận Hippocratic được biết đến với tên “The Law”, một phần của Hippocratic Corpus)"

#: gui/text/quotes.txt:210
msgid ""
"“Let them hate me, so long as they fear me.” \\n— Caligula (Suetonius, The "
"Twelve Caesars, Book 30)"
msgstr "“Cứ để chúng ghét ta, miễn là chúng phải sợ ta.” \\n— Caligula (Suetonius, The Twelve Caesars, Quyển 30)"
