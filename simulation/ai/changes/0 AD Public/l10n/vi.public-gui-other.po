msgstr "Hiển thị phạm vi hào quang của các đơn vị và công trình được chọn. (Cũng có thể bật/tắt bằng phím nóng trong game)."

#: gui/options/options.json
msgid "Heal range visualization"
msgstr "Hiển thị phạm vi hồi máu"

