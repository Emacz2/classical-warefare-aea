msgstr "Hệ số sắc nét"

#: gui/options/options.json
msgid "The sharpness of the chosen pass."
msgstr "Độ sắc nét của lần truyền được chọn."

#: gui/options/options.json
msgid "Model quality"
msgstr "Chất lượng mô hình"

