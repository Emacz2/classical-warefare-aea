msgid "Scroll batch increment ratio"
msgstr "Tỷ lệ tăng lô cuộn"

#: gui/options/options.json
msgid ""
"Number of times you have to scroll to increase/decrease the batchsize by 1."
msgstr "Số lần bạn phải cuộn để tăng/giảm kích thước lô thêm 1."

#: gui/options/options.json
msgid "Snap to edges"
msgstr "Bắt dính vào cạnh"

#: gui/options/options.json
msgid "This option allows to align new structures with nearby structures."
msgstr "Tùy chọn này cho phép căn chỉnh các công trình mới với các công trình gần đó."

#: gui/options/options.json
msgid "Hotkey to enable snapping"
msgstr "Phím tắt để bật bắt dính"

#: gui/options/options.json
msgid ""
"New structures are aligned with nearby structures while pressing the hotkey."
msgstr "Các công trình mới được căn chỉnh với các công trình gần đó khi nhấn phím tắt."

#: gui/options/options.json
msgid "Hotkey to disable snapping"
msgstr "Phím tắt để tắt bắt dính"

#: gui/options/options.json
msgid ""
"New structures are aligned with nearby structures unless the hotkey is "
"pressed."
msgstr "Các công trình mới được căn chỉnh với các công trình gần đó trừ khi phím tắt được nhấn."

