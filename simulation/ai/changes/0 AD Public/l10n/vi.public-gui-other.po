msgid "Control group membership"
msgstr "Tư cách thành viên nhóm điều khiển"

#: gui/options/options.json
msgid "Decide whether units can be part of multiple control groups."
msgstr "Quyết định xem các đơn vị có thể thuộc nhiều nhóm điều khiển hay không."

#: gui/options/options.json
msgid "Single"
msgstr "Đơn lẻ"

#: gui/options/options.json
msgid ""
"When adding a Unit or Structure to a control group, they are removed from "
"other control groups. Use this choice if you want control groups to refer to"
" distinct armies."
msgstr "Khi thêm một Đơn vị hoặc Công trình vào một nhóm điều khiển, chúng sẽ bị loại bỏ khỏi các nhóm điều khiển khác. Sử dụng tùy chọn này nếu bạn muốn các nhóm điều khiển tham chiếu đến các đội quân riêng biệt."

#: gui/options/options.json
msgid "Multiple"
msgstr "Nhiều"

#: gui/options/options.json
msgid ""
"Units and Structures can be part of multiple control groups. This is useful "
"to keep control groups for distinct armies and a control group for the "
"entire army simultaneously."
msgstr "Các đơn vị và Công trình có thể thuộc nhiều nhóm điều khiển. Điều này hữu ích để giữ các nhóm điều khiển cho các đội quân riêng biệt và một nhóm điều khiển cho toàn bộ quân đội cùng lúc."

#: gui/options/options.json
msgid "Formation control"
msgstr "Điều khiển đội hình"

#: gui/options/options.json
msgid ""
"Decide whether formations are enabled for all orders or only 'Walk' and "
"'Patrol'."
msgstr "Quyết định xem đội hình được bật cho tất cả các lệnh hay chỉ 'Di chuyển' và 'Tuần tra'."

#: gui/options/options.json
msgid "Walk/Patrol Only"
msgstr "Chỉ đi bộ/Tuần tra"

#: gui/options/options.json
msgid "Other orders will disband existing formations."
msgstr "Các lệnh khác sẽ giải tán các đội hình hiện có."

#: gui/options/options.json
msgid "No override"
msgstr "Không ghi đè"

#: gui/options/options.json
msgid "Units in formations stay in formations."
msgstr "Các đơn vị trong đội hình vẫn giữ nguyên đội hình."

#: gui/options/options.json
msgid "Battalion-style formations"
msgstr "Đội hình kiểu tiểu đoàn"

#: gui/options/options.json
msgid "Whether formations are selected as a whole."
msgstr "Liệu các đội hình có được chọn toàn bộ hay không."

#: gui/options/options.json
