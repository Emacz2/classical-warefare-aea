msgstr "Thông báo tên người dùng"

#: gui/options/options.json
msgid "Receive audio notification when someone types your nick."
msgstr "Nhận thông báo âm thanh khi ai đó nhập tên người dùng của bạn."

#: gui/options/options.json
msgid "New player notification in game setup"
msgstr "Thông báo người chơi mới trong thiết lập trò chơi"

#: gui/options/options.json
msgid "Receive audio notification when a new client joins the game setup."
msgstr "Nhận thông báo âm thanh khi một máy khách mới tham gia thiết lập trò chơi."

#: gui/options/options.json
msgid "Game Setup"
msgstr "Thiết lập trò chơi"

#: gui/options/options.json
msgid "Change options relevant on the game setup page."
msgstr "Thay đổi các tùy chọn liên quan đến trang thiết lập trò chơi."

#: gui/options/options.json
msgid "Enable game setting tips"
msgstr "Bật gợi ý cài đặt trò chơi"

#: gui/options/options.json
msgid "Show tips when setting up a game."
msgstr "Hiển thị gợi ý khi thiết lập trò chơi."

#: gui/options/options.json
msgid "Enable settings panel slide"
msgstr "Bật trượt bảng cài đặt"

#: gui/options/options.json
msgid "Slide the settings panel when opening, closing or resizing."
msgstr "Trượt bảng cài đặt khi mở, đóng hoặc thay đổi kích thước."

#: gui/options/options.json
msgid "Persist match settings"
msgstr "Duy trì cài đặt trận đấu"

#: gui/options/options.json
msgid ""
"Save and restore match settings for quick reuse when hosting another game."
msgstr "Lưu và khôi phục cài đặt trận đấu để sử dụng lại nhanh chóng khi tổ chức một trò chơi khác."

#: gui/options/options.json
