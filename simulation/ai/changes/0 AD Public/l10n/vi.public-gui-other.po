msgstr "Độ khó AI mặc định"

#: gui/options/options.json
msgid "Default difficulty of the AI."
msgstr "Độ khó mặc định của AI."

#: gui/options/options.json
msgctxt "Option for the AI difficulty."
msgid "Sandbox"
msgstr "Sandbox"

#: gui/options/options.json
msgctxt "Option for the AI difficulty."
msgid "Very Easy"
msgstr "Rất Dễ"

#: gui/options/options.json
msgctxt "Option for the AI difficulty."
msgid "Easy"
msgstr "Dễ"

#: gui/options/options.json
msgctxt "Option for the AI difficulty."
msgid "Medium"
msgstr "Trung bình"

#: gui/options/options.json
msgctxt "Option for the AI difficulty."
msgid "Hard"
msgstr "Khó"

#: gui/options/options.json
msgctxt "Option for the AI difficulty."
msgid "Very Hard"
msgstr "Rất khó"

#: gui/options/options.json
msgid "Default AI behavior"
msgstr "Hành vi AI mặc định"

#: gui/options/options.json
msgid "Default behavior of the AI."
msgstr "Hành vi mặc định của AI."

#: gui/options/options.json
msgid "Random"
msgstr "Ngẫu nhiên"

#: gui/options/options.json
msgid "Balanced"
msgstr "Cân bằng"

#: gui/options/options.json
msgid "Aggressive"
msgstr "Hung hăng"

#: gui/options/options.json
msgid "Defensive"
msgstr "Phòng thủ"

#: gui/options/options.json
msgid "Assign players"
msgstr "Chỉ định người chơi"

#: gui/options/options.json
msgid ""
"Automatically assign joining clients to free player slots during the match "
"setup."
msgstr "Tự động chỉ định các máy khách tham gia vào các vị trí người chơi trống trong quá trình thiết lập trận đấu."

#: gui/options/options.json
msgid "Players joining the match will be assigned if there is a free slot."
msgstr "Người chơi tham gia trận đấu sẽ được chỉ định nếu có vị trí trống."

#: gui/options/options.json
msgid ""
"Players joining the match will only be assigned if they are a buddy of the "
"host and if there is a free slot."
msgstr "Người chơi tham gia trận đấu sẽ chỉ được chỉ định nếu họ là bạn của người tổ chức và nếu có vị trí trống."

#: gui/options/options.json
msgid "Players only receive a slot when the host assigns them explicitly."
msgstr "Người chơi chỉ nhận được một vị trí khi người tổ chức chỉ định rõ ràng cho họ."

#: gui/options/options.json
msgid "Networking / Lobby"
msgstr "Mạng / Phòng đợi"

#: gui/options/options.json
msgid "Change multiplayer options."
msgstr "Thay đổi các tùy chọn nhiều người chơi."

#: gui/options/options.json
msgid "TLS encryption"
msgstr "Mã hóa TLS"

#: gui/options/options.json
msgid ""
"Protect login and data exchanged with the lobby server using TLS encryption."
msgstr "Bảo vệ thông tin đăng nhập và dữ liệu trao đổi với máy chủ phòng đợi bằng mã hóa TLS."

#: gui/options/options.json
msgid "Chat backlog"
msgstr "Nhật ký trò chuyện"

#: gui/options/options.json
msgid "Number of backlogged messages to load when joining the lobby."
msgstr "Số lượng tin nhắn đã lưu để tải khi tham gia phòng đợi."

#: gui/options/options.json
msgid "Game rating column"
msgstr "Cột xếp hạng trò chơi"

#: gui/options/options.json
msgid ""
"Show the average rating of the participating players in a column of the "
"gamelist."
msgstr "Hiển thị xếp hạng trung bình của những người chơi tham gia trong một cột của danh sách trò chơi."

#: gui/options/options.json
msgid "Network warnings"
msgstr "Cảnh báo mạng"

#: gui/options/options.json
msgid "Show which player has a bad connection in multiplayer games."
msgstr "Hiển thị người chơi nào có kết nối kém trong các trò chơi nhiều người chơi."

#: gui/options/options.json
msgid "Late observer joins"
msgstr "Người quan sát tham gia muộn"

#: gui/options/options.json
msgid ""
"Allow everybody or buddies only to join the game as observer after it "
"started."
msgstr "Cho phép mọi người hoặc chỉ bạn bè tham gia trò chơi với tư cách người quan sát sau khi trò chơi bắt đầu."

#: gui/options/options.json
msgid "Observer limit"
msgstr "Giới hạn người quan sát"

#: gui/options/options.json
msgid "Prevent further observers from joining if the limit is reached."
msgstr "Ngăn chặn người quan sát khác tham gia nếu đạt đến giới hạn."

#: gui/options/options.json
msgid "Max lag for observers"
msgstr "Độ trễ tối đa cho người quan sát"

#: gui/options/options.json
msgid ""
"When hosting, pause the game if observers are lagging more than this many "
"turns. If set to -1, observers are ignored."
msgstr "Khi tổ chức, tạm dừng trò chơi nếu người quan sát bị trễ hơn số lượt này. Nếu đặt thành -1, người quan sát sẽ bị bỏ qua."

#: gui/options/options.json
msgid "(Observer) Speed up when lagging."
msgstr "(Người quan sát) Tăng tốc khi bị trễ."

#: gui/options/options.json
msgid ""
"When observing a game, automatically speed up if you start lagging, to catch"
" up with the live match."
msgstr "Khi quan sát một trò chơi, tự động tăng tốc nếu bạn bắt đầu bị trễ, để bắt kịp trận đấu trực tiếp."

#: gui/options/options.json
msgid "Chat & Notifications"
msgstr "Trò chuyện & Thông báo"

#: gui/options/options.json
msgid "Configure the in-game chat."
msgstr "Cấu hình trò chuyện trong game."

#: gui/options/options.json
msgid "Chat timestamp"
msgstr "Dấu thời gian trò chuyện"

#: gui/options/options.json
msgid "Display the time when a chat message was posted."
msgstr "Hiển thị thời gian tin nhắn trò chuyện được gửi."

#: gui/options/options.json
msgid "Chat notification attack"
msgstr "Thông báo tấn công qua trò chuyện"

#: gui/options/options.json
msgid "Show a chat notification if you are attacked by another player."
msgstr "Hiển thị thông báo trò chuyện nếu bạn bị người chơi khác tấn công."

#: gui/options/options.json
msgid "Chat notification tribute"
msgstr "Thông báo cống nạp qua trò chuyện"

#: gui/options/options.json
msgid ""
"Show a chat notification if an ally tributes resources to another team "
"member if teams are locked, and all tributes in observer mode."
msgstr "Hiển thị thông báo trò chuyện nếu một đồng minh cống nạp tài nguyên cho thành viên khác trong đội nếu đội bị khóa, và tất cả các cống nạp trong chế độ người quan sát."

#: gui/options/options.json
msgid "Chat notification barter"
msgstr "Thông báo trao đổi qua trò chuyện"

#: gui/options/options.json
msgid ""
"Show a chat notification to observers when a player bartered resources."
msgstr "Hiển thị thông báo trò chuyện cho người quan sát khi một người chơi trao đổi tài nguyên."

#: gui/options/options.json
msgid "Chat notification flare"
msgstr "Thông báo pháo hiệu qua trò chuyện"

#: gui/options/options.json
msgid "Show a chat notification when a player sends a flare."
msgstr "Hiển thị thông báo trò chuyện khi một người chơi gửi pháo hiệu."

#: gui/options/options.json
msgid "Never"
msgstr "Không bao giờ"

#: gui/options/options.json
msgid "Disable flare chat notifications."
msgstr "Tắt thông báo pháo hiệu qua trò chuyện."

#: gui/options/options.json
msgid "Only as observer"
msgstr "Chỉ với tư cách người quan sát"

#: gui/options/options.json
msgid "Only show flare chat notifications when you are observer."
msgstr "Chỉ hiển thị thông báo pháo hiệu qua trò chuyện khi bạn là người quan sát."

#: gui/options/options.json
msgid "Always"
msgstr "Luôn luôn"

#: gui/options/options.json
msgid "Always show flare chat notifications – as player and as observer."
msgstr "Luôn hiển thị thông báo pháo hiệu qua trò chuyện – với tư cách người chơi và người quan sát."

#: gui/options/options.json
msgid "Chat notification phase"
msgstr "Thông báo giai đoạn qua trò chuyện"

#: gui/options/options.json
msgid ""
"Show a chat notification if you or an ally have started, aborted or "
"completed a new phase, and phases of all players in observer mode."
msgstr "Hiển thị thông báo trò chuyện nếu bạn hoặc một đồng minh đã bắt đầu, hủy bỏ hoặc hoàn thành một giai đoạn mới, và các giai đoạn của tất cả người chơi trong chế độ người quan sát."

#: gui/options/options.json
msgid "Disable"
msgstr "Tắt"

#: gui/options/options.json
msgid "Completed"
msgstr "Hoàn thành"

#: gui/options/options.json
msgid "All displayed"
msgstr "Tất cả được hiển thị"

#: gui/options/options.json
msgid "Display"
msgstr "Hiển thị"

#: gui/options/options.json
msgid "Customize the in-game display."
msgstr "Tùy chỉnh hiển thị trong game."

#: gui/options/options.json
msgid "Detailed tooltips"
msgstr "Gợi ý chi tiết"

#: gui/options/options.json
msgid "Show detailed tooltips for trainable units in structures."
msgstr "Hiển thị gợi ý chi tiết cho các đơn vị có thể huấn luyện trong các công trình."

#: gui/options/options.json
msgid "Naming of entities"
msgstr "Đặt tên thực thể"

#: gui/options/options.json
msgid "How to show entity names."
msgstr "Cách hiển thị tên thực thể."

#: gui/options/options.json
msgid "Specific names first"
msgstr "Tên riêng trước"

#: gui/options/options.json
msgid "Display specific names before generic names."
msgstr "Hiển thị tên riêng trước tên chung."

#: gui/options/options.json
msgid "Generic names first"
msgstr "Tên chung trước"

#: gui/options/options.json
msgid "Display generic names before specific names."
msgstr "Hiển thị tên chung trước tên riêng."

#: gui/options/options.json
msgid "Only specific names"
msgstr "Chỉ tên riêng"

#: gui/options/options.json
msgid "Display only specific names for entities."
msgstr "Chỉ hiển thị tên riêng cho các thực thể."

#: gui/options/options.json
msgid "Only generic names"
msgstr "Chỉ tên chung"

#: gui/options/options.json
msgid "Display only generic names for entities."
msgstr "Chỉ hiển thị tên chung cho các thực thể."

#: gui/options/options.json
msgid "Sort resources and population tooltip"
msgstr "Sắp xếp gợi ý tài nguyên và dân số"

#: gui/options/options.json
msgid ""
"Dynamically sort players in the resources and population tooltip by value."
msgstr "Sắp xếp động người chơi trong gợi ý tài nguyên và dân số theo giá trị."

