msgstr "Các mô hình đơn giản hơn để có hiệu suất tốt hơn."

#: gui/options/options.json
msgctxt "Option for the meshes' level of detail."
msgid "Medium"
msgstr "Trung bình"

#: gui/options/options.json
msgid "Average quality and average performance."
msgstr "Chất lượng trung bình và hiệu suất trung bình."

#: gui/options/options.json
msgctxt "Option for the meshes' level of detail."
msgid "High"
msgstr "Cao"

#: gui/options/options.json
msgid "High quality models."
msgstr "Mô hình chất lượng cao."

#: gui/options/options.json
msgid "Model appearance randomization"
msgstr "Ngẫu nhiên hóa hình dạng mô hình"

#: gui/options/options.json
msgid ""
"Randomize the appearance of entities. Disabling gives a small performance "
"improvement."
msgstr "Ngẫu nhiên hóa hình dạng của các thực thể. Vô hiệu hóa sẽ cải thiện hiệu suất một chút."

#: gui/options/options.json
msgctxt "Option for the meshes' amount of variety."
msgid "None"
msgstr "Không"

#: gui/options/options.json
msgid "Entities will all look the same."
msgstr "Các thực thể sẽ trông giống hệt nhau."

#: gui/options/options.json
msgctxt "Option for the meshes' amount of variety."
msgid "Limited"
msgstr "Hạn chế"

#: gui/options/options.json
msgid "Entities will be less diverse."
msgstr "Các thực thể sẽ ít đa dạng hơn."

#: gui/options/options.json
msgctxt "Option for the meshes' amount of variety."
msgid "Normal"
msgstr "Bình thường"

#: gui/options/options.json
msgid "Entities appearance is randomized normally."
msgstr "Hình dạng thực thể được ngẫu nhiên hóa bình thường."

#: gui/options/options.json
msgid "Shader effects"
msgstr "Hiệu ứng shader"

#: gui/options/options.json
msgid "Number of shader effects. REQUIRES GAME RESTART"
msgstr "Số lượng hiệu ứng shader. **YÊU CẦU KHỞI ĐỘNG LẠI GAME**"

#: gui/options/options.json
msgid "Quality"
msgstr "Chất lượng"

#: gui/options/options.json
msgid ""
"Shadow map resolution. High values can crash the game when using a graphics "
"card with low memory!"
msgstr "Độ phân giải bản đồ bóng. Giá trị cao có thể làm treo game khi sử dụng card đồ họa có bộ nhớ thấp!"

#: gui/options/options.json
msgctxt "Option for the shadow quality."
msgid "Low"
msgstr "Thấp"

#: gui/options/options.json
msgctxt "Option for the shadow quality."
msgid "Medium"
msgstr "Trung bình"

#: gui/options/options.json
msgctxt "Option for the shadow quality."
msgid "High"
msgstr "Cao"

#: gui/options/options.json
msgctxt "Option for the shadow quality."
msgid "Very High"
msgstr "Rất Cao"

#: gui/options/options.json
msgid "Filtering"
msgstr "Lọc"

#: gui/options/options.json
msgid "Smooth shadows."
msgstr "Bóng mượt."

#: gui/options/options.json
msgid "Cover whole map"
msgstr "Phủ toàn bộ bản đồ"

#: gui/options/options.json
msgid ""
"When ON shadows cover the whole map and shadows cutoff distance is ignored. "
"Useful for making screenshots of a whole map."
msgstr "Khi **BẬT**, bóng phủ toàn bộ bản đồ và khoảng cách cắt bóng bị bỏ qua. Hữu ích để chụp ảnh màn hình toàn bộ bản đồ."

#: gui/options/options.json
msgid "Cutoff distance"
msgstr "Khoảng cách cắt"

#: gui/options/options.json
msgid "Hides shadows beyond a certain distance from a camera."
msgstr "Ẩn bóng ngoài một khoảng cách nhất định so với máy ảnh."

#: gui/options/options.json
msgid "Water effects"
msgstr "Hiệu ứng nước"

#: gui/options/options.json
msgid ""
"When OFF, use the lowest settings possible to render water. This makes other"
" settings irrelevant."
msgstr "Khi **TẮT**, sử dụng cài đặt thấp nhất có thể để kết xuất nước. Điều này làm cho các cài đặt khác trở nên không liên quan."

#: gui/options/options.json
msgid "High-quality water effects"
msgstr "Hiệu ứng nước chất lượng cao"

#: gui/options/options.json
msgid ""
"Use higher-quality effects for water, rendering coastal waves, shore foam, "
"and ships trails."
msgstr "Sử dụng các hiệu ứng chất lượng cao hơn cho nước, kết xuất sóng ven biển, bọt biển, và vệt tàu."

#: gui/options/options.json
msgid "Water reflections"
msgstr "Phản chiếu nước"

#: gui/options/options.json
msgid "Allow water to reflect a mirror image."
msgstr "Cho phép nước phản chiếu hình ảnh gương."

#: gui/options/options.json
msgid "Water refraction"
msgstr "Khúc xạ nước"

#: gui/options/options.json
msgid "Use a real water refraction map and not transparency."
msgstr "Sử dụng bản đồ khúc xạ nước thật chứ không phải độ trong suốt."

#: gui/options/options.json
msgid "Real water depth"
msgstr "Độ sâu nước thực"

#: gui/options/options.json
msgid "Use actual water depth in rendering calculations."
msgstr "Sử dụng độ sâu nước thực tế trong tính toán kết xuất."

#: gui/options/options.json
msgid "Texture quality"
msgstr "Chất lượng kết cấu"

#: gui/options/options.json
msgid ""
"Decrease texture quality making them blurrier but increases game "
"performance."
msgstr "Giảm chất lượng kết cấu làm chúng mờ hơn nhưng tăng hiệu suất trò chơi."

#: gui/options/options.json
msgctxt "Option for the texture quality."
msgid "Low"
msgstr "Thấp"

#: gui/options/options.json
msgid "Low"
msgstr "Thấp"

#: gui/options/options.json
msgctxt "Option for the texture quality."
msgid "Medium"
msgstr "Trung bình"

#: gui/options/options.json
msgid "Medium"
msgstr "Trung bình"

#: gui/options/options.json
msgctxt "Option for the texture quality."
msgid "High"
msgstr "Cao"

#: gui/options/options.json
msgid "High"
msgstr "Cao"

#: gui/options/options.json
msgid "Texture anisotropic filter"
msgstr "Bộ lọc bất đẳng hướng kết cấu"

#: gui/options/options.json
msgid ""
"Makes textures look better, especially terrain. If the anisotropic filter "
"value is unsupported it will be set to the max supported value."
msgstr "Làm cho kết cấu trông đẹp hơn, đặc biệt là địa hình. Nếu giá trị bộ lọc bất đẳng hướng không được hỗ trợ, nó sẽ được đặt thành giá trị tối đa được hỗ trợ."

#: gui/options/options.json
msgid "1x"
msgstr "1x"

