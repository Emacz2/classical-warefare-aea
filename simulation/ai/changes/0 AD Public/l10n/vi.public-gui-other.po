#: gui/options/options.json
msgid "General"
msgstr "Tổng quát"

#: gui/options/options.json
msgid "Change general options."
msgstr "Thay đổi các tùy chọn chung."

#: gui/options/options.json
msgid "Player name (single-player)"
msgstr "Tên người chơi (Một người chơi)"

#: gui/options/options.json
msgid "How you want to be addressed in single-player matches."
msgstr "Cách bạn muốn được gọi trong các trận đấu một người chơi."

#: gui/options/options.json
msgid "Player name (multiplayer)"
msgstr "Tên người chơi (Nhiều người chơi)"

#: gui/options/options.json
msgid "How you want to be addressed in multiplayer matches (except lobby)."
msgstr "Cách bạn muốn được gọi trong các trận đấu nhiều người chơi (trừ sảnh chờ)."

#: gui/options/options.json
msgid "Background pause"
msgstr "Tạm dừng nền"

#: gui/options/options.json
msgid "Pause single-player games when window loses focus."
msgstr "Tạm dừng game một người chơi khi cửa sổ mất tiêu điểm."

#: gui/options/options.json
msgid "Enable welcome screen"
msgstr "Bật màn hình chào mừng"

#: gui/options/options.json
msgid ""
"If you disable it, the welcome screen will still appear, each time a new "
"version is available. You can always launch it from the main menu."
msgstr "Nếu bạn tắt nó, màn hình chào mừng vẫn sẽ xuất hiện mỗi khi có phiên bản mới. Bạn luôn có thể khởi chạy nó từ menu chính."

#: gui/options/options.json
msgid "Graphics (general)"
msgstr "Đồ họa (chung)"

#: gui/options/options.json
msgid "Set the balance between performance and visual appearance."
msgstr "Đặt sự cân bằng giữa hiệu suất và hình ảnh."

#: gui/options/options.json
msgid "Windowed mode"
msgstr "Chế độ cửa sổ"

#: gui/options/options.json
msgid "Start 0 A.D. in a window."
msgstr "Start 0 A.D. in a window."

#: gui/options/options.json
msgid "Resolution scale"
msgstr "Tỷ lệ phân giải"

#: gui/options/options.json
msgid ""
"A smaller scale makes rendering faster but produces a more blurry picture, a"
" large scale makes rendering slower but produces a better picture."
msgstr "Tỷ lệ nhỏ hơn giúp kết xuất nhanh hơn nhưng tạo ra hình ảnh mờ hơn, tỷ lệ lớn hơn giúp kết xuất chậm hơn nhưng tạo ra hình ảnh tốt hơn."

#: gui/options/options.json
msgid "50%"
msgstr "50%"

#: gui/options/options.json
msgid "87.5%"
msgstr "87.5%"

#: gui/options/options.json
msgid "Upscale technique"
msgstr "Kỹ thuật nâng cấp hình ảnh"

#: gui/options/options.json
msgid "Technique defines performance and quality of upscaling process."
msgstr "Kỹ thuật xác định hiệu suất và chất lượng của quá trình nâng cấp hình ảnh."

#: gui/options/options.json
msgid "FidelityFX Super Resolution 1.0"
msgstr "Siêu Phân Giải FidelityFX 1.0"

#: gui/options/options.json
msgid ""
"Advanced upscale technique. For better results, use FSR with antialiasing "
"enabled. Using it with the OpenGL backend may have some issues, consider "
"using Vulkan backend instead."
msgstr "Kỹ thuật nâng cấp hình ảnh tiên tiến. Để có kết quả tốt hơn, hãy sử dụng FSR với tính năng khử răng cưa được bật. Sử dụng nó với phần mềm OpenGL có thể gặp một số vấn đề, hãy cân nhắc sử dụng phần mềm Vulkan thay thế."

#: gui/options/options.json
msgid "Bilinear"
msgstr "Song tuyến tính"

#: gui/options/options.json
msgid ""
"Bilinear upscale technique. Produces a slightly blurry picture depending on "
"the scale."
msgstr "Kỹ thuật nâng cấp hình ảnh song tuyến tính. Tạo ra hình ảnh hơi mờ tùy thuộc vào tỷ lệ."

#: gui/options/options.json
msgid "Pixelated"
msgstr "Răng cưa"

#: gui/options/options.json
msgid "Simplest upscale technique. Used mostly for stylized effect."
msgstr "Kỹ thuật nâng cấp hình ảnh đơn giản nhất. Chủ yếu được sử dụng cho hiệu ứng cách điệu."

#: gui/options/options.json
msgid "Unit silhouettes"
msgstr "Hình bóng đơn vị"

#: gui/options/options.json
msgid "Show outlines of units behind structures."
msgstr "Hiển thị đường viền của các đơn vị phía sau các công trình."

#: gui/options/options.json
msgid "Particles"
msgstr "Hạt"

#: gui/options/options.json
msgid "Enable particles."
msgstr "Bật các hạt."

#: gui/options/options.json
msgid "VSync"
msgstr "VSync"

#: gui/options/options.json
msgid "Run vertical sync to fix screen tearing. REQUIRES GAME RESTART"
msgstr "Chạy đồng bộ dọc để khắc phục tình trạng xé hình. YÊU CẦU KHỞI ĐỘNG LẠI GAME"

#: gui/options/options.json
msgid "FPS throttling in menus"
msgstr "Giới hạn FPS trong menu"

#: gui/options/options.json
msgid ""
"To save CPU workload, throttle render frequency in all menus. Set to maximum"
" to disable throttling."
msgstr "Để tiết kiệm tải CPU, hãy giới hạn tần số kết xuất trong tất cả các menu. Đặt ở mức tối đa để tắt giới hạn."

#: gui/options/options.json
msgid "FPS throttling in games"
msgstr "Giới hạn FPS trong game"

#: gui/options/options.json
msgid ""
"To save CPU workload, throttle render frequency in running games. Set to "
"maximum to disable throttling."
msgstr "Để tiết kiệm tải CPU, hãy giới hạn tần số kết xuất trong các game đang chạy. Đặt ở mức tối đa để tắt giới hạn."

#: gui/options/options.json
msgid "225%"
msgstr "225%"

#: gui/options/options.json
msgid "250%"
msgstr "250%"

#: gui/options/options.json
msgid "Mouse drag"
msgstr "Kéo chuột"

#: gui/options/options.json
msgid ""
"Number of pixels the mouse can move before the action is considered a drag."
msgstr "Số lượng pixel chuột có thể di chuyển trước khi hành động được coi là kéo."

#: gui/options/options.json
msgid "Mouse pan inverted"
msgstr "Dịch chuyển chuột đảo ngược"

#: gui/options/options.json
msgid "Invert middle-click drag pan direction."
msgstr "Đảo ngược hướng dịch chuyển khi kéo chuột giữa."

#: gui/options/options.json
msgid "Mouse pan speed"
msgstr "Tốc độ dịch chuyển chuột"

#: gui/options/options.json
msgid "Speed mouse pans the map when holding middle-click and dragging."
msgstr "Tốc độ chuột dịch chuyển bản đồ khi giữ chuột giữa và kéo."

#: gui/options/options.json
msgid "Mouse grab in fullscreen"
msgstr "Bắt chuột trong chế độ toàn màn hình"

#: gui/options/options.json
msgid ""
"Constrain mouse in the fullscreen mode to the window boundaries. It's used "
"to avoid mouse going out of a display in case of multiple displays."
msgstr "Giới hạn chuột trong chế độ toàn màn hình vào ranh giới cửa sổ. Điều này được sử dụng để tránh chuột đi ra ngoài màn hình trong trường hợp có nhiều màn hình."

#: gui/options/options.json
msgid "Mouse grab in window mode"
msgstr "Bắt chuột trong chế độ cửa sổ"

#: gui/options/options.json
msgid "Constrain mouse in the window mode to the window boundaries."
msgstr "Giới hạn chuột trong chế độ cửa sổ vào ranh giới cửa sổ."

#: gui/options/options.json
msgid "Graphics (advanced)"
msgstr "Đồ họa (nâng cao)"

#: gui/options/options.json
msgid "Adjust advanced graphic options."
msgstr "Điều chỉnh các tùy chọn đồ họa nâng cao."

#: gui/options/options.json
msgid "Renderer backend"
msgstr "Phần mềm kết xuất"

#: gui/options/options.json
msgid ""
"Choose the renderer's backend. It's recommended to use Vulkan if supported. "
"REQUIRES GAME RESTART"
msgstr "Chọn phần mềm kết xuất. Khuyến nghị sử dụng Vulkan nếu được hỗ trợ. YÊU CẦU KHỞI ĐỘNG LẠI GAME"

#: gui/options/options.json
msgid "OpenGL"
msgstr "OpenGL"

#: gui/options/options.json
msgid "Default OpenGL backend with GLSL. REQUIRES GAME RESTART"
msgstr "Phần mềm OpenGL mặc định với GLSL. YÊU CẦU KHỞI ĐỘNG LẠI GAME"

#: gui/options/options.json
msgid "OpenGL ARB (Deprecated)"
msgstr "OpenGL ARB (Đã lỗi thời)"

#: gui/options/options.json
msgid ""
"Legacy OpenGL backend with ARB shaders. It's deprecated and it's going to be"
" removed in future versions of the game. REQUIRES GAME RESTART"
msgstr "Phần mềm OpenGL cũ với shader ARB. Nó đã lỗi thời và sẽ bị loại bỏ trong các phiên bản game tương lai. YÊU CẦU KHỞI ĐỘNG LẠI GAME"

#: gui/options/options.json
msgid "Vulkan"
msgstr "Vulkan"

#: gui/options/options.json
msgid "Modern API, requires up-to-date drivers. REQUIRES GAME RESTART"
msgstr "API hiện đại, yêu cầu trình điều khiển cập nhật. YÊU CẦU KHỞI ĐỘNG LẠI GAME"

#: gui/options/options.json
msgid "GPU skinning"
msgstr "GPU skinning"

#: gui/options/options.json
msgid ""
"Use GPU to update geometry for animated models. It reduces a CPU load during"
" rendering especially on a modern hardware."
msgstr "Sử dụng GPU để cập nhật hình học cho các mô hình hoạt hình. Nó giảm tải CPU trong quá trình kết xuất, đặc biệt trên phần cứng hiện đại."

#: gui/options/options.json
msgid "Antialiasing"
msgstr "Khử răng cưa"

#: gui/options/options.json
msgid "Reduce aliasing effect on edges."
msgstr "Giảm hiệu ứng răng cưa trên các cạnh."

#: gui/options/options.json
msgid "Do not use antialiasing."
msgstr "Không sử dụng khử răng cưa."

#: gui/options/options.json
msgid "FXAA"
msgstr "FXAA"

#: gui/options/options.json
msgid "Fast, but simple antialiasing."
msgstr "Khử răng cưa nhanh, nhưng đơn giản."

#: gui/options/options.json
msgid "MSAA (2×)"
msgstr "MSAA (2×)"

#: gui/options/options.json
msgid ""
"Slow, but high-quality antialiasing, uses two samples per pixel. Supported "
"for GL3.3+."
msgstr "Khử răng cưa chậm, nhưng chất lượng cao, sử dụng hai mẫu trên mỗi pixel. Hỗ trợ cho GL3.3+."

#: gui/options/options.json
msgid "MSAA (4×)"
msgstr "MSAA (4×)"

#: gui/options/options.json
msgid ""
"Slow, but high-quality antialiasing, uses four samples per pixel. Supported "
"for GL3.3+."
msgstr "Khử răng cưa chậm, nhưng chất lượng cao, sử dụng bốn mẫu trên mỗi pixel. Hỗ trợ cho GL3.3+."

#: gui/options/options.json
msgid "MSAA (8×)"
msgstr "MSAA (8×)"

#: gui/options/options.json
msgid ""
"Slow, but high-quality antialiasing, uses eight samples per pixel. Supported"
" for GL3.3+."
msgstr "Khử răng cưa chậm, nhưng chất lượng cao, sử dụng tám mẫu trên mỗi pixel. Hỗ trợ cho GL3.3+."

#: gui/options/options.json
msgid "MSAA (16×)"
msgstr "MSAA (16×)"

#: gui/options/options.json
msgid ""
"Slow, but high-quality antialiasing, uses sixteen samples per pixel. "
"Supported for GL3.3+."
msgstr "Khử răng cưa chậm, nhưng chất lượng cao, sử dụng mười sáu mẫu trên mỗi pixel. Hỗ trợ cho GL3.3+."

#: gui/options/options.json
msgid "Sharpening"
msgstr "Làm sắc nét"

#: gui/options/options.json
msgid "Reduce blurry effects."
msgstr "Giảm hiệu ứng mờ."

#: gui/options/options.json
msgid "Do not use sharpening."
msgstr "Không sử dụng làm sắc nét."

#: gui/options/options.json
msgid "FidelityFX CAS"
msgstr "FidelityFX CAS"

#: gui/options/options.json
msgid "Contrast adaptive sharpening, a fast, contrast based sharpening pass."
msgstr "Làm sắc nét thích ứng tương phản, một lần làm sắc nét nhanh, dựa trên độ tương phản."

