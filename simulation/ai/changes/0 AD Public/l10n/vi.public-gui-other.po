msgstr "Màu sắc của người chơi trung lập khi bật màu sắc ngoại giao."

#: gui/options/options.json
msgid "Diplomacy colors: enemy"
msgstr "Màu sắc ngoại giao: kẻ thù"

#: gui/options/options.json
msgid "Color of enemies when diplomacy colors are enabled."
msgstr "Màu sắc của kẻ thù khi bật màu sắc ngoại giao."

#: gui/options/options.json
msgid "Gameplay"
msgstr "Gameplay"

#: gui/options/options.json
msgid "Change options affecting the gameplay."
msgstr "Thay đổi các tùy chọn ảnh hưởng đến gameplay."

#: gui/options/options.json
msgid "Wounded unit health"
msgstr "Máu đơn vị bị thương"

#: gui/options/options.json
msgid ""
"The wounded unit hotkey considers the selected units as wounded if their "
"health percentage falls below this number."
msgstr "Phím tắt đơn vị bị thương xem các đơn vị được chọn là bị thương nếu phần trăm máu của chúng giảm xuống dưới con số này."

#: gui/options/options.json
msgid "Batch training size"
msgstr "Kích thước đào tạo theo lô"

#: gui/options/options.json
msgid "Number of units trained per batch by default."
msgstr "Số lượng đơn vị được đào tạo mỗi lô theo mặc định."

