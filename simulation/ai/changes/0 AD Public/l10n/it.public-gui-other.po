msgid "Vulkan"
msgstr "Vulkan"

#: gui/options/options.json
msgid "Modern API, requires up-to-date drivers. REQUIRES GAME RESTART"
msgstr "L'API attuale, richiede driver aggiornati. RICHIEDE IL RIAVVIO DEL GIOCO"

#: gui/options/options.json
msgid "GPU skinning"
msgstr "GPU skinning"

#: gui/options/options.json
msgid ""
"Use GPU to update geometry for animated models. It reduces a CPU load during"
" rendering especially on a modern hardware."
msgstr "Utilizza la GPU per aggiornare la geometria dei modelli animati. Questo riduce il carico della CPU durante il rendering, soprattutto su un hardware moderno."

#: gui/options/options.json
msgid "Antialiasing"
msgstr "Antialiasing"

#: gui/options/options.json
msgid "Reduce aliasing effect on edges."
msgstr "Riduce effetti aliasing sui bordi."

