#: simulation/data/technologies/agoge.json
msgid "The Agoge"
msgstr "L'agogé"

#: simulation/data/technologies/agoge.json
msgid "Agōga"
msgstr "Agōga"

#: simulation/data/technologies/agoge.json
msgid ""
"Spartans were housed and trained from a young age to be superlative warriors"
" and to endure any hardship a military life can give them."
msgstr "Els espartans eren allotjats i entrenats des de ben petits per ser guerrers extraordinaris i per resistir qualsevol adversitat de la vida militar. "

#: simulation/data/technologies/agoge.json
msgid "Champion Hoplites +25% health, but +5% training time."
msgstr "Els hoplites campions tenen un +25% de salut, però un +5% de temps d’entrenament."

