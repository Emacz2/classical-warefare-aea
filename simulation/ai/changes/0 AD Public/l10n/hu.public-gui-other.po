msgstr "Zene hangereje"

#: gui/options/options.json
msgid "In game music gain."
msgstr "Játékbeli zene erősítése."

#: gui/options/options.json
msgid "Ambient volume"
msgstr "Környezet hangereje"

#: gui/options/options.json
msgid "In game ambient sound gain."
msgstr "Játékbeli környezet hangjainak erősítése."

#: gui/options/options.json
msgid "Action volume"
msgstr "Akció hangereje"

#: gui/options/options.json
msgid "In game unit action sound gain."
msgstr "Játékbeli akciók hangjainak erősítése."

#: gui/options/options.json
msgid "UI volume"
msgstr "Felület hangereje"

#: gui/options/options.json
msgid "UI sound gain."
msgstr "Kezelőfelület hangjainak erősítése"

#: gui/options/options.json
msgid "Nick notification"
msgstr "Becenév értesítés"

#: gui/options/options.json
msgid "Receive audio notification when someone types your nick."
msgstr "Értesítő hang lejátszása, ha valaki beírja a beceneved."

#: gui/options/options.json
msgid "New player notification in game setup"
msgstr "Értesítés új játékosról a játékbeállításban"

#: gui/options/options.json
msgid "Receive audio notification when a new client joins the game setup."
msgstr "Értesítő hang lejátszása, ha egy új kliens csatlakozik a játékbeállításhoz."

#: gui/options/options.json
msgid "Game Setup"
msgstr "Játszmák előkészítése"

#: gui/options/options.json
msgid "Change options relevant on the game setup page."
msgstr "Változtassa meg a játék beállítási oldalán a vonatkozó beállításokat."

#: gui/options/options.json
msgid "Enable game setting tips"
msgstr "Tippek engedélyezése a játszmák előkészítésénél"

#: gui/options/options.json
msgid "Show tips when setting up a game."
msgstr "Tippek megjelenítése a játék beállításakor."

#: gui/options/options.json
msgid "Enable settings panel slide"
msgstr "Beállításpanel beúszásának engedélyezése"

#: gui/options/options.json
msgid "Slide the settings panel when opening, closing or resizing."
msgstr "A beállításpanel csúsztatása megnyitáskor, bezáráskor vagy átméretezéskor."

#: gui/options/options.json
msgid "Persist match settings"
msgstr "Játszmabeállítások megőrzése"

#: gui/options/options.json
msgid ""
"Save and restore match settings for quick reuse when hosting another game."
msgstr "A mérkőzés beállításainak mentése és visszaállítása a gyors újrafelhasználáshoz egy másik hálózati játék indításakor."

#: gui/options/options.json
msgid "Default AI difficulty"
msgstr "Alapértelmezett MI nehézség"

#: gui/options/options.json
msgid "Default difficulty of the AI."
msgstr "Az MI alapértelmezett nehézségi szintje."

#: gui/options/options.json
msgctxt "Option for the AI difficulty."
msgid "Sandbox"
msgstr "Homokozó"

#: gui/options/options.json
msgctxt "Option for the AI difficulty."
msgid "Very Easy"
msgstr "Nagyon könnyű"

#: gui/options/options.json
msgctxt "Option for the AI difficulty."
msgid "Easy"
msgstr "Könnyű"

#: gui/options/options.json
msgctxt "Option for the AI difficulty."
msgid "Medium"
msgstr "Közepes"

#: gui/options/options.json
msgctxt "Option for the AI difficulty."
msgid "Hard"
msgstr "Nehéz"

#: gui/options/options.json
msgctxt "Option for the AI difficulty."
msgid "Very Hard"
msgstr "Nagyon nehéz"

#: gui/options/options.json
msgid "Default AI behavior"
msgstr "Alapértelmezett MI viselkedés"

#: gui/options/options.json
msgid "Default behavior of the AI."
msgstr "Az MI alapértelmezett viselkedése."

#: gui/options/options.json
msgid "Random"
msgstr "Véletlenszerű"

#: gui/options/options.json
msgid "Balanced"
msgstr "Kiegyensúlyozott"

#: gui/options/options.json
msgid "Aggressive"
msgstr "Agresszív"

#: gui/options/options.json
msgid "Defensive"
msgstr "Védekező"

#: gui/options/options.json
msgid "Assign players"
msgstr "Játékosok beosztása"

#: gui/options/options.json
msgid ""
"Automatically assign joining clients to free player slots during the match "
"setup."
msgstr "Ossza-e be automatikusan a csatlakozó ügyfeleket a szabad játékoshelyekre."

#: gui/options/options.json
msgid "Players joining the match will be assigned if there is a free slot."
msgstr "A meccshez csatlakozó játékosok beosztásra kerülnek, ha van szabad hely."

#: gui/options/options.json
msgid ""
"Players joining the match will only be assigned if they are a buddy of the "
"host and if there is a free slot."
msgstr "A meccshez csatlakozó játékosok csak akkor kerülnek beosztásra, ha a gazda barátai vagy ha van szabad hely."

#: gui/options/options.json
msgid "Players only receive a slot when the host assigns them explicitly."
msgstr "A játékosok csak akkor kapnak helyet, ha a gazda hozzárendeli őket."

#: gui/options/options.json
msgid "Networking / Lobby"
msgstr "Hálózat / Lobby"

#: gui/options/options.json
msgid "Change multiplayer options."
msgstr "Többjátékos beállítások módosítása."

#: gui/options/options.json
msgid "TLS encryption"
msgstr "TLS-titkosítás"

#: gui/options/options.json
msgid ""
"Protect login and data exchanged with the lobby server using TLS encryption."
msgstr "Védje TLS titkosítással a bejelentkezési adait, valamint a váró kiszolgálóval történő kommunikációt."

#: gui/options/options.json
msgid "Chat backlog"
msgstr "Csevegésnapló"

#: gui/options/options.json
msgid "Number of backlogged messages to load when joining the lobby."
msgstr "Betöltendő naplózott üzenetek száma a váróhoz csatlakozáskor."

#: gui/options/options.json
msgid "Game rating column"
msgstr "Játékértékelési oszlop"

#: gui/options/options.json
msgid ""
"Show the average rating of the participating players in a column of the "
"gamelist."
msgstr "A résztvevő játékosok átlagos értékelésének megjelenítése külön oszlopban a játéklistában."

#: gui/options/options.json
msgid "Network warnings"
msgstr "Hálózati figyelmeztetések"

#: gui/options/options.json
msgid "Show which player has a bad connection in multiplayer games."
msgstr "Jelenítse meg melyik játékosnak van rossz kapcsolata a többjátékos játékokban."

#: gui/options/options.json
msgid "Late observer joins"
msgstr "Késő megfigyelői csatlakozások"

#: gui/options/options.json
msgid ""
"Allow everybody or buddies only to join the game as observer after it "
"started."
msgstr "Bárki, vagy csak a barátok, csatlakozásának engedélyezése megfigyelőként a játék megkezdése után."

#: gui/options/options.json
msgid "Observer limit"
msgstr "Megfigyelőkorlát"

#: gui/options/options.json
msgid "Prevent further observers from joining if the limit is reached."
msgstr "További megfigyelők csatlakozásának megelőzése a korlát elérésekor."

#: gui/options/options.json
msgid "Max lag for observers"
msgstr "Maximális megengedhető lagg a megfigyelők számára"

#: gui/options/options.json
msgid ""
"When hosting, pause the game if observers are lagging more than this many "
"turns. If set to -1, observers are ignored."
msgstr "Amikor hosztingolsz, szüneteld a játékot, ha a szemlélők több mint ennyi fordulót lemaradnak. Ha -1-re van állítva, a figyelők figyelmen kívül maradnak."

#: gui/options/options.json
msgid "(Observer) Speed up when lagging."
msgstr "(Megfigyelőknek) Játéksebesség növelése lagg esetén"

#: gui/options/options.json
msgid ""
"When observing a game, automatically speed up if you start lagging, to catch"
" up with the live match."
msgstr "Játék megfigyelésekor automatikusan gyorsítson, ha elkezd lemaradni, hogy utolérje az élő meccset."

#: gui/options/options.json
msgid "Chat & Notifications"
msgstr "Csevegés és értesítések"

#: gui/options/options.json
msgid "Configure the in-game chat."
msgstr "Konfigurálja a játékon belüli csevegést."

#: gui/options/options.json
msgid "Chat timestamp"
msgstr "Csevegések időbélyege"

#: gui/options/options.json
msgid "Display the time when a chat message was posted."
msgstr "Megjeleníti a csevegőüzenet küldésének időpontját."

#: gui/options/options.json
msgid "Chat notification attack"
msgstr "Csevegésértesítés támadáskor"

#: gui/options/options.json
msgid "Show a chat notification if you are attacked by another player."
msgstr "Csevegésértesítés megjelenítése, ha egy másik játékos megtámadott."

#: gui/options/options.json
msgid "Chat notification tribute"
msgstr "Csevegésértesítés sarckor"

#: gui/options/options.json
msgid ""
"Show a chat notification if an ally tributes resources to another team "
"member if teams are locked, and all tributes in observer mode."
msgstr "Csevegésértesítés megjelenítése, ha egy szövetséges nyersanyag sarcot fizet egy másik csapattagnak és a csapatok rögzítve vannak, illetve minden sarcfizetést megfigyelő módban."

#: gui/options/options.json
msgid "Chat notification barter"
msgstr "Csevegésértesítés csereüzletkor"

#: gui/options/options.json
msgid ""
"Show a chat notification to observers when a player bartered resources."
msgstr "Csevegésértesítés megjelenítése, ha egy játékos nyersanyagokkal csereüzletel."

#: gui/options/options.json
msgid "Chat notification flare"
msgstr "Csevegési értesítés jelzőfénye"

#: gui/options/options.json
msgid "Show a chat notification when a player sends a flare."
msgstr "Mutasson csevegési értesítést, amikor egy játékos jelzőfényt küld."

#: gui/options/options.json
msgid "Never"
msgstr "Soha"

#: gui/options/options.json
msgid "Disable flare chat notifications."
msgstr "Letiltja a fény csevegési értesítéseit."

#: gui/options/options.json
msgid "Only as observer"
msgstr "Csak megfigyelőként"

#: gui/options/options.json
msgid "Only show flare chat notifications when you are observer."
msgstr "Csak akkor jelenítse meg a jelzőfényes csevegési értesítéseket, ha megfigyelőként van jelen."

#: gui/options/options.json
msgid "Always"
msgstr "Mindig"

#: gui/options/options.json
msgid "Always show flare chat notifications – as player and as observer."
msgstr "Mindig megjeleníti a világító csevegési értesítéseket – játékosként és megfigyelőként is."

#: gui/options/options.json
msgid "Chat notification phase"
msgstr "Csevegésértesítés szakaszváltáskor"

#: gui/options/options.json
msgid ""
"Show a chat notification if you or an ally have started, aborted or "
"completed a new phase, and phases of all players in observer mode."
msgstr "Csevegésértesítés megjelenítése, ha te vagy egy szövetséges elkezdett, félbeszakított vagy befejezett egy szakaszt; vagy megfigyelő módban az összes játékos szakasza esetén."

#: gui/options/options.json
msgid "Disable"
msgstr "Letiltás"

#: gui/options/options.json
msgid "Completed"
msgstr "Befejezve"

#: gui/options/options.json
msgid "All displayed"
msgstr "Összes megjelenítve"

#: gui/options/options.json
msgid "Display"
msgstr "Megjelenítés"

#: gui/options/options.json
msgid "Customize the in-game display."
msgstr "A játékbeli megjelenítés testreszabása."

#: gui/options/options.json
msgid "Detailed tooltips"
msgstr "Részletes eszköztippek"

#: gui/options/options.json
msgid "Show detailed tooltips for trainable units in structures."
msgstr "Részletes segédletek megjelenítése a kiképezhető egységekhez a struktúrákban."

#: gui/options/options.json
msgid "Naming of entities"
msgstr "Egységek elnevezése"

#: gui/options/options.json
msgid "How to show entity names."
msgstr "Így lesznek megjelenítve az egységek és az építmények nevei."

#: gui/options/options.json
msgid "Specific names first"
msgstr "Speciális nevek először"

#: gui/options/options.json
msgid "Display specific names before generic names."
msgstr "Speciális nevek megjelenítése az általános nevek előtt."

#: gui/options/options.json
msgid "Generic names first"
msgstr "Általános nevek először"

#: gui/options/options.json
msgid "Display generic names before specific names."
msgstr "Általános nevek megjelenítése a specifikus nevek előtt."

#: gui/options/options.json
msgid "Only specific names"
msgstr "Csak specifikus nevek"

#: gui/options/options.json
msgid "Display only specific names for entities."
msgstr "Egységeknél csak a specifikus neveket jeleníti meg."

#: gui/options/options.json
msgid "Only generic names"
msgstr "Csak általános nevek"

#: gui/options/options.json
msgid "Display only generic names for entities."
msgstr "Csak az egységek általános neveinek megjelenítése."

#: gui/options/options.json
msgid "Sort resources and population tooltip"
msgstr "Nyersanyag és lakosságszám eszköztipp rendezése"

#: gui/options/options.json
msgid ""
"Dynamically sort players in the resources and population tooltip by value."
msgstr "A játékosok dinamikus rendezése a nyersanyagok és lakosságszám értéke szerint."

#: gui/options/options.json
msgid "Unordered"
msgstr "Rendezetlen"

#: gui/options/options.json
msgid "Ascending"
msgstr "Növekvő"

#: gui/options/options.json
msgid "Descending"
msgstr "Csökkenő"

#: gui/options/options.json
msgid "FPS overlay"
msgstr "FPS réteg"

#: gui/options/options.json
msgid "Show frames per second in top right corner."
msgstr "Képkocka per másodperc (FPS) megjelenítése a jobb felső sarokban."

#: gui/options/options.json
msgid "Real time overlay"
msgstr "Valós idejű réteg"

#: gui/options/options.json
msgid "Show current system time in top right corner."
msgstr "Tényleges rendszeridő megjelenítése a jobb felső sarokban."

#: gui/options/options.json
msgid "Game time overlay"
msgstr "Játékidő réteg"

#: gui/options/options.json
msgid "Show current simulation time in top right corner."
msgstr "Jelelegi szimulációs idő megjelenítése a jobb felső sarokban."

#: gui/options/options.json
msgid "Ceasefire time overlay"
msgstr "Tűzszüneti idő réteg"

#: gui/options/options.json
msgid "Always show the remaining ceasefire time."
msgstr "Mindig mutassa a tűzszünet hátralévő idejét."

#: gui/options/options.json
msgid "Flare display duration"
msgstr "Jelzőfény megjelenítésének időtartama"

#: gui/options/options.json
msgid "How long the flare markers on the minimap are displayed in seconds."
msgstr "Ennyi másodpercig lesz a jelzőfény megjelenítve a kistérképen."

#: gui/options/options.json
msgid "Minimap icons"
msgstr "Minitérkép ikonok"

#: gui/options/options.json
msgid "Show special icons for some entities on the minimap."
msgstr "Egyes egységek speciális ikonjainak megjelenítése a minitérképen."

#: gui/options/options.json
msgid "Rank icon above status bar"
msgstr "Rang ikon az állapotsáv felett"

#: gui/options/options.json
msgid "Show rank icons above status bars."
msgstr "Rang ikonok megjelenítése az állapotsávok felett."

#: gui/options/options.json
msgid "Experience status bar"
msgstr "Tapasztalatsáv"

#: gui/options/options.json
msgid "Show an experience status bar above each selected unit."
msgstr "Tapasztalatsáv megjelenítése minden kiválasztott egység felett."

#: gui/options/options.json
msgid "Attack range visualization"
msgstr "Támadási hatótávolság megjelenítése"

#: gui/options/options.json
msgid ""
"Display the attack range of selected defensive structures. (It can also be "
"toggled with the hotkey during a game)."
msgstr "A kiválasztott védelmi épületek támadási hatótávolságának megjelenítése (játék közben is kapcsolható gyorsbillentyűvel)."

#: gui/options/options.json
msgid "Aura range visualization"
msgstr "Aura hatótávolságának megjelenítése"

#: gui/options/options.json
msgid ""
"Display the range of auras of selected units and structures. (It can also be"
" toggled with the hotkey during a game)."
msgstr "A kiválasztott egységek és épületek aurájának hatótávolságának megjelenítése (játék közben is kapcsolható gyorsbillentyűvel)."

#: gui/options/options.json
msgid "Heal range visualization"
msgstr "Gyógyítási hatótávolság megjelenítése"

#: gui/options/options.json
msgid ""
"Display the healing range of selected units. (It can also be toggled with "
"the hotkey during a game)."
msgstr "A kiválasztott egységek gyógyítási hatótávolságának megjelenítése (játék közben is kapcsolható gyorsbillentyűvel)."

#: gui/options/options.json
msgid "Diplomacy colors: self"
msgstr "Diplomáciai színek: saját"

#: gui/options/options.json
msgid "Color of your units when diplomacy colors are enabled."
msgstr "A saját egységek színe, ha a diplomáciai színek engedélyezettek."

#: gui/options/options.json
msgid "Diplomacy colors: ally"
msgstr "Diplomáciai színek: szövetséges"

#: gui/options/options.json
msgid "Color of allies when diplomacy colors are enabled."
msgstr "A szövetségesek színe, amikor a diplomáciai színek be vannak kapcsolva."

#: gui/options/options.json
msgid "Diplomacy colors: neutral"
msgstr "Diplomáciai színek: semleges"

#: gui/options/options.json
msgid "Color of neutral players when diplomacy colors are enabled."
msgstr "A semleges játékosok színe, amikor a diplomáciai színek be vannak kapcsolva."

#: gui/options/options.json
msgid "Diplomacy colors: enemy"
msgstr "Diplomáciai színek: ellenség"

#: gui/options/options.json
msgid "Color of enemies when diplomacy colors are enabled."
msgstr "Az ellenségek színe, amikor a diplomáciai színek be vannak kapcsolva."

#: gui/options/options.json
msgid "Gameplay"
msgstr "Játékmenet"

#: gui/options/options.json
msgid "Change options affecting the gameplay."
msgstr "A játékmenetet befolyásoló beállítások módosítása."

#: gui/options/options.json
msgid "Wounded unit health"
msgstr "Sebesült egység életereje"

#: gui/options/options.json
msgid ""
"The wounded unit hotkey considers the selected units as wounded if their "
"health percentage falls below this number."
msgstr "A sebesült egység gyorsbillentyű akkor tekinti sérültnek a kiválasztott egységet, ha az életereje százalékosan ez alá esik."

#: gui/options/options.json
msgid "Batch training size"
msgstr "Csoportos kiképzés nagysága"

#: gui/options/options.json
msgid "Number of units trained per batch by default."
msgstr "Csoportonként kiképzett egységek alapértelmezett száma."

#: gui/options/options.json
msgid "Scroll batch increment ratio"
msgstr "Csoportméret növelési sebessége görgetéskor"

#: gui/options/options.json
msgid ""
"Number of times you have to scroll to increase/decrease the batchsize by 1."
msgstr "Ennyiszer kell görgetned a csoportméret 1-el való csökkentéséhez / növeléséhez."

#: gui/options/options.json
msgid "Snap to edges"
msgstr "Igazítás a szélekhez"

#: gui/options/options.json
msgid "This option allows to align new structures with nearby structures."
msgstr "Ez a beállítás engedélyezi az új épületeknek a közeli építményekhez való igazítását."

#: gui/options/options.json
msgid "Hotkey to enable snapping"
msgstr "Gyorsbillentyű az illesztés bekapcsolásához"

#: gui/options/options.json
msgid ""
"New structures are aligned with nearby structures while pressing the hotkey."
msgstr "Az új épületek a meglévőkhöz lesznek igazítva a gyorsbillentyű lenyomásakor."

#: gui/options/options.json
msgid "Hotkey to disable snapping"
msgstr "Gyorsbillentyű az illesztés kikapcsolásához"

#: gui/options/options.json
msgid ""
"New structures are aligned with nearby structures unless the hotkey is "
"pressed."
msgstr "Az új épületek a meglévőkhöz lesznek igazítva, ha a gyorsbillentyű nincs lenyomva."

#: gui/options/options.json
msgid "Control group membership"
msgstr "Irányítási csoporttagság"

#: gui/options/options.json
msgid "Decide whether units can be part of multiple control groups."
msgstr "Döntsd el, hogy az egységek több irányítási csoportnak lehetnek-e a tagjai."

#: gui/options/options.json
msgid "Single"
msgstr "Egy"

#: gui/options/options.json
msgid ""
"When adding a Unit or Structure to a control group, they are removed from "
"other control groups. Use this choice if you want control groups to refer to"
" distinct armies."
msgstr "Ha egy irányítási csoporthoz adsz egy egységet vagy épületet, akkor eltávolításra kerül a többi csoporttól. Akkor válaszd ezt, ha azt szeretnéd, hogy a csoportok különálló hadseregeket jelöljenek."

#: gui/options/options.json
msgid "Multiple"
msgstr "Több"

#: gui/options/options.json
msgid ""
"Units and Structures can be part of multiple control groups. This is useful "
"to keep control groups for distinct armies and a control group for the "
"entire army simultaneously."
msgstr "Az egységek és épületek több irányítási csoport tagjai is lehetnek. Ez hasznos, ha külön csoportokban akarod tartani a hadsereg egyes részeit, és egy csoportban a hadsereg egészét."

#: gui/options/options.json
msgid "Formation control"
msgstr "Formációirányítás"

#: gui/options/options.json
msgid ""
"Decide whether formations are enabled for all orders or only 'Walk' and "
"'Patrol'."
msgstr "Eldönti, hogy a formációk minden egység számára engedélyezve legyenek, vagy csak a sétáló és őrjáratozó egységek számára."

#: gui/options/options.json
msgid "Walk/Patrol Only"
msgstr "Csak séta/őrjárat"

