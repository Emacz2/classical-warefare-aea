#: simulation/data/technologies/agoge.json
msgid "The Agoge"
msgstr "Agoge"

#: simulation/data/technologies/agoge.json
msgid "Agōga"
msgstr "Agōga"

#: simulation/data/technologies/agoge.json
msgid ""
"Spartans were housed and trained from a young age to be superlative warriors"
" and to endure any hardship a military life can give them."
msgstr "Người Sparta được nuôi dưỡng và huấn luyện từ nhỏ để trở thành những chiến binh siêu việt và chịu đựng mọi gian khổ trong cuộc sống quân đội."

#: simulation/data/technologies/agoge.json
msgid "Champion Hoplites +25% health, but +5% training time."
msgstr "Chiến binh Hoplite ưu tú +25% máu, nhưng +5% thời gian huấn luyện."

