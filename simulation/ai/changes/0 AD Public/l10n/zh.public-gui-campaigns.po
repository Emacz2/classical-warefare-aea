#: campaigns/new_maps.json
msgctxt "Campaign Template"
msgid "Demo campaign - new maps"
msgstr "演示战役 - 新地图"

#: campaigns/new_maps.json
msgctxt "Campaign Template"
msgid ""
"Discover the new and improved maps in Release XXVIII with a demo campaign, "
"taking you through all of them."
msgstr "通过演示战役体验“Release28版本”带来的全新优化的地图和新功能。"

