#: gui/common/network.js:105
#, javascript-format
msgid ""
"Different mods enabled, or mods enabled in a different order. Client mod: "
"'%(clientMismatch)s' Server mod: '%(serverMismatch)s'"
msgstr "Включены разные моды или моды включены в другом порядке. Клиентский мод: '%(clientMismatch)s' Серверный мод: '%(serverMismatch)s'"

#: gui/common/network.js:109
#, javascript-format
msgid "Unrecognized handshake mismatch type: %(mismatchType)s"
msgstr "Нераспознанный тип несоответствия рукопожатия (handshake): %(mismatchType)s"

#: gui/common/network.js:131
