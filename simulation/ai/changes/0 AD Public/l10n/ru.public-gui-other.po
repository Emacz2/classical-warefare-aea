msgstr "1x"

#: gui/options/options.json
msgid "Make changes to the sound options."
msgstr "Сделать изменения в параметры звука."

#: gui/options/options.json
msgid "Master volume"
msgstr "Общая громкость"

#: gui/options/options.json
