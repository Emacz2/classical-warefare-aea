#: simulation/data/settings/victory_conditions/capture_the_relic.json
msgid "Capture the Relic"
msgstr "Chiếm đoạt thánh tích"

#: simulation/data/settings/victory_conditions/capture_the_relic.json
msgid ""
"Capture all relics spread across the map and keep them for a certain time to"
" win the game."
msgstr "Chiếm tất cả các thánh tích rải rác trên bản đồ và giữ chúng trong một thời gian nhất định để thắng trò chơi."

#: simulation/data/settings/victory_conditions/conquest.json
msgid "Conquest"
msgstr "Chinh phục"

#: simulation/data/settings/victory_conditions/conquest.json
msgid ""
"Defeat opponents by killing all their units and destroying all their "
"structures."
msgstr "Đánh bại đối thủ bằng cách tiêu diệt tất cả các đơn vị và phá hủy tất cả các công trình của họ."

#: simulation/data/settings/victory_conditions/conquest_civic_centers.json
msgid "Conquest Civic Centers"
msgstr "Chinh phục Trung tâm Dân sự"

#: simulation/data/settings/victory_conditions/conquest_civic_centers.json
msgid "Defeat opponents by destroying all their fully built civic centers."
msgstr "Đánh bại đối thủ bằng cách phá hủy tất cả các trung tâm dân sự đã xây dựng hoàn chỉnh của họ."

#: simulation/data/settings/victory_conditions/conquest_structures.json
msgid "Conquest Structures"
msgstr "Chinh phục Công trình"

#: simulation/data/settings/victory_conditions/conquest_structures.json
msgid "Defeat opponents by destroying all their structures."
msgstr "Đánh bại đối thủ bằng cách phá hủy tất cả các công trình của họ."

#: simulation/data/settings/victory_conditions/conquest_units.json
msgid "Conquest Units"
msgstr "Chinh phục Đơn vị"

#: simulation/data/settings/victory_conditions/conquest_units.json
msgid "Defeat opponents by killing all their units."
msgstr "Đánh bại đối thủ bằng cách tiêu diệt tất cả các đơn vị của họ."

#: simulation/data/settings/victory_conditions/regicide.json
msgid "Regicide"
msgstr "Diệt Vua"

#: simulation/data/settings/victory_conditions/regicide.json
msgid "Defeat opponents by killing their hero."
msgstr "Đánh bại đối thủ bằng cách tiêu diệt anh hùng của họ."

#: simulation/data/settings/victory_conditions/wonder.json
msgid "Wonder"
msgstr "Kỳ quan"

#: simulation/data/settings/victory_conditions/wonder.json
msgid ""
"Be the first to build or capture a Wonder and keep it for a certain time to "
"win the game. The timer will be reset when the Wonder is destroyed or "
"captured. If the allied victory mode is enabled, the timer will also be "
"reset when the alliances of the owner change."
msgstr "Hãy là người đầu tiên xây dựng hoặc chiếm một Kỳ quan và giữ nó trong một thời gian nhất định để thắng trò chơi. Đồng hồ sẽ được đặt lại khi Kỳ quan bị phá hủy hoặc bị chiếm. Nếu chế độ thắng liên minh được bật, đồng hồ cũng sẽ được đặt lại khi liên minh của chủ sở hữu thay đổi."

