#: simulation/ai/petra/chatHelper.js:5
#, javascript-format
msgid ""
"I am starting a massive military campaign against %(_player_)s, come and "
"join me."
msgstr "Tôi đang bắt đầu một chiến dịch quân sự lớn chống lại %(_player_)s, hãy đến và tham gia cùng tôi."

#: simulation/ai/petra/chatHelper.js:6
#, javascript-format
msgid ""
"I have set up a huge army to crush %(_player_)s. Join me and you will have "
"your share of the loot."
msgstr "Tôi đã thành lập một đội quân lớn để nghiền nát %(_player_)s. Hãy tham gia cùng tôi và bạn sẽ có phần của mình trong số chiến lợi phẩm."

#: simulation/ai/petra/chatHelper.js:7
#, javascript-format
msgid ""
"I am launching an unprecedented attack against %(_player_)s. Bring your "
"armies and we may soon win this war."
msgstr "Tôi đang phát động một cuộc tấn công chưa từng có chống lại %(_player_)s. Hãy mang quân đội của bạn đến và chúng ta có thể sớm giành chiến thắng trong cuộc chiến này."

#: simulation/ai/petra/chatHelper.js:10
#, javascript-format
msgid "I am launching an attack against %(_player_)s."
msgstr "Tôi đang phát động một cuộc tấn công chống lại %(_player_)s."

#: simulation/ai/petra/chatHelper.js:11
#, javascript-format
msgid "I have just sent an army against %(_player_)s."
msgstr "Tôi vừa cử một đội quân chống lại %(_player_)s."

#: simulation/ai/petra/chatHelper.js:12
#, javascript-format
msgid "I am sending an army against %(_player_)s."
msgstr "Tôi đang cử một đội quân chống lại %(_player_)s."

#: simulation/ai/petra/chatHelper.js:18
#, javascript-format
msgid "Let me regroup my army and I will then join you against %(_player_)s."
msgstr "Hãy để tôi tập hợp lại quân đội của mình và sau đó tôi sẽ tham gia cùng bạn chống lại %(_player_)s."

#: simulation/ai/petra/chatHelper.js:19
#, javascript-format
msgid "I am finishing preparations to attack %(_player_)s."
msgstr "Tôi đang hoàn tất các công tác chuẩn bị để tấn công %(_player_)s."

#: simulation/ai/petra/chatHelper.js:22
#, javascript-format
msgid ""
"Sorry, I do not have enough soldiers currently; but my next attack will "
"target %(_player_)s."
msgstr "Xin lỗi, hiện tại tôi không có đủ binh lính; nhưng cuộc tấn công tiếp theo của tôi sẽ nhắm vào %(_player_)s."

#: simulation/ai/petra/chatHelper.js:23
#, javascript-format
msgid ""
"Sorry, I still need to strengthen my army. However, I will attack "
"%(_player_)s next."
msgstr "Xin lỗi, tôi vẫn cần tăng cường quân đội. Tuy nhiên, tôi sẽ tấn công %(_player_)s tiếp theo."

#: simulation/ai/petra/chatHelper.js:26
#, javascript-format
msgid ""
"I cannot help you against %(_player_)s for the time being, I am planning to "
"attack %(_player_2)s first."
msgstr "Hiện tại tôi không thể giúp bạn chống lại %(_player_)s, tôi đang lên kế hoạch tấn công %(_player_2)s trước."

#: simulation/ai/petra/chatHelper.js:31
#, javascript-format
msgid "Here is a gift for you, %(_player_)s. Make good use of it."
msgstr "Đây là một món quà dành cho bạn, %(_player_)s. Hãy sử dụng nó thật tốt."

#: simulation/ai/petra/chatHelper.js:32
#, javascript-format
msgid "I see you are in a bad situation, %(_player_)s. I hope this helps."
msgstr "Tôi thấy bạn đang ở trong tình thế khó khăn, %(_player_)s. Tôi hy vọng điều này sẽ giúp ích."

#: simulation/ai/petra/chatHelper.js:33
#, javascript-format
msgid ""
"I can help you this time, %(_player_)s, but you should manage your resources"
" more carefully in the future."
msgstr "Lần này tôi có thể giúp bạn, %(_player_)s, nhưng bạn nên quản lý tài nguyên của mình cẩn thận hơn trong tương lai."

#: simulation/ai/petra/chatHelper.js:37
#, javascript-format
msgid "I am in need of %(resource)s, can you help? I will make it up to you."
msgstr "Tôi đang cần %(resource)s, bạn có thể giúp không? Tôi sẽ đền đáp cho bạn."

#: simulation/ai/petra/chatHelper.js:38
#, javascript-format
msgid ""
"I would participate more efficiently in our common war effort if you could "
"provide me some %(resource)s."
msgstr "Tôi sẽ tham gia hiệu quả hơn vào nỗ lực chiến tranh chung của chúng ta nếu bạn có thể cung cấp cho tôi một ít %(resource)s."

#: simulation/ai/petra/chatHelper.js:39
#, javascript-format
msgid ""
"If you can spare me some %(resource)s, I will be able to strengthen my army."
msgstr "Nếu bạn có thể dành cho tôi một ít %(resource)s, tôi sẽ có thể tăng cường quân đội của mình."

#: simulation/ai/petra/chatHelper.js:43
#, javascript-format
msgid ""
"I have set up a new route with %(_player_)s. Trading will be profitable for "
"all of us."
msgstr "Tôi đã thiết lập một tuyến đường mới với %(_player_)s. Giao thương sẽ có lợi cho tất cả chúng ta."

#: simulation/ai/petra/chatHelper.js:44
#, javascript-format
msgid ""
"A new trade route is set up with %(_player_)s. Take your share of the "
"profits."
msgstr "Một tuyến đường thương mại mới được thiết lập với %(_player_)s. Hãy nhận phần lợi nhuận của bạn."

#: simulation/ai/petra/chatHelper.js:49
#, javascript-format
msgid "%(_player_)s and I are now allies."
msgstr "%(_player_)s và tôi hiện là đồng minh."

#: simulation/ai/petra/chatHelper.js:52
#, javascript-format
msgid "%(_player_)s and I are now neutral."
msgstr "%(_player_)s và tôi hiện trung lập."

#: simulation/ai/petra/chatHelper.js:55
#, javascript-format
msgid "%(_player_)s and I are now enemies."
msgstr "%(_player_)s và tôi hiện là kẻ thù."

#: simulation/ai/petra/chatHelper.js:62
#, javascript-format
msgid "I cannot accept your offer to become allies, %(_player_)s."
msgstr "Tôi không thể chấp nhận lời đề nghị làm đồng minh của bạn, %(_player_)s."

#: simulation/ai/petra/chatHelper.js:63
#, javascript-format
msgid "I must decline your offer of alliance, %(_player_)s."
msgstr "Tôi phải từ chối lời đề nghị liên minh của bạn, %(_player_)s."

#: simulation/ai/petra/chatHelper.js:64
#, javascript-format
msgid "An alliance with you is not in my best interest, %(_player_)s."
msgstr "Một liên minh với bạn không phải là lợi ích tốt nhất của tôi, %(_player_)s."

#: simulation/ai/petra/chatHelper.js:67
#, javascript-format
msgid ""
"I will not be your ally, %(_player_)s. However, I will consider a neutrality"
" pact."
msgstr "Tôi sẽ không làm đồng minh của bạn, %(_player_)s. Tuy nhiên, tôi sẽ xem xét một hiệp ước trung lập."

#: simulation/ai/petra/chatHelper.js:68
#, javascript-format
msgid ""
"I reject your request for alliance, %(_player_)s, but we could become "
"neutral."
msgstr "Tôi từ chối yêu cầu liên minh của bạn, %(_player_)s, nhưng chúng ta có thể trở thành trung lập."

#: simulation/ai/petra/chatHelper.js:69
#, javascript-format
msgid "%(_player_)s, only a neutrality agreement is conceivable to me."
msgstr "%(_player_)s, đối với tôi chỉ có thể là một thỏa thuận trung lập."

#: simulation/ai/petra/chatHelper.js:72
#, javascript-format
msgid ""
"Our previous alliance did not work out, %(_player_)s. I must decline your "
"offer."
msgstr "Liên minh trước đây của chúng ta đã không thành công, %(_player_)s. Tôi phải từ chối lời đề nghị của bạn."

#: simulation/ai/petra/chatHelper.js:73
#, javascript-format
msgid "I won’t ally you again, %(_player_)s!"
msgstr "Tôi sẽ không liên minh với bạn nữa, %(_player_)s!"

#: simulation/ai/petra/chatHelper.js:74
#, javascript-format
msgid "No more alliances between us, %(_player_)s!"
msgstr "Không còn liên minh nào giữa chúng ta nữa, %(_player_)s!"

#: simulation/ai/petra/chatHelper.js:75
#, javascript-format
msgid "Your request for peace means nothing to me anymore, %(_player_)s!"
msgstr "Yêu cầu hòa bình của bạn không có ý nghĩa gì đối với tôi nữa, %(_player_)s!"

#: simulation/ai/petra/chatHelper.js:76
#, javascript-format
msgid ""
"My answer to your repeated peace proposal will remain war, %(_player_)s!"
msgstr "Câu trả lời của tôi cho đề xuất hòa bình lặp đi lặp lại của bạn sẽ vẫn là chiến tranh, %(_player_)s!"

#: simulation/ai/petra/chatHelper.js:79
#, javascript-format
msgid ""
"I will accept your offer to become allies, %(_player_)s. We will both "
"benefit from this partnership."
msgstr "Tôi sẽ chấp nhận lời đề nghị làm đồng minh của bạn, %(_player_)s. Cả hai chúng ta sẽ hưởng lợi từ mối quan hệ đối tác này."

#: simulation/ai/petra/chatHelper.js:80
#, javascript-format
msgid "An alliance between us is a good idea, %(_player_)s."
msgstr "Một liên minh giữa chúng ta là một ý tưởng hay, %(_player_)s."

#: simulation/ai/petra/chatHelper.js:81
#, javascript-format
msgid ""
"Let both of our people prosper from a peaceful association, %(_player_)s."
msgstr "Hãy để cả hai dân tộc của chúng ta thịnh vượng từ một mối quan hệ hòa bình, %(_player_)s."

#: simulation/ai/petra/chatHelper.js:82
#, javascript-format
msgid "We have found common ground, %(_player_)s. I accept the alliance."
msgstr "Chúng ta đã tìm thấy điểm chung, %(_player_)s. Tôi chấp nhận liên minh."

#: simulation/ai/petra/chatHelper.js:83
#, javascript-format
msgid "%(_player_)s, consider us allies from now on."
msgstr "%(_player_)s, hãy coi chúng ta là đồng minh từ bây giờ."

#: simulation/ai/petra/chatHelper.js:86
#, javascript-format
msgid ""
"I will ally with you, %(_player_)s, but only if you send me a tribute of "
"%(_amount_)s %(_resource_)s."
msgstr "Ta sẽ liên minh với ngươi, %(_player_)s, nhưng chỉ khi ngươi cống nạp cho ta %(_amount_)s %(_resource_)s."

#: simulation/ai/petra/chatHelper.js:87
#, javascript-format
msgid ""
"%(_player_)s, you must send me a tribute of %(_amount_)s %(_resource_)s "
"before I accept an alliance with you."
msgstr "%(_player_)s, ngươi phải cống nạp cho ta %(_amount_)s %(_resource_)s trước khi ta chấp nhận liên minh với ngươi."

#: simulation/ai/petra/chatHelper.js:88
#, javascript-format
msgid ""
"Unless you send me %(_amount_)s %(_resource_)s, an alliance won’t be formed,"
" %(_player_)s."
msgstr "Trừ khi ngươi gửi cho ta %(_amount_)s %(_resource_)s, một liên minh sẽ không được thành lập, %(_player_)s."

#: simulation/ai/petra/chatHelper.js:91
#, javascript-format
msgid ""
"%(_player_)s, my offer still stands. I will ally with you only if you send "
"me a tribute of %(_amount_)s %(_resource_)s."
msgstr "%(_player_)s, lời đề nghị của ta vẫn còn hiệu lực. Ta sẽ liên minh với ngươi chỉ khi ngươi cống nạp cho ta %(_amount_)s %(_resource_)s."

#: simulation/ai/petra/chatHelper.js:92
#, javascript-format
msgid ""
"I’m still waiting for %(_amount_)s %(_resource_)s before accepting your "
"alliance, %(_player_)s."
msgstr "Ta vẫn đang chờ %(_amount_)s %(_resource_)s trước khi chấp nhận liên minh của ngươi, %(_player_)s."

#: simulation/ai/petra/chatHelper.js:93 simulation/ai/petra/chatHelper.js:114
#, javascript-format
msgid ""
"%(_player_)s, if you do not send me part of the %(_amount_)s %(_resource_)s "
"tribute soon, I will break off our negotiations."
msgstr "%(_player_)s, nếu ngươi không sớm gửi cho ta một phần cống nạp %(_amount_)s %(_resource_)s, ta sẽ cắt đứt đàm phán của chúng ta."

#: simulation/ai/petra/chatHelper.js:98
#, javascript-format
msgid "I will not become neutral with you, %(_player_)s."
msgstr "Ta sẽ không giữ thái độ trung lập với ngươi, %(_player_)s."

#: simulation/ai/petra/chatHelper.js:99
#, javascript-format
msgid "%(_player_)s, I must decline your request for a neutrality pact."
msgstr "%(_player_)s, ta phải từ chối yêu cầu của ngươi về một hiệp ước trung lập."

#: simulation/ai/petra/chatHelper.js:102
#, javascript-format
msgid ""
"Our previous neutrality agreement ended in failure, %(_player_)s; I will not"
" consider another one."
msgstr "Thỏa thuận trung lập trước đây của chúng ta đã kết thúc trong thất bại, %(_player_)s; ta sẽ không xem xét một thỏa thuận khác."

#: simulation/ai/petra/chatHelper.js:105
#, javascript-format
msgid ""
"I welcome your request for peace between our civilizations, %(_player_)s. I "
"will accept."
msgstr "Ta hoan nghênh yêu cầu hòa bình giữa các nền văn minh của chúng ta, %(_player_)s. Ta sẽ chấp nhận."

#: simulation/ai/petra/chatHelper.js:106
#, javascript-format
msgid ""
"%(_player_)s, I will accept your neutrality request. May both our "
"civilizations benefit."
msgstr "%(_player_)s, ta sẽ chấp nhận yêu cầu trung lập của ngươi. Cầu mong cả hai nền văn minh của chúng ta đều có lợi."

#: simulation/ai/petra/chatHelper.js:109
#, javascript-format
msgid ""
"If you send me a tribute of %(_amount_)s %(_resource_)s, I will accept your "
"neutrality request, %(_player_)s."
msgstr "Nếu ngươi gửi cho ta cống nạp %(_amount_)s %(_resource_)s, ta sẽ chấp nhận yêu cầu trung lập của ngươi, %(_player_)s."

#: simulation/ai/petra/chatHelper.js:110
#, javascript-format
msgid ""
"%(_player_)s, if you send me %(_amount_)s %(_resource_)s, I will accept a "
"neutrality pact."
msgstr "%(_player_)s, nếu ngươi gửi cho ta %(_amount_)s %(_resource_)s, ta sẽ chấp nhận một hiệp ước trung lập."

#: simulation/ai/petra/chatHelper.js:113
#, javascript-format
msgid ""
"%(_player_)s, I will not accept your neutrality request unless you tribute "
"me %(_amount_)s %(_resource_)s soon."
msgstr "%(_player_)s, ta sẽ không chấp nhận yêu cầu trung lập của ngươi trừ khi ngươi sớm cống nạp cho ta %(_amount_)s %(_resource_)s."

#: simulation/ai/petra/chatHelper.js:122
#, javascript-format
msgid ""
"%(_player_)s, it would help both of our civilizations if we formed an "
"alliance. If you become allies with me, I will respond in kind."
msgstr "%(_player_)s, sẽ có lợi cho cả hai nền văn minh của chúng ta nếu chúng ta thành lập một liên minh. Nếu ngươi trở thành đồng minh của ta, ta sẽ đáp lại tương tự."

#: simulation/ai/petra/chatHelper.js:125
#, javascript-format
msgid "%(_player_)s, my offer for an alliance has expired."
msgstr "%(_player_)s, lời đề nghị liên minh của ta đã hết hạn."

#: simulation/ai/petra/chatHelper.js:126
#, javascript-format
msgid ""
"%(_player_)s, I have rescinded my previous offer for an alliance between us."
msgstr "%(_player_)s, ta đã rút lại lời đề nghị liên minh trước đây giữa chúng ta."

#: simulation/ai/petra/chatHelper.js:131
#, javascript-format
msgid ""
"%(_player_)s, I would like to request a neutrality pact between our "
"civilizations. If you become neutral with me, I will respond in kind."
msgstr "%(_player_)s, ta muốn đề nghị một hiệp ước trung lập giữa các nền văn minh của chúng ta. Nếu ngươi giữ thái độ trung lập với ta, ta sẽ đáp lại tương tự."

#: simulation/ai/petra/chatHelper.js:132
#, javascript-format
msgid ""
"%(_player_)s, it would be both to our benefit if we negotiated a neutrality "
"pact. I will become neutral with you if you do the same."
msgstr "%(_player_)s, sẽ có lợi cho cả hai chúng ta nếu chúng ta đàm phán một hiệp ước trung lập. Ta sẽ giữ thái độ trung lập với ngươi nếu ngươi cũng làm như vậy."

#: simulation/ai/petra/chatHelper.js:135
#, javascript-format
msgid "%(_player_)s, I have decided to revoke my offer for a neutrality pact."
msgstr "%(_player_)s, ta đã quyết định rút lại lời đề nghị về một hiệp ước trung lập."

#: simulation/ai/petra/chatHelper.js:136
#, javascript-format
msgid ""
"%(_player_)s, as you have failed to respond to my request for peace between "
"us, I have abrogated my offer."
msgstr "%(_player_)s, vì ngươi đã không đáp lại yêu cầu hòa bình giữa chúng ta, ta đã hủy bỏ lời đề nghị của mình."

#: simulation/ai/petra/chatHelper.js:143
msgid ""
"My armies failed while defending my empire. Please honor our alliance and "
"send help!"
msgstr "Quân đội của ta đã thất bại khi bảo vệ đế chế của mình. Xin hãy tôn trọng liên minh của chúng ta và gửi viện trợ!"

#: simulation/ai/petra/chatHelper.js:144
msgid ""
"My humble armies feel weak and tired. My civilization depends on our "
"alliance, please send help!"
msgstr "Quân đội yếu ớt của ta cảm thấy mệt mỏi và kiệt sức. Nền văn minh của ta phụ thuộc vào liên minh của chúng ta, xin hãy gửi viện trợ!"

#: simulation/ai/petra/chatHelper.js:145
msgid "I need your help. Please do not let my armies fall!"
msgstr "Ta cần sự giúp đỡ của ngươi. Xin đừng để quân đội của ta sụp đổ!"

#: simulation/ai/petra/chatHelper.js:148
msgid ""
"My empire regained its old strength, now it is time to seek revenge "
"together!"
msgstr "Đế chế của ta đã lấy lại sức mạnh cũ, giờ là lúc cùng nhau báo thù!"

#: simulation/ai/petra/chatHelper.js:149
msgid ""
"My civilization raised from the ashes. Now my armies feel stronger and eager"
" to fight for our alliance."
msgstr "Nền văn minh của ta đã vươn lên từ tro tàn. Giờ đây quân đội của ta cảm thấy mạnh mẽ hơn và sẵn sàng chiến đấu vì liên minh của chúng ta."

#: simulation/ai/petra/data.json
msgid "Petra Bot"
msgstr "Bot Petra"

#: simulation/ai/petra/data.json
msgid ""
"Petra is the default 0 A.D. AI bot. Please report issues to Wildfire Games (see the link in the main menu).\n"
"\n"
"The AI's resource gathering rate and trade gain depend on the difficulty level (Sandbox −58%, Very Easy −44%, Easy −25%, Medium ±0%, Hard +25%, Very Hard +56%). The easiest levels also have a slower research, training, and building rate. In addition, the Sandbox level does not expand nor attack."
msgstr "Petra là bot AI mặc định của 0 A.D. Vui lòng báo cáo các sự cố cho Wildfire Games (xem liên kết trong menu chính).\n\nTốc độ thu thập tài nguyên và lợi nhuận giao thương của AI phụ thuộc vào mức độ khó (Thử nghiệm −58%, Rất dễ −44%, Dễ −25%, Trung bình ±0%, Khó +25%, Rất khó +56%). Các mức độ dễ nhất cũng có tốc độ nghiên cứu, huấn luyện và xây dựng chậm hơn. Ngoài ra, mức độ Thử nghiệm sẽ không mở rộng lãnh thổ hay tấn công."

#: simulation/components/BuildRestrictions.js:101
#, javascript-format
msgid "%(name)s cannot be built due to unknown error"
msgstr "%(name)s không thể xây dựng do lỗi không xác định"

#: simulation/components/BuildRestrictions.js:125
#, javascript-format
msgid "%(name)s cannot be built in unexplored area"
msgstr "%(name)s không thể xây dựng ở khu vực chưa khám phá"

#: simulation/components/BuildRestrictions.js:170
#, javascript-format
msgid "%(name)s cannot be built on another building or resource"
