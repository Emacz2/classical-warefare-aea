<?xml version="1.0" encoding="utf-8" standalone="no"?>
<Entity>
  <!-- Mercenary employment package for bespoke troops such as Cretan Archers
       and Balearic Slingers. It intentionally has NO generic mercenary damage
       or accuracy bonuses; those troops get their combat identity from their
       own troop mixin. -->
  <Cost>
    <Resources>
      <metal>60</metal>
      <food>25</food>
      <wood>0</wood>
      <stone>0</stone>
    </Resources>
  </Cost>
  <Attack>
    <Capture>
      <AttackName>Capture</AttackName>
      <Capture>1.0</Capture>
      <MaxRange>3</MaxRange>
      <RepeatTime>1000</RepeatTime>
    </Capture>
  </Attack>
  <Promotion disable=""/>
  <Identity>
    <VisibleClasses datatype="tokens">Mercenary -Citizen</VisibleClasses>
  </Identity>
  <ResourceGatherer disable=""/>
  <Builder disable=""/>
</Entity>
